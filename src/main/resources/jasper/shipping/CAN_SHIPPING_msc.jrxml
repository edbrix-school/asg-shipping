				<textElement>
					<font size="9"/>
				</textElement>
				<text><![CDATA[FREIGHT AND CHARGES                                                                                                                         AMOUNT(BHD) ]]></text>
			</staticText>
			<line>
				<reportElement x="340" y="373" width="1" height="108" uuid="a789f74e-e412-483e-ab44-ac577217b077"/>
				<graphicElement>
					<pen lineWidth="0.4"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="458" y="374" width="1" height="107" uuid="f608707c-4978-42f0-979a-dd31f362a883"/>
				<graphicElement>
					<pen lineWidth="0.4"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="3" y="579" width="507" height="30" uuid="11545218-f663-4c54-87c2-1c01956848f5"/>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[• Kindly arrange to collect your delivery order from our D/o office ( TEL # 17727410 ) by presenting the original Bill of lading, copy of this Cargo Arrival Notice and payment of all charges due including line demurrage (if any).]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="608" width="508" height="30" uuid="3d595086-b6c0-4167-9605-a2403f6c1f8c"/>
				<textElement textAlignment="Justified"/>
				<text><![CDATA[• If you wish to clear cargo against bank guarantee, please inform us 3 working days in advance, to enable us to obtain approval from Principals and port of loading.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="637" width="508" height="39" uuid="3822eb60-bed1-4575-b791-f8c5b978da77"/>
				<textElement textAlignment="Justified">
					<font isBold="true" isItalic="false"/>
				</textElement>
				<text><![CDATA[• Return empty container(s) must be free from any and all extraneous foreign matter, be clean, cargo worthy condition. IMCO LABELS if any must be removed - failing which all charges for removal of the IMCO LABEL and/or fine will be debited to the consignee.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="675" width="508" height="29" uuid="336f03db-2b32-44c1-b61b-8ad3933e1a3b"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif" isBold="false"/>
				</textElement>
				<text><![CDATA[• In the event of Damage/Short Landing, Notify your Insurers with copy to us prior to taking delivery of goods from the port. Failing to do so, we, on behalf of our principals shall repudiate liability of any alleged claim.  ]]></text>
			</staticText>
			<staticText>
				<reportElement x="3" y="704" width="507" height="25" uuid="4b9c3193-9858-4eff-8d67-264b1ca4a5af"/>
				<textElement textAlignment="Justified">
					<font size="9" isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[• The arrival notice is sent as courtesy. The Carrier/Agent cannot be held liable for any costs incurred as a result of any delay in clearance if the arrival notice is not received by you.]]></text>
			</staticText>
			<staticText>
				<reportElement x="3" y="789" width="218" height="16" uuid="f4dfd2ab-19a3-4444-ac66-88eef0a6ecb3"/>
				<textElement>
					<font isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[        4. No personal cheques will be accepted.]]></text>
			</staticText>
			<staticText>
				<reportElement x="3" y="728" width="360" height="16" uuid="7e1fbd0f-3196-4f4d-a0be-9aa28f8635bf"/>
				<textElement>
					<font isBold="true" isUnderline="false"/>
				</textElement>
				<text><![CDATA[Terms :]]></text>
			</staticText>
			<staticText>
				<reportElement x="3" y="759" width="508" height="16" uuid="dd8abfc5-6610-4639-8094-5c3ad14f3154"/>
				<textElement>
					<font isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[        2. Delay in DO collection after 21 days - BHD 30.000 / Delivery Order.]]></text>
			</staticText>
			<staticText>
				<reportElement x="2" y="774" width="508" height="16" uuid="4fec13eb-e012-438b-9bdb-02b3aea625a6"/>
				<textElement>
					<font isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[        3. Container form re-validation - BHD 4.000 / container (each re-validation).]]></text>
			</staticText>
