	<subDataset name="Charge_detail" uuid="f4afee65-d43c-44cb-8911-782411d1267f">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
		<parameter name="P_BL_POID" class="java.math.BigDecimal"/>
		<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
			<defaultValueExpression><![CDATA[N]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select QUANTITY ,CURRENCY_EXCHANGE,CURRENCY_CODE,PRINT_GROUP,PRINT_GROUP_ORDER, sum(PER_QTY_SELL_AMT) PER_QTY_SELL_AMT,sum(Amount) amount,
SUM(TAX_AMOUNT) TAX_AMOUNT,(SUM(AMOUNT)+SUM(NVL(TAX_AMOUNT,0))) TOTAL_AMOUNT,TAX_PERCENTAGE  from

(
SELECT
(select NVL(min(PRINT_GROUP),GET_CHARGE_NAME(ARCDTL.CHARGE_POID))
from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID= $P{P_BL_POID}
) PRINT_GROUP,
(select min(DECODE(SUBSTR(PRINT_GROUP,1,5),'Freig',1,'Local',99999,'Termi',99998,2) )from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID
and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID= $P{P_BL_POID}
) PRINT_GROUP_ORDER,

Amount,QUANTITY ,CURRENCY_EXCHANGE,CURRENCY_CODE,PER_QTY_SELL_AMT,
TAX_AMOUNT,decode(TAX_CATEGORY,'V',TO_CHAR(ARCDTL.TAX_PERCENTAGE),'Z','0',TAX_CATEGORY) TAX_PERCENTAGE
FROM
AR_SH_SALES_INVOICE_CHARG_DTL ARCDTL
inner JOIN SHIP_CHARGE_MASTER CMAST ON CMAST.CHARGE_POID = ARCDTL.CHARGE_POID
left join GLOBAL_TAX_MASTER gtxm on GTXM.TAX_POID=ARCDTL.TAX_POID
WHERE ARCDTL.TRANSACTION_POID =  $P{P_TRANSACTION_POID}
AND BL_POID IN(SELECT TRANSACTION_POID FROM SHIP_BL_MANIFEST_HDR WHERE BL_TYPE = 'EXPORT' and TRANSACTION_POID= $P{P_BL_POID})

)
group by  QUANTITY ,CURRENCY_EXCHANGE,CURRENCY_CODE,PRINT_GROUP_ORDER,PRINT_GROUP,TAX_PERCENTAGE   HAVING sum(Amount)<>0
order by  PRINT_GROUP_ORDER]]>
		</queryString>
		<field name="QUANTITY" class="java.math.BigDecimal"/>
		<field name="CURRENCY_EXCHANGE" class="java.math.BigDecimal"/>
		<field name="CURRENCY_CODE" class="java.lang.String"/>
		<field name="PRINT_GROUP" class="java.lang.String"/>
		<field name="PRINT_GROUP_ORDER" class="java.math.BigDecimal"/>
		<field name="PER_QTY_SELL_AMT" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
		<field name="TAX_PERCENTAGE" class="java.lang.String"/>
		<variable name="Sum_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
		</variable>
		<variable name="Total_text" class="java.lang.String">
			<variableExpression><![CDATA["Total amount(BD)   :"]]></variableExpression>
		</variable>
		<variable name="Total_received" class="java.lang.String">
			<variableExpression><![CDATA["Amount Received(BD):"]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="container_type" uuid="21ab848d-ba71-4861-950d-e3d3ff8f37dd">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CNT},'CNTTYPE',NULL)) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="AmountInWord" uuid="94d09520-f163-4835-adc6-7bcd4e91d602">
		<parameter name="Amount" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct 'Bahraini Dinar '||FN_AMOUNT_IN_WORDS_COMMON($P{Amount},'BHD') AMOUNT_IN_WORD from dual]]>
		</queryString>
		<field name="AMOUNT_IN_WORD" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_BL_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT HDR.TRANSACTION_POID,BHDR.BL_number,HDR.DOC_REF  DOC_REF,to_char(HDR.TRANSACTION_DATE,invoice_date_format) TRANSACTION_DATE,HDR.BL_POID,LMAST.LINE_code||'/'||VESSEL_name||'/'||VOYAGE_NO LINE_VESSEL_INFO,
1 bl_count,TO_CHAR(decode(BL_TYPE,'IMPORT',VHDR.ARRIVAL_DATE,VHDR.SAIL_DATE,invoice_date_format),invoice_date_format) ARRIVAL_SAIL_DATE, PMAST.PORT_NAME, NVL(ADHDR.CUSTOMER_NAME,PRINCIPAL_NAME) CUSTOMER_PRINT_NAME, upper(COMPANY_NAME) COMPANY_NAME,
(SELECT SUM(AMOUNT)  FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_CHARGE_AMOUNT,

(SELECT SUM(TAX_AMOUNT) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_TAX_AMOUNT,

(SELECT SUM(NVL(AMOUNT,0))+SUM(NVL(TAX_AMOUNT,0)) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_AMOUNT,

nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1)) COMPANY_POID,
nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) COMPANY_DIVISION_POID,
' BD:'|| FN_AMOUNT_IN_WORDS_common(INV_AMOUNT,'BHD') AMOUNT_IN_WORDS
, GET_PORT_NAME(BHDR.PORT_OF_LOADING_POID) LOAD_PORT, GET_PORT_NAME(BHDR.PORT_OF_DISCHARGE_POID) DISCHARGE_PORT,GET_PORT_NAME(BHDR.PLACE_OF_DELIEVERY_POID) DELIVERY_PORT,
BL_TYPE,nvl(OFF_TEL1,MOBILE) OFFICE_TEL,PO_BOX,upper(AREA_CITY) area,upper(STATE) STATE,decode(trim(upper(AREA_CITY)),'MANAMA','KINGDOM OF BAHRAIN',GET_COUNTRY_NAME(ADRHDRMST.COUNTRY_POID)) country,MOBILE,EMAIL1 EMAIL,BLDG BUILDING,division_name,HDR.LPO_SRN_NO LPO_NO,TO_CHAR(HDR.LPO_SRN_DATE,invoice_date_format) LPO_DATE,TO_CHAR(INV_DATE,invoice_date_format)  INV_DATE,
to_char(nvl(DUE_DATE,INV_DATE + nvl(CREDIT_DAYS,0)),invoice_date_format) DUE_DATE,
PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID,
DECODE(BANK_DETAILS_CMP_MASTER,'NNO','A/C Payee Cheque In Favor of '||CHR(13)||CHR(10) ||'   '||COMPANY_NAME,'Beneficiary Name :-'||COMPANY_NAME||CHR(13)||CHR(10)|| 'Bank Name :-'||GBM.BANK_ADDRESS||CHR(13)||CHR(10) ||'Account Number :-'||GBM.BANK_ACCOUNT_NO||CHR(13)||CHR(10)||'Swift Code :-'||GBM.SWIFT_CODE||CHR(13)||CHR(10)||'IBAN Number :-'||GBM.IBAN
) PAYMENT_DETAILS ,DECODE(SUBSTR(HDR.DOC_REF,4,5),'IHIMP',0,1) CREDIT_INVOICE,CC_REF,
decode(nvl(ADHDR.TIN_NUMBER,PDHDR.TIN_NUMBER),null,null,'VAT number: '||nvl(ADHDR.TIN_NUMBER,PDHDR.TIN_NUMBER)) TIN_NUMBER,
decode(COMMAST.TIN_NUMBER ,null,null,COMMAST.TIN_NUMBER ) Company_TIN_NUMBER,
decode(sign(to_date(INV_DATE)-to_date(VAT_REGISTRATION_DATE)),'-1',' ',decode(COMMAST.TIN_NUMBER ,null,' ','TAX' )) Company_TAX,
nvl(FN_FOR_CUSTOMER_ADDRESS('000-000',HDR.customer_poid,'CUSTOMER'),FN_FOR_CUSTOMER_ADDRESS('000-000',HDR.customer_poid,'PRINCIPAL'))  DETAILS_ADDRESS
FROM AR_SH_SALES_INVOICE_HDR HDR
inner JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
inner JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
inner JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
inner JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
RIGHT JOIN SALES_CUSTOMER_MASTER ADHDR ON HDR.CUSTOMER_POID=ADHDR.CUSTOMER_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER PDHDR ON HDR.CUSTOMER_POID=PDHDR.PRINCIPAL_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER ADRHDRMST ON (ADHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID)
left JOIN GLOBAL_ADDRESS_DETAILS ADRDTL ON (ADHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID) and TRIM(ADRDTL.ADDRESS_TYPE) ='MAIN'
LEFT JOIN SHIP_PORT_MASTER PMAST ON PMAST.PORT_POID =  decode(BL_TYPE,'IMPORT',BHDR.PORT_OF_LOADING_POID,nvl(PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID))
inner JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1))
inner join global_division_master divmast on divmast.DIVISION_POID = nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1))
INNER JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID=HDR.PRINT_INVOICE_BANK_POID
WHERE  HDR.TRANSACTION_POID =  $P{DOC_KEY_POID}]]>
	</queryString>
