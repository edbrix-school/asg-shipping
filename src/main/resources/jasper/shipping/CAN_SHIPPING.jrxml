			<rectangle>
				<reportElement x="0" y="357" width="511" height="272" uuid="2a3698b0-5fc1-4b72-a9d1-dbafe9087b7b"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<staticText>
				<reportElement mode="Opaque" x="3" y="358" width="338" height="15" backcolor="#CCCCCC" uuid="63bb67d6-dbe6-4133-aa01-13826aafa104"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<text>
					<![CDATA[FREIGHT AND CHARGES ]]>
				</text>
			</staticText>
			<line>
				<reportElement x="374" y="373" width="1" height="256" uuid="a789f74e-e412-483e-ab44-ac577217b077"/>
				<graphicElement>
					<pen lineWidth="0.4"/>
				</graphicElement>
			</line>
			<line>
				<reportElement x="458" y="374" width="1" height="255" uuid="f608707c-4978-42f0-979a-dd31f362a883"/>
				<graphicElement>
					<pen lineWidth="0.4"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="3" y="704" width="507" height="25" uuid="11545218-f663-4c54-87c2-1c01956848f5"/>
				<textElement textAlignment="Justified">
					<font size="9"/>
				</textElement>
				<text>
					<![CDATA[• Kindly arrange to collect your delivery order from our D/o office ( TEL # 17515065 ) by presenting the original Bill of lading, copy of this Cargo Arrival Notice and payment of all charges due including line demurrage (if any).]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="2" y="729" width="508" height="23" uuid="3d595086-b6c0-4167-9605-a2403f6c1f8c"/>
				<textElement textAlignment="Justified">
					<font size="9"/>
				</textElement>
				<text>
					<![CDATA[• If you wish to clear cargo against bank guarantee, please inform us 3 working days in advance, to enable us to obtain approval from Principals and port of loading.]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="2" y="753" width="508" height="35" uuid="3822eb60-bed1-4575-b791-f8c5b978da77"/>
				<textElement textAlignment="Justified">
					<font size="9" isBold="true"  isItalic="false"/>
				</textElement>
				<text>
					<![CDATA[• Return empty container(s) must be free from any and all extraneous foreign matter, be clean, cargo worthy condition. IMCO LABELS if any must be removed - failing which all charges for removal of the IMCO LABEL and/or fine will be debited to the consignee.]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="2" y="790" width="508" height="25" uuid="336f03db-2b32-44c1-b61b-8ad3933e1a3b"/>
				<textElement textAlignment="Justified">
					<font fontName="SansSerif" size="9" isBold="false"/>
				</textElement>
				<text>
					<![CDATA[• In the event of Damage/Short Landing, Notify your Insurers with copy to us prior to taking delivery of goods from the port. Failing to do so, we, on behalf of our principals shall repudiate liability of any alleged claim.  ]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="3" y="817" width="507" height="23" uuid="4b9c3193-9858-4eff-8d67-264b1ca4a5af"/>
				<textElement textAlignment="Justified">
					<font size="9" isBold="false" isUnderline="false"/>
				</textElement>
				<text>
					<![CDATA[• The arrival notice is sent as courtesy. The Carrier/Agent cannot be held liable for any costs incurred as a result of any delay in clearance if the arrival notice is not received by you.]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="3" y="841" width="360" height="16" uuid="7e1fbd0f-3196-4f4d-a0be-9aa28f8635bf"/>
				<textElement>
					<font isBold="true" isUnderline="false"/>
				</textElement>
				<text>
					<![CDATA[Payment Terms :]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="7" y="629" width="375" height="12" uuid="dd8abfc5-6610-4639-8094-5c3ad14f3154"/>
				<textElement>
					<font size="8" isBold="false" isUnderline="false"/>
				</textElement>
				<text>
					<![CDATA[        1. Late DO collection after 21 days - BHD 30.000 / Delivery Order (Excluding VAT).]]>
				</text>
			</staticText>
			<staticText>
				<reportElement x="7" y="642" width="355" height="12" uuid="4fec13eb-e012-438b-9bdb-02b3aea625a6"/>
				<textElement>
					<font size="8" isBold="false" isUnderline="false"/>
				</textElement>
				<text>
					<![CDATA[        2. Container form re-validation - BHD 4.000 / container (each re-validation) (Exclude VAT).]]>
				</text>
			</staticText>
