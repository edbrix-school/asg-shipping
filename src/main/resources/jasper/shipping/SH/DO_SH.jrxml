	<subDataset name="BL_MANIFEST_CONTAINER" uuid="be4ebc8f-ad50-4712-8a99-cc914e20089c">
		<parameter name="P_CONT_TRAN_NO" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[select CONTAINER_NO,EQUIPMENT_ISO_TYPE,CONTAINER_TYPE_SIZE,CONTAINER_TYPE_ISO_NAME,EQUIPMENT_SEAL_NO,NO_OF_PACKS,PACK_UNIT,NET_WEIGHT,GRS_VOLUME,
GRS_weight,NET_VOLUME
 from SHIP_BL_MANIFEST_CONTAINER_DTL CONTDTL
INNER JOIN SHIP_CONTAINER_TYPE_MASTER CONTTYP ON CONTAINER_TYPE_CODE=EQUIPMENT_ISO_TYPE
where CONTDTL.transaction_poid=$P{P_CONT_TRAN_NO}
union all
select CARGO_DESCRIPTION,null, to_char(QUANTITY),null, null,NO_OF_PACKS, PACK_UNIT, NET_WEIGHT,GRS_VOLUME,GRS_weight,NET_VOLUME
from  SHIP_BL_MANIFEST_GENERAL_DTL genldtl
where genldtl.transaction_poid=$P{P_CONT_TRAN_NO}]]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_ISO_TYPE" class="java.lang.String"/>
		<field name="CONTAINER_TYPE_SIZE" class="java.lang.String"/>
		<field name="CONTAINER_TYPE_ISO_NAME" class="java.lang.String"/>
		<field name="EQUIPMENT_SEAL_NO" class="java.lang.String"/>
		<field name="NO_OF_PACKS" class="java.math.BigDecimal"/>
		<field name="PACK_UNIT" class="java.lang.String"/>
		<field name="NET_WEIGHT" class="java.math.BigDecimal"/>
		<field name="GRS_VOLUME" class="java.math.BigDecimal"/>
		<field name="GRS_WEIGHT" class="java.math.BigDecimal"/>
		<field name="NET_VOLUME" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="CARGO_DESCRIPTION" uuid="56b7e88d-b35d-4421-946a-c59c025286eb">
		<parameter name="P_CARGO_TRAN_NO" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[select CARGO_DESCRIPTION,DESCRIPTION_TYPE from SHIP_BL_MANIFEST_CARGO_DTL CARGODTL where DESCRIPTION_TYPE='CARGO'
and CARGODTL.transaction_poid=$P{P_CARGO_TRAN_NO} and CARGO_DESCRIPTION is not null
UNION ALL
select MAX(CARGO_DESCRIPTION),'CARGO' from SHIP_BL_MANIFEST_CONTAINER_DTL scdtl where scdtl.TRANSACTION_POID= $P{P_CARGO_TRAN_NO}
GROUP BY TRANSACTION_POID
UNION ALL
select MAX(CARGO_DESCRIPTION),'CARGO' from SHIP_BL_MANIFEST_GENERAL_DTL scdtl where scdtl.TRANSACTION_POID= $P{P_CARGO_TRAN_NO}
GROUP BY TRANSACTION_POID]]>
		</queryString>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
		<field name="DESCRIPTION_TYPE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="MARK_NOS" uuid="90528a2b-eccc-4e33-a40a-0c6a42aa5165">
		<parameter name="P_MARKS_TRAN_NO" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[select CARGO_DESCRIPTION,DESCRIPTION_TYPE from SHIP_BL_MANIFEST_CARGO_DTL CARGODTL where DESCRIPTION_TYPE='MARK' and
CARGODTL.transaction_poid=$P{P_MARKS_TRAN_NO} and CARGO_DESCRIPTION is not null]]>
		</queryString>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
		<field name="DESCRIPTION_TYPE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="COMPANY_LOG" uuid="58fa9fd2-59c4-44b7-87f9-810d102e5728">
		<parameter name="LOGIN_COMP_POID_L" class="java.lang.String" isForPrompting="false"/>
		<parameter name="LOGIN_DIV_POID_L" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT CM.COMPANY_POID, CM.COMPANY_NAME, CM.ADDRESS, CM.LOGO_IMAGE, CMD.REMARKS, CMD.COMPANY_DIV_LOGO, CMD.COMPANY_DIV_ADDRESS
FROM GLOBAL_COMPANY_MASTER CM
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID
WHERE CM.COMPANY_POID = $P{LOGIN_COMP_POID_L}
AND CMD.DIV_POID = $P{LOGIN_DIV_POID_L}]]>
		</queryString>
		<field name="COMPANY_POID" class="java.math.BigDecimal"/>
		<field name="COMPANY_NAME" class="java.lang.String"/>
		<field name="ADDRESS" class="java.lang.String"/>
		<field name="LOGO_IMAGE" class="java.io.InputStream"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="COMPANY_DIV_LOGO" class="java.io.InputStream"/>
		<field name="COMPANY_DIV_ADDRESS" class="java.lang.String"/>
	</subDataset>
	<parameter name="P_TRAN_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DEBUG" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select MHDR.TRANSACTION_POID,BL_NUMBER,
NVL((select DISTINCT DECODE(GET_ADDRESS_DETAILS (PRINT_CUSTOMER_POID),'N/A',CONSIGNEE_EDI_NAME,GET_ADDRESS_DETAILS (PRINT_CUSTOMER_POID)) from AR_SH_RECEIPT_HDR
WHERE BL_POID=MHDR.TRANSACTION_POID),(CASE WHEN upper(GET_ADDRESS_NAME(NOTIFY_POID_1)) like '%ORDER%' or (upper(GET_ADDRESS_NAME(NOTIFY_POID_1)) like '%N/A%') THEN gET_ADDRESS_NAME(DECODE( DO_PRIORITY,'C',CONSIGNEE_POID,'N',NOTIFY_POID_1,CONSIGNEE_POID))
   ELSE GET_ADDRESS_NAME(DECODE( DO_PRIORITY,'C',CONSIGNEE_POID,'N',NOTIFY_POID_1,NOTIFY_POID_1)) END)) CONSIGNEE_EDI_NAME
,NOTIFY1_EDI_NAME,
NOTIFY2_EDI_NAME,nvl(MHDR.DOCUMENT_COMPANY_POID,nvl(MHDR.COMPANY_POID,1)) DOCUMENT_COMPANY_POID ,nvl(MHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(MHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) DOCUMENT_COMPANY_DIVISION_POID,
CUSTOM_REGNO,GET_PORT_NAME(DESTINATION_PORT_POID) DESTINATION_PORT,GET_PORT_NAME(PORT_OF_LOADING_POID)  PORT_OF_LOADING,GET_LINE_NAME(vhdr.LINE_POID) LINE_NAME,VOYAGE_NO,GET_VESSEL_NAME(VESSEL_POID) VESSEL_NAME, to_char(NVL(ARRIVAL_DATE,EXPECTED_DATE),'DD-MON-YYYY') ETA,PRE_CARRIED_BY ,JOB_NO,
GET_COMPANY_NAME(nvl(DOCUMENT_COMPANY_POID,mhdr.COMPANY_POID)) Print_Company,
(select max(DO_DATE) from DO_sh_PRINTING_DTL dodtl where dodtl.TRANSACTION_POID=mhdr.TRANSACTION_POID) do_date,
(select max(DO_no) from DO_sh_PRINTING_DTL dodtl where dodtl.TRANSACTION_POID=mhdr.TRANSACTION_POID) do_no,
RTN_GLOBAL_PARAMETER(1, 'GLOBAL_COMPANY_STAMP', DECODE(nvl($P{P_DEBUG},'N') ,'Y','STAMP_TEST','STAMP'), mHDR.COMPANY_POID, NULL)  STAMP_DISPLAY

from SHIP_BL_MANIFEST_HDR MHDR
INNER JOIN  SHIP_VOYAGE_HDR VHDR
ON VHDR.TRANSACTION_POID = MHDR.VOYAGE_TRANSACTION_POID
INNER JOIN SHIP_LINE_MASTER SLN
ON   SLN.LINE_POID=VHDR.LINE_POID
WHERE MHDR.TRANSACTION_POID =
$P{P_TRAN_NO} AND    NVL(HOLD_REASON,'5') NOT IN('1','3','5')
AND NVL(SLN.DO_PRINT_LINE,'N')='Y']]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="CONSIGNEE_EDI_NAME" class="java.lang.String"/>
	<field name="NOTIFY1_EDI_NAME" class="java.lang.String"/>
	<field name="NOTIFY2_EDI_NAME" class="java.lang.String"/>
	<field name="DOCUMENT_COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="DOCUMENT_COMPANY_DIVISION_POID" class="java.math.BigDecimal"/>
	<field name="CUSTOM_REGNO" class="java.lang.String"/>
	<field name="DESTINATION_PORT" class="java.lang.String"/>
	<field name="PORT_OF_LOADING" class="java.lang.String"/>
	<field name="LINE_NAME" class="java.lang.String"/>
	<field name="VOYAGE_NO" class="java.lang.String"/>
	<field name="VESSEL_NAME" class="java.lang.String"/>
	<field name="ETA" class="java.lang.String"/>
	<field name="PRE_CARRIED_BY" class="java.lang.String"/>
	<field name="JOB_NO" class="java.lang.String"/>
	<field name="PRINT_COMPANY" class="java.lang.String"/>
	<field name="DO_DATE" class="java.sql.Timestamp"/>
	<field name="DO_NO" class="java.lang.String"/>
	<field name="STAMP_DISPLAY" class="java.lang.String"/>
