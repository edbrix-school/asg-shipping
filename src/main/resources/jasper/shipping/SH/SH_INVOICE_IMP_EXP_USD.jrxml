	<subDataset name="Charge_detail" uuid="f4afee65-d43c-44cb-8911-782411d1267f">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
		<parameter name="P_BL_POID" class="java.math.BigDecimal"/>
		<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
			<defaultValueExpression><![CDATA[N]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select PRINT_GROUP,PRINT_GROUP_ORDER, round(SUM(AMOUNT/nvl(CURRENCY_EXCHANGE,0)),2) amount,
QUANTITY,CURRENCY_CODE,PRINT_CURRENCY_EXCHANGE CURRENCY_EXCHANGE,SUM(PER_QTY_SELL_AMT) PER_QTY_SELL_AMT, SUM(AMOUNT_FC) AMOUNT_FC,TAX_PERCENTAGE,SUM(VAT_AMOUNT) VAT_AMOUNT,SUM(TOTAL_AMOUNT_FC) TOTAL_AMOUNT_FC,SUM(TAX_AMOUNT_BD) TAX_AMOUNT_BD,
SUM(AMOUNT) TOTAL_AMOUNT_BD from
(
SELECT  (select NVL(min(PRINT_GROUP),GET_CHARGE_NAME(ARCDTL.CHARGE_POID))
from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID=  $P{P_BL_POID}) PRINT_GROUP,
(select min(DECODE(SUBSTR(PRINT_GROUP,1,5),'Freig',1,'Local',99999,'Termi',99998,2) )from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID=  $P{P_BL_POID}) PRINT_GROUP_ORDER,
Amount,QUANTITY,NVL(PRINT_CURRENCY_CODE,CURRENCY_CODE ) CURRENCY_CODE , NVL(PRINT_CURRENCY_EXCHANGE,CURRENCY_EXCHANGE ) PRINT_CURRENCY_EXCHANGE,CURRENCY_EXCHANGE  CURRENCY_EXCHANGE, NVL(PRINT_RATE_AMT,PER_QTY_SELL_AMT ) PER_QTY_SELL_AMT,
 (nvl(QUANTITY,0)*nvl(PER_QTY_SELL_AMT,0)) AMOUNT_FC,NVL(TAX_PERCENTAGE,0) TAX_PERCENTAGE,(nvl(QUANTITY,0)*nvl(PER_QTY_SELL_AMT,0))*(NVL(TAX_PERCENTAGE,0)/100) VAT_AMOUNT,
 (nvl(QUANTITY,0)*nvl(PER_QTY_SELL_AMT,0))*(NVL(TAX_PERCENTAGE,0)/100) + (nvl(QUANTITY,0)*nvl(PER_QTY_SELL_AMT,0)) TOTAL_AMOUNT_FC,
 NVL(TAX_AMOUNT,0) TAX_AMOUNT_BD  FROM  AR_SH_SALES_INVOICE_CHARG_DTL ARCDTL
inner JOIN SHIP_CHARGE_MASTER CMAST ON CMAST.CHARGE_POID = ARCDTL.CHARGE_POID
WHERE ARCDTL.TRANSACTION_POID =  $P{P_TRANSACTION_POID}
AND BL_POID IN(SELECT TRANSACTION_POID FROM SHIP_BL_MANIFEST_HDR WHERE  TRANSACTION_POID= $P{P_BL_POID})
order by PRINT_GROUP_ORDER
)
group by  PRINT_GROUP_ORDER,PRINT_GROUP,QUANTITY,CURRENCY_CODE,CURRENCY_EXCHANGE,TAX_PERCENTAGE,PRINT_CURRENCY_EXCHANGE HAVING sum(Amount)<>0
order by  PRINT_GROUP_ORDER]]>
		</queryString>
		<field name="PRINT_GROUP" class="java.lang.String"/>
		<field name="PRINT_GROUP_ORDER" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="QUANTITY" class="java.math.BigDecimal"/>
		<field name="CURRENCY_CODE" class="java.lang.String"/>
		<field name="CURRENCY_EXCHANGE" class="java.math.BigDecimal"/>
		<field name="PER_QTY_SELL_AMT" class="java.math.BigDecimal"/>
		<field name="AMOUNT_FC" class="java.math.BigDecimal"/>
		<field name="TAX_PERCENTAGE" class="java.math.BigDecimal"/>
		<field name="VAT_AMOUNT" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMOUNT_FC" class="java.math.BigDecimal"/>
		<field name="TAX_AMOUNT_BD" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMOUNT_BD" class="java.math.BigDecimal"/>
		<variable name="Sum_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
		</variable>
		<variable name="Total_text" class="java.lang.String">
			<variableExpression><![CDATA["Total amount(BD)   :"]]></variableExpression>
		</variable>
		<variable name="Total_received" class="java.lang.String">
			<variableExpression><![CDATA["Amount Received(BD):"]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="container_type" uuid="21ab848d-ba71-4861-950d-e3d3ff8f37dd">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CNT},'CNTTYPE',NULL)) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="AmountInWord" uuid="94d09520-f163-4835-adc6-7bcd4e91d602">
		<parameter name="Amount" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct 'USD '||FN_AMOUNT_IN_WORDS_COMMON(REPLACE($P{Amount},','),'USD') AMOUNT_IN_WORD from dual]]>
		</queryString>
		<field name="AMOUNT_IN_WORD" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_BL_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>

	<queryString>
		<![CDATA[SELECT HDR.TRANSACTION_POID,BHDR.BL_number,HDR.DOC_REF  DOC_REF,to_char(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE,HDR.BL_POID,LMAST.LINE_code||'/'||VESSEL_name||'/'||VOYAGE_NO LINE_VESSEL_INFO,
1 bl_count,
TO_CHAR(decode(BL_TYPE,'IMPORT',VHDR.ARRIVAL_DATE,VHDR.SAIL_DATE,'DD-MON-YYYY'),'DD-MON-YYYY' ) ARRIVAL_SAIL_DATE, PMAST.PORT_NAME, ADHDR.CUSTOMER_NAME CUSTOMER_PRINT_NAME, upper(COMPANY_NAME) COMPANY_NAME,
FN_FOR_CUSTOMER_ADDRESS('000-000',HDR.customer_poid,cust_type) DETAILS_ADDRESS,
(SELECT SUM(round(AMOUNT/CHGDTL.CURRENCY_EXCHANGE,2)) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_CHARGE_AMOUNT,

(SELECT
DECODE(HDR.CURRENCY_CODE,'BHD',TRIM(TO_CHAR(sum (CHRG.AMOUNT),'999,999.000')) ,TRIM(TO_CHAR(sum (  NVL(CHRG.QUANTITY,1) * NVL(CHRG.PER_QTY_SELL_AMT,0)),'999,999.00')) )
FROM
AR_SH_SALES_INVOICE_CHARG_DTL CHRG
INNER JOIN AR_SH_SALES_INVOICE_HDR SHDR ON SHDR.TRANSACTION_POID = CHRG.TRANSACTION_POID
where CHRG.TRANSACTION_POID=HDR.TRANSACTION_POID  AND NVL(AMOUNT,0)<>0
group by HDR.CURRENCY_CODE) NOVAT_INV_AMOUNT,

(SELECT
DECODE(HDR.CURRENCY_CODE,'BHD',TRIM(TO_CHAR(sum (CHRG.TAX_AMOUNT),'999,999.000')) ,TRIM(TO_CHAR(sum (   (NVL(CHRG.QUANTITY,1) * NVL(CHRG.PER_QTY_SELL_AMT,0))*(nvl(chrg.TAX_PERCENTAGE,0)/100)),'999,999.00')) )
FROM
AR_SH_SALES_INVOICE_CHARG_DTL CHRG
INNER JOIN AR_SH_SALES_INVOICE_HDR SHDR ON SHDR.TRANSACTION_POID = CHRG.TRANSACTION_POID
where CHRG.TRANSACTION_POID=HDR.TRANSACTION_POID  AND NVL(AMOUNT,0)<>0
group by HDR.CURRENCY_CODE) TAX_AMOUNT,

(SELECT
DECODE(HDR.CURRENCY_CODE,'BHD',
TRIM(TO_CHAR(sum (CHRG.AMOUNT+CHRG.TAX_AMOUNT),'999,999.000')) ,
TRIM(TO_CHAR(sum (round((NVL(CHRG.QUANTITY,1) * NVL(CHRG.PER_QTY_SELL_AMT,0))+((NVL(CHRG.QUANTITY,1) * NVL(CHRG.PER_QTY_SELL_AMT,0))*(nvl(chrg.TAX_PERCENTAGE,0)/100)),2)),'999,999.00')) )
FROM
AR_SH_SALES_INVOICE_CHARG_DTL CHRG
INNER JOIN AR_SH_SALES_INVOICE_HDR SHDR ON SHDR.TRANSACTION_POID = CHRG.TRANSACTION_POID
where CHRG.TRANSACTION_POID=HDR.TRANSACTION_POID  AND NVL(AMOUNT,0)<>0
group by HDR.CURRENCY_CODE) DISPLAY_INV_AMOUNT,



(SELECT round(SUM(AMOUNT),3) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_CHARGE_AMOUNT_LOAL,

(SELECT SUM(TAX_AMOUNT) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_TAX_AMOUNT,

(SELECT SUM(NVL(AMOUNT,0))+SUM(NVL(TAX_AMOUNT,0)) FROM  AR_SH_SALES_INVOICE_CHARG_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_AMOUNT,


nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1)) COMPANY_POID,
nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) COMPANY_DIVISION_POID,
' BD:'|| FN_AMOUNT_IN_WORDS_common(INV_AMOUNT,'BHD') AMOUNT_IN_WORDS
, GET_PORT_NAME(BHDR.PORT_OF_LOADING_POID) LOAD_PORT, GET_PORT_NAME(BHDR.PORT_OF_DISCHARGE_POID) DISCHARGE_PORT,GET_PORT_NAME(BHDR.PLACE_OF_DELIEVERY_POID) DELIVERY_PORT,
BL_TYPE,nvl(OFF_TEL1,MOBILE) OFFICE_TEL,PO_BOX,
upper(AREA_CITY) area,upper(STATE) STATE,
decode(trim(upper(AREA_CITY)),'MANAMA','KINGDOM OF BAHRAIN',GET_COUNTRY_NAME(ADRHDRMST.COUNTRY_POID)) country,

MOBILE,EMAIL1 EMAIL,BLDG BUILDING,division_name,HDR.LPO_SRN_NO LPO_NO,TO_CHAR(HDR.LPO_SRN_DATE,'DD-MON-YYYY') LPO_DATE,TO_CHAR(INV_DATE,'DD-MON-YYYY')  INV_DATE,
to_char(nvl(DUE_DATE,INV_DATE + nvl(CREDIT_DAYS,0)),'DD-MON-YYYY') DUE_DATE,
decode(nvl(ADHDR.TIN_NUMBER,ADHDR.TIN_NUMBER),null,null,'VAT number: '||nvl(ADHDR.TIN_NUMBER,ADHDR.TIN_NUMBER)) TIN_NUMBER,
decode(COMMAST.TIN_NUMBER ,null,null,COMMAST.TIN_NUMBER ) Company_TIN_NUMBER,
 decode(sign(to_date(INV_DATE)-to_date(VAT_REGISTRATION_DATE)),'-1',' ',decode(COMMAST.TIN_NUMBER ,null,' ','TAX' )) Company_TAX,

    ( HDR.CURRENCY_RATE)
 TOTAL_AMOUNT_exchange_FOR_USD,HDR.CURRENCY_CODE
,
('Beneficiary Name :-'||COMPANY_NAME||CHR(13)||CHR(10)|| 'Bank Name :-'||GBM.BANK_ADDRESS||CHR(13)||CHR(10) ||'Account Number :-'||GBM.BANK_ACCOUNT_NO||CHR(13)||CHR(10)||'Swift Code :-'||GBM.SWIFT_CODE||CHR(13)||CHR(10)||'IBAN Number :-'||GBM.IBAN
) PAYMENT_DETAILS

,CC_REF,PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID
FROM AR_SH_SALES_INVOICE_HDR HDR
inner JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
inner JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
inner JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
inner JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
inner JOIN
(select 'CUSTOMER' cust_type,CUSTOMER_POID,CUSTOMER_NAME,TIN_NUMBER,ADDRESS_POID from
SALES_CUSTOMER_MASTER ADHDR
union all
select 'PRINCIPAL' cust_type,PRINCIPAL_POID CUSTOMER_POID,PRINCIPAL_name  CUSTOMER_NAME,TIN_NUMBER,ADDRESS_POID from SHIP_PRINCIPAL_MASTER aphdr
) ADHDR
ON HDR.CUSTOMER_POID=ADHDR.CUSTOMER_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER ADRHDRMST ON  ADHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID
left JOIN GLOBAL_ADDRESS_DETAILS ADRDTL ON ADHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID and TRIM(ADRDTL.ADDRESS_TYPE) ='MAIN'
LEFT JOIN SHIP_PORT_MASTER PMAST ON PMAST.PORT_POID = decode(BL_TYPE,'IMPORT',BHDR.PORT_OF_LOADING_POID,PORT_OF_DISCHARGE_POID)
inner JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1))
INNER JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID=nvl(hdr.PRINT_INVOICE_BANK_POID,COMMAST.BANK_POID)
inner join global_division_master divmast on divmast.DIVISION_POID = nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1))
WHERE HDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
