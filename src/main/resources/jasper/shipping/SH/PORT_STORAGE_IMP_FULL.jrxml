	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TILL_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct LINE,BL_NUMBER,CONTAINER_NO,ISO_CODE,to_date(ARRIVAL_DATE)ARRIVAL_DATE,to_date(TILL_TODAY) TILL_TODAY,FREE_DAYS,Storage,total_chares,
case when ((to_date(TILL_TODAY) - to_date(ARRIVAL_DATE)) + 1) > FREE_DAYS then round((((to_date(TILL_TODAY) - to_date(ARRIVAL_DATE)) + 1) - FREE_DAYS)) end  paid_days from(
select distinct GET_LINE_NAME(LINE_POID) LINE, BL_NUMBER,condtl.CONTAINER_NO,CONTAINER_TYPE_CODE ISO_CODE,TO_DATE( NVL(ARRIVAL_DATE,EXPECTED_DATE)) Arrival_Date,to_char(TO_DATE($P{P_TILL_DATE}),'DD-MON-YYYY') Till_Today
,(SELECT FREE_DAYS
FROM SHIP_PORT_TARIFF_HDR THDR
INNER JOIN SHIP_PORT_TARIFF_DTL TIDTL ON  TIDTL.TRANSACTION_POID=THDR.TRANSACTION_POID
WHERE  to_date(SAIL_DATE) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
and TARIFF_TYPE='FULL' and CONTAINER_SIZE=TMAST.CONTAINER_TYPE_SIZE) FREE_DAYS,
round((to_date(TO_DATE($P{P_TILL_DATE})) - to_date(NVL(ARRIVAL_DATE,EXPECTED_DATE))) + 1) Storage,
FUNC_RTN_port_storage
( hdr.GROUP_POID,hdr.company_poid,-999, hdr.transaction_poid,condtl.CONTAINER_NO,
TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid, TO_DATE( NVL(ARRIVAL_DATE,EXPECTED_DATE)),TO_DATE($P{P_TILL_DATE}),'FULL') total_chares
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'IMPORT'
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
where
ISSUE_TO_CONSIGNEE IS NULL AND NVL(ARRIVAL_DATE,EXPECTED_DATE)>='1-APR-2016' AND TO_DATE( NVL(ARRIVAL_DATE,EXPECTED_DATE))<=TO_DATE($P{P_TILL_DATE})
 and hdr.TRANSACTION_POID =$P{DOC_KEY_POID}
) order by LINE]]>
	</queryString>
