	<subDataset name="Charge_detail" uuid="f4afee65-d43c-44cb-8911-782411d1267f">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
		<parameter name="P_BL_POID" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[select TRANSACTION_POID, DET_ROW_ID, BL_POID, PRINT_GROUP_CHARGE, QUANTITY,ORG_CURRENCY_CODE, CURRENCY_CODE, CURRENCY_EXCHANGE, PER_QTY_FC_AMT,  PER_QTY_USD_AMT ,USD_AMOUNT, CREATED_BY, CREATED_DATE, LASTMODIFIED_BY, LASTMODIFIED_DATE from AR_SH_SALES_INVOICE_PRT_DTL
where TRANSACTION_POID=$P{P_TRANSACTION_POID}
order by  PRINT_GROUP_CHARGE]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DET_ROW_ID" class="java.math.BigDecimal"/>
		<field name="BL_POID" class="java.math.BigDecimal"/>
		<field name="PRINT_GROUP_CHARGE" class="java.lang.String"/>
		<field name="QUANTITY" class="java.math.BigDecimal"/>
		<field name="ORG_CURRENCY_CODE" class="java.lang.String"/>
		<field name="CURRENCY_CODE" class="java.lang.String"/>
		<field name="CURRENCY_EXCHANGE" class="java.math.BigDecimal"/>
		<field name="PER_QTY_FC_AMT" class="java.math.BigDecimal"/>
		<field name="PER_QTY_USD_AMT" class="java.math.BigDecimal"/>
		<field name="USD_AMOUNT" class="java.math.BigDecimal"/>
		<field name="CREATED_BY" class="java.lang.String"/>
		<field name="CREATED_DATE" class="oracle.sql.TIMESTAMP"/>
		<field name="LASTMODIFIED_BY" class="java.lang.String"/>
		<field name="LASTMODIFIED_DATE" class="oracle.sql.TIMESTAMP"/>
		<variable name="Sum_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{USD_AMOUNT}]]></variableExpression>
		</variable>
		<variable name="Total_text" class="java.lang.String">
			<variableExpression><![CDATA["Total amount(BD)   :"]]></variableExpression>
		</variable>
		<variable name="Total_received" class="java.lang.String">
			<variableExpression><![CDATA["Amount Received(BD):"]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="container_type" uuid="21ab848d-ba71-4861-950d-e3d3ff8f37dd">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CNT},'CNTTYPE',NULL)) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="AmountInWord" uuid="94d09520-f163-4835-adc6-7bcd4e91d602">
		<parameter name="Amount" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct 'USD '||FN_AMOUNT_IN_WORDS_COMMON($P{Amount},'USD') AMOUNT_IN_WORD from dual]]>
		</queryString>
		<field name="AMOUNT_IN_WORD" class="java.lang.String"/>
	</subDataset>
