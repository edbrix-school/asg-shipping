		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT HDR.TRANSACTION_POID,BHDR.BL_number,HDR.DOC_REF  DOC_REF,to_char(HDR.TRANSACTION_DATE,invoice_date_format) TRANSACTION_DATE,HDR.BL_POID,LMAST.LINE_code||'/'||VESSEL_name||'/'||VOYAGE_NO LINE_VESSEL_INFO,
1 bl_count,TO_CHAR(decode(BL_TYPE,'IMPORT',VHDR.ARRIVAL_DATE,VHDR.SAIL_DATE,invoice_date_format),invoice_date_format) ARRIVAL_SAIL_DATE, PMAST.PORT_NAME, NVL(ADHDR.CUSTOMER_NAME,PRINCIPAL_NAME) CUSTOMER_PRINT_NAME, upper(COMPANY_NAME) COMPANY_NAME,
(SELECT SUM(USD_AMOUNT) FROM  AR_SH_SALES_INVOICE_PRT_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID ) TOTAL_CHARGE_AMOUNT,
nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1)) COMPANY_POID,
nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) COMPANY_DIVISION_POID,
' USD:'|| FN_AMOUNT_IN_WORDS_common((SELECT SUM(USD_AMOUNT) FROM  AR_SH_SALES_INVOICE_PRT_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID ),'USD') AMOUNT_IN_WORDS
, GET_PORT_NAME(BHDR.PORT_OF_LOADING_POID) LOAD_PORT, GET_PORT_NAME(BHDR.PORT_OF_DISCHARGE_POID) DISCHARGE_PORT,GET_PORT_NAME(BHDR.PLACE_OF_DELIEVERY_POID) DELIVERY_PORT,
BL_TYPE,nvl(OFF_TEL1,MOBILE) OFFICE_TEL,PO_BOX,upper(AREA_CITY) STATE,decode(trim(upper(AREA_CITY)),'MANAMA','KINGDOM OF BAHRAIN',GET_COUNTRY_NAME(ADRHDRMST.COUNTRY_POID)) country,MOBILE,EMAIL1 EMAIL,BLDG BUILDING,division_name,HDR.LPO_SRN_NO LPO_NO,TO_CHAR(HDR.LPO_SRN_DATE,invoice_date_format) LPO_DATE,TO_CHAR(INV_DATE,invoice_date_format)  INV_DATE,
to_char(nvl(DUE_DATE,INV_DATE + nvl(CREDIT_DAYS,0)),invoice_date_format) DUE_DATE,
PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID,
DECODE(BANK_DETAILS_CMP_MASTER,'YES','A/C Payee Cheque In Favor of '||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'   '||COMPANY_NAME,'Beneficiary Name :-'||COMPANY_NAME||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'Bank Name :-'||GBM.BANK_ADDRESS||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'Account Number :-'||GBM.BANK_ACCOUNT_NO||CHR(13)||CHR(10)||'Swift Code :-'||GBM.SWIFT_CODE||CHR(13)||CHR(10)||'IBAN Number :-'||GBM.IBAN
) PAYMENT_DETAILS,cc_ref
FROM AR_SH_SALES_INVOICE_HDR HDR
inner JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
inner JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
inner JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
inner JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
RIGHT JOIN SALES_CUSTOMER_MASTER ADHDR ON HDR.CUSTOMER_POID=ADHDR.CUSTOMER_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER PDHDR ON HDR.CUSTOMER_POID=PDHDR.PRINCIPAL_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER ADRHDRMST ON (ADHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID)
left JOIN GLOBAL_ADDRESS_DETAILS ADRDTL ON (ADHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID) and TRIM(ADRDTL.ADDRESS_TYPE) ='MAIN'
LEFT JOIN SHIP_PORT_MASTER PMAST ON PMAST.PORT_POID = decode(BL_TYPE,'IMPORT',BHDR.PORT_OF_LOADING_POID,nvl(PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID))
inner JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1))
inner join global_division_master divmast on divmast.DIVISION_POID = nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1))
INNER JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID=COMMAST.BANK_POID
WHERE  HDR.TRANSACTION_POID =  $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.lang.String"/>
	<field name="BL_POID" class="java.math.BigDecimal"/>
