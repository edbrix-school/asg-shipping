		<variableExpression><![CDATA[$F{BL_COUNT} == 1 ? "" :"PART OF"]]></variableExpression>
	</variable>
	<variable name="Address" class="java.lang.String">
		<initialValueExpression><![CDATA["P. O. BOX :" +($F{PO_BOX} == null? "":$F{PO_BOX}) +($F{BUILDING} == null ? "":$F{BUILDING}) + "\n" + "Email :" +($F{EMAIL}== null ? "":$F{EMAIL})+"\n"+"Contact Number :" +($F{OFFICE_TEL} == null ? "" :$F{OFFICE_TEL}) +($F{MOBILE} == null ?"" :"/"+ $F{MOBILE} )]]></initialValueExpression>
	</variable>
	<variable name="Acc_payee" class="java.lang.String">
		<variableExpression><![CDATA["A/C Payee Cheque In Favor of "+ $F{COMPANY_NAME}]]></variableExpression>
		<initialValueExpression><![CDATA["A/C Payee Cheque In Favor of "+$F{COMPANY_NAME}]]></initialValueExpression>
	</variable>
