	<queryString>
		<![CDATA[SELECT CARGODTL.CARGO_DESCRIPTION MARK
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL   ON MFHDR.TRANSACTION_POID =CARGODTL.TRANSACTION_POID
WHERE CARGODTL.DESCRIPTION_TYPE='MARK' AND
MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID}
order by nvl(CARGODTL.RECORD_ORDER,CARGODTL.DET_ROW_ID)]]>
	</queryString>
	<field name="MARK" class="java.lang.String"/>
