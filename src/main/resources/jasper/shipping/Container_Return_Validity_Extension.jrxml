<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Container_Return_Validity_Extension" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f48174d2-f814-4f03-aeb5-0b201a8e64d1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="CONTAINER_NO_CODE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
      CASE WHEN EXT_COUNT = 1 THEN DM_TO_DATE WHEN EXT_COUNT = 2  THEN 'XXXXXXXX' ELSE '' END as  Ext1,
      CASE WHEN EXT_COUNT = 2 THEN DM_TO_DATE WHEN EXT_COUNT = 3  THEN 'XXXXXXXX' ELSE '' END as  Ext2,
      CASE WHEN EXT_COUNT = 3 THEN DM_TO_DATE WHEN EXT_COUNT = 4  THEN 'XXXXXXXX' ELSE '' END as  Ext3,
      CASE WHEN EXT_COUNT = 4 THEN DM_TO_DATE WHEN EXT_COUNT = 5  THEN 'XXXXXXXX' ELSE '' END as  Ext4,
      CASE WHEN EXT_COUNT = 5 THEN DM_TO_DATE WHEN EXT_COUNT = 6  THEN 'XXXXXXXX' ELSE '' END as  Ext5,
      CASE WHEN EXT_COUNT = 6 THEN DM_TO_DATE WHEN EXT_COUNT = 7  THEN 'XXXXXXXX' ELSE '' END as  Ext6,
      CASE WHEN EXT_COUNT = 1 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 2  THEN 'XXXXXXXX' ELSE '' END as  CNT1,
      CASE WHEN EXT_COUNT = 2 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 3  THEN 'XXXXXXXX' ELSE '' END as  CNT2,
      CASE WHEN EXT_COUNT = 3 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 4  THEN 'XXXXXXXX' ELSE '' END as  CNT3,
      CASE WHEN EXT_COUNT = 4 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 5  THEN 'XXXXXXXX' ELSE '' END as  CNT4,
      CASE WHEN EXT_COUNT = 5 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 6  THEN 'XXXXXXXX' ELSE '' END as  CNT5,
      CASE WHEN EXT_COUNT = 6 THEN SUBSTR($P{CONTAINER_NO_CODE},5) WHEN EXT_COUNT = 7  THEN 'XXXXXXXX' ELSE '' END as  CNT6



      FROM(
            SELECT DO_NO, to_char(DM_TO_DATE) DM_TO_DATE, FREE_DAYS, CASE WHEN FREE_DAYS > 0 THEN  EXT_COUNT+1 ELSE EXT_COUNT END as EXT_COUNT
            FROM (SELECT
                        MAX(DO_NO) DO_NO,MAX(DM_TO_DATE) DM_TO_DATE, NVL(MAX(FREE_DAYS),0) FREE_DAYS, COUNT(*) as EXT_COUNT
                  FROM
                        VW_AR_SH_CONTAINER_DEMG_DTTN VWDMTN
                  INNER JOIN SHIP_BL_MANIFEST_HDR MHDR ON MHDR.TRANSACTION_POID=VWDMTN.BL_POID
                  WHERE
                        BL_POID=$P{DOC_KEY_POID} and CONTAINER_NO=$P{CONTAINER_NO_CODE}))]]>
	</queryString>
	<field name="EXT1" class="java.lang.String"/>
	<field name="EXT2" class="java.lang.String"/>
	<field name="EXT3" class="java.lang.String"/>
	<field name="EXT4" class="java.lang.String"/>
