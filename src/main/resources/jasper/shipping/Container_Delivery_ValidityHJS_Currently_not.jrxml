<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Container_Return_ValidityHJS" language="groovy" pageWidth="595" pageHeight="842" columnWidth="532" leftMargin="43" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fa8fe9d4-300e-42f1-981b-34c84a9c7273">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" uuid="eb748215-7563-48d2-b201-700dcf700541">
		<parameter name="P_BLPOID" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="P_CONTAINERNO" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select DM_TO_DATE validity_date from AR_SH_RECEIPT_CONTAINER_DTL
WHERE BL_POID=$P{P_BLPOID} AND CONTAINER_NO=$P{P_CONTAINERNO}
 order by DM_TO_DATE]]>
		</queryString>
		<field name="VALIDITY_DATE" class="java.sql.Timestamp"/>
	</subDataset>
	<parameter name="P_TRAN_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ROWNUM SEQNO ,D.CONTAINER_NO,CONTAINER_TYPE_SIZE ||' ' ||CONTAINER_TYPE_ISO_NAME   CNTSIZE,D.QUANTITY,NVL(D.GRS_WEIGHT,0)/1000 DWT,
D.GRS_VOLUME,D.PACK_UNIT,D.NO_OF_PACKS,
upper(GET_COMPANY_NAME(H.COMPANY_POID))COMPANY,H.BL_NUMBER,H.DO_NO ,H.SHIPPER_POID,get_address_Name(H.SHIPPER_POID)SHIPPER,
get_LINE_NAME(VY.LINE_POID)LINE,VY.VOYAGE_NO,VY.ARRIVAL_DATE,GET_VESSEL_NAME(VY.VESSEL_POID) VESSEL,FREE_DAYS,EXTRA_FREE_DAYS,(VY.ARRIVAL_DATE+decode(nvl(EXTRA_FREE_DAYS,0),0, FREE_DAYS ,EXTRA_FREE_DAYS))-1 first_validity,H.TRANSACTION_POID,
TO_CHAR(sysdate,'DD-MON-YYYY') current_date,
H.COMPANY_POID
FROM SHIP_BL_MANIFEST_CONTAINER_DTL D ,SHIP_BL_MANIFEST_HDR H, SHIP_VOYAGE_HDR VY
, SHIP_CONTAINER_TYPE_MASTER CONTTYP,
SHIP_LINE_TARIFF_HDR shlinetHD ,
SHIP_LINE_TARIFF_IMP_DTL shlinetrf
WHERE
shlinetHD.TRANSACTION_POID=shlinetrf.TRANSACTION_POID
AND
D.TRANSACTION_POID=H.TRANSACTION_POID AND VY.TRANSACTION_POID=H.VOYAGE_TRANSACTION_POID
and CONTAINER_TYPE_CODE=EQUIPMENT_ISO_TYPE
and shlinetrf.CONTAINER_TYPE_POID=GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE)
and H.TRANSACTION_POID=$P{P_TRAN_NO}
AND to_date(NVL(ARRIVAL_DATE,EXPECTED_DATE)) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO) and shlinetHD.LINE_POID=VY.line_poid AND NVL(print_return_form_dEFAULT,'N') IN ('Y','MANUALLYPRINT')]]>
	</queryString>
	<field name="SEQNO" class="java.math.BigDecimal"/>
	<field name="CONTAINER_NO" class="java.lang.String"/>
	<field name="CNTSIZE" class="java.lang.String"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
	<field name="DWT" class="java.math.BigDecimal"/>
	<field name="GRS_VOLUME" class="java.math.BigDecimal"/>
	<field name="PACK_UNIT" class="java.lang.String"/>
	<field name="NO_OF_PACKS" class="java.math.BigDecimal"/>
	<field name="COMPANY" class="java.lang.String"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="DO_NO" class="java.lang.String"/>
	<field name="SHIPPER_POID" class="java.math.BigDecimal"/>
	<field name="SHIPPER" class="java.lang.String"/>
	<field name="LINE" class="java.lang.String"/>
	<field name="VOYAGE_NO" class="java.lang.String"/>
	<field name="ARRIVAL_DATE" class="java.sql.Timestamp"/>
	<field name="VESSEL" class="java.lang.String"/>
	<field name="FREE_DAYS" class="java.math.BigDecimal"/>
	<field name="EXTRA_FREE_DAYS" class="java.math.BigDecimal"/>
	<field name="FIRST_VALIDITY" class="java.sql.Timestamp"/>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="CURRENT_DATE" class="java.lang.String"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
