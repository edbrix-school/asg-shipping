<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SH_PROFORMA_INV_IMP_MANFST_BL_SUBREPORT2" language="groovy" pageWidth="570" pageHeight="360" columnWidth="570" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="dd942e33-2433-4f5a-90dd-62aacd8710fd">
	<property name="ireport.zoom" value="2.357947691000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_CHRG_TRN_POID" class="java.lang.Long">
		<defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DTL.CHARGE_POID, CHM.CHARGE_NAME, DTL.QUANTITY,
DTL.PER_QUANTITY_AMOUNT RATE,
DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY AMOUNT,
DTL.TAX_PERCENTAGE VAT_PERCENTAGE,
(DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY)*(TAX_PERCENTAGE/100) VAT_AMOUNT,
(DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY) + ((DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY)*(TAX_PERCENTAGE/100)) TOTAL
FROM SHIP_BL_MANIFEST_CHARGES_DTL DTL
INNER JOIN SHIP_CHARGE_MASTER CHM ON DTL.CHARGE_POID=CHM.CHARGE_POID
WHERE DTL.FREIGHT_TYPE='C' and RECEIPT_INVOICE_POID is null  and (DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY  )>0
AND DTL.TRANSACTION_POID=$P{P_CHRG_TRN_POID}]]>
	</queryString>
	<field name="CHARGE_POID" class="java.math.BigDecimal"/>
	<field name="CHARGE_NAME" class="java.lang.String"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
	<field name="RATE" class="java.math.BigDecimal"/>
	<field name="AMOUNT" class="java.math.BigDecimal"/>
	<field name="VAT_PERCENTAGE" class="java.math.BigDecimal"/>
	<field name="VAT_AMOUNT" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="AMOUNT_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
	</variable>
	<variable name="TOTALAMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
	</variable>
	<variable name="TOTAL_BASE_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
	</variable>
	<variable name="TOTAL_VAT_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VAT_AMOUNT}]]></variableExpression>
	</variable>
