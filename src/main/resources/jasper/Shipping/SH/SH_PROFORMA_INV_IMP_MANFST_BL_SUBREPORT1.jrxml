	<parameter name="CC_REF" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT MNF.TRANSACTION_POID,MNF.TRANSACTION_DATE,MNF.COMPANY_POID,MNF.GROUP_POID,MNF.FF_JOBNO,MNF.FF_JOBTYPE,
decode(MNF.LINE_POID,null,'',get_LINE_NAME(MNF.LINE_POID))LINE,

NVL(PROC_FF_CHARGE_GET_DATA_MASTER($P{P_TRN_NO},$P{P_INV_POID},'HSBL'),MNF.MASTER_BL_NO) MASTER_BL_NO

,MNF.VOYAGE_POID,MNF.FEEDER_VSL_NAME,MNF.FEEDER_VSL_SAIL_DATE,
MNF.FEEDER_VSL_ETA,MNF.FEEDER_VSL_ARRIVAL_DATE,
(SELECT AIRPORT_NAME FROM FF_AIRPORT_MASTER WHERE AIRPORT_CODE=MNF.AIR_DEPARTURE_PORT)  AWPORT_LOAD,

(SELECT NVL(PROC_FF_CHARGE_GET_DATA_MASTER($P{P_TRN_NO},$P{P_INV_POID},'PORT'),AIRPORT_NAME)  FROM FF_AIRPORT_MASTER WHERE AIRPORT_CODE=MNF.AIR_ARRIVAL_PORT)  AWPORT_UNLOAD,

MNF.TOTAL_NO_OF_PACKS,MNF.DOC_REF ,MNF.FLIGHT_NO,
NVL(PROC_FF_CHARGE_GET_DATA_MASTER($P{P_TRN_NO},$P{P_INV_POID},'WT'),MNF.CHARGABLE_WEIGHT) CHARGABLE_WEIGHT,
MNF.FLIGHT_DATE,MNF.CARGO_DESCRIPTION,
VOY.VOYAGE_NO,MNF.LPO_NO,MNF.LPO_DATE,MNF.HOUSE_BL_NO, SHIPPER_MANUAL, FCR_SUPLIER_SHIPPER_REF
FROM FF_MANIEST_HDR MNF
LEFT JOIN SHIP_VOYAGE_HDR VOY ON VOY.TRANSACTION_POID=MNF.VOYAGE_POID
WHERE MNF.TRANSACTION_POID=$P{P_TRN_NO} AND (MNF.FF_JOBTYPE LIKE 'AIR%'  )]]>
	</queryString>
