	<parameter name="DAY_CLOSED_REPORT_SUBREPORT_2" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT
                       DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS') LINE,REPHDR.TRANSACTION_DATE receipt_date, REPHDR.COMPANY_POID, REPHDR.DOC_REF receipt_no,  BL_NUMBER,
                         AMOUNT RCPT_AMOUNT,ADDRESS_NAME received_from,REPHDR.created_by USER_ID,PYMT_TYPE||' '||CHQ_CARDNO cheque
                  FROM
                        AR_SH_RECEIPT_HDR REPHDR
                  inner JOIN SHIP_BL_MANIFEST_HDR MANIHDR       ON REPHDR.BL_POID                  = MANIHDR.TRANSACTION_POID
                  LEFT JOIN SHIP_VOYAGE_HDR VOYAGE              ON MANIHDR.VOYAGE_TRANSACTION_POID = VOYAGE.TRANSACTION_POID
                  LEFT join GLOBAL_ADDRESS_MASTER addrmast on REPHDR.PRINT_CUSTOMER_POID = addrmast.ADDRESS_MASTER_POID
                  inner join AR_SH_RECEIPT_PYMT_DETAILS reppay on rephdr.transaction_poid=reppay.transaction_poid
                  WHERE NVL(REPHDR.DELETED,'N') = 'N' and nvl(AMOUNT,0)<>0 and
                         to_date(TRUNC(REPHDR.TRANSACTION_DATE)) BETWEEN $P{P_START_DATE} AND   $P{P_END_DATE}
   order by REPHDR.COMPANY_POID,REPHDR.DOC_REF]]>
	</queryString>
