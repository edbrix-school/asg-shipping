	<queryString>
		<![CDATA[SELECT hdr.GROUP_POID,hdr.company_poid,hdr.transaction_poid,voyhdr.line_poid
from SHIP_BL_MANIFEST_HDR hdr
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
where hdr.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="GROUP_POID" class="java.math.BigDecimal"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
