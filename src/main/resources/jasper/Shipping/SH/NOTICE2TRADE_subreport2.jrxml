<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="NOTICE2TRADE_subreport2" language="groovy" pageWidth="540" pageHeight="802" columnWidth="540" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="AllSectionsNoDetail" uuid="a3893b40-cf52-4769-afe6-09c148a08e28">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_DOC_POID2" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT distinct TRANSACTION_POID,CONTAINER_TYPE_CATEGORY,CNT_SIZE,CNT_TYPE_CATEGORY,FREE_DAYS,
CASE WHEN NVL(SLAB1_TILLDAYS,0)>999 AND NVL(SLAB2_TILLDAYS,0)=0 THEN NVL(FREE_DAYS,0)||'-Thereafter' ELSE (NVL(FREE_DAYS,0)+1)||'-'||(NVL(SLAB1_TILLDAYS,0)+NVL(FREE_DAYS,0)) END SLAB1SAYS,SLAB1_RATE,
CASE WHEN NVL(SLAB1_TILLDAYS,0)>999 or  NVL(SLAB2_TILLDAYS,0)=0  then '0' WHEN NVL(SLAB2_TILLDAYS,0)>999 THEN 'Thereafter' ELSE (NVL(SLAB1_TILLDAYS,0)+NVL(FREE_DAYS,0)+1)||'-'||(NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(FREE_DAYS,0))END SLAB2SAYS,SLAB2_RATE,
CASE WHEN NVL(SLAB1_TILLDAYS,0)>999 or NVL(SLAB2_TILLDAYS,0)>999 or  NVL(SLAB3_TILLDAYS,0)=0 THEN '0' WHEN NVL(SLAB3_TILLDAYS,0)>999 THEN 'Thereafter'  ELSE (NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(FREE_DAYS,0)+1)||'-'||(NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(SLAB3_TILLDAYS,0)+NVL(FREE_DAYS,0))END SLAB3SAYS,SLAB3_RATE,
CASE WHEN NVL(SLAB2_TILLDAYS,0)>999 or NVL(SLAB3_TILLDAYS,0)>999 or (NVL(SLAB3_TILLDAYS,0)=0 or NVL(SLAB4_TILLDAYS,0)=0) THEN '0' WHEN NVL(SLAB4_TILLDAYS,0)>999 THEN 'Thereafter'  ELSE (NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(SLAB3_TILLDAYS,0)+NVL(FREE_DAYS,0)+1)||'-'||(NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(SLAB3_TILLDAYS,0)+NVL(SLAB4_TILLDAYS,0)+NVL(FREE_DAYS,0))END SLAB4SAYS,SLAB4_RATE,
CASE WHEN NVL(SLAB2_TILLDAYS,0)>999 or NVL(SLAB3_TILLDAYS,0)>999 or NVL(SLAB4_TILLDAYS,0)>999 or (NVL(SLAB3_TILLDAYS,0)=0 or NVL(SLAB4_TILLDAYS,0)=0 or NVL(SLAB5_TILLDAYS,0)=0) THEN '0' WHEN NVL(SLAB5_TILLDAYS,0)>999 THEN 'Thereafter'  ELSE (NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(SLAB3_TILLDAYS,0)+NVL(SLAB4_TILLDAYS,0)+NVL(FREE_DAYS,0)+1)||'-'||(NVL(SLAB1_TILLDAYS,0)+NVL(SLAB2_TILLDAYS,0)+NVL(SLAB3_TILLDAYS,0)+NVL(SLAB4_TILLDAYS,0)+NVL(SLAB5_TILLDAYS,0)+NVL(FREE_DAYS,0))END SLAB5SAYS,SLAB5_RATE
FROM(
SELECT THDR.TRANSACTION_POID,
decode(CNTTYPE.CONTAINER_TYPE_CATEGORY,'STD','STANDARD','SPL','SPECIAL EQUIPMENT','REF','REEFERS')CONTAINER_TYPE_CATEGORY,
CNTTYPE.CONTAINER_TYPE_SIZE CNT_SIZE,
CNTTYPE.CONTAINER_TYPE_SIZE||CNTTYPE.CONTAINER_TYPE_ISO_NAME CNT_TYPE_CATEGORY ,
TDTL.FREE_DAYS ,
--TDTL.SLAB1_TILLDAYS,
nvl(TDTL.SLAB1_RATE,0)SLAB1_RATE,
CASE WHEN nvl(TDTL.SLAB1_TILLDAYS,0)>0 THEN nvl(TDTL.SLAB1_TILLDAYS,0) ELSE 0 END SLAB1_TILLDAYS,
CASE WHEN nvl(TDTL.SLAB2_TILLDAYS,0)>0 THEN ABS(nvl(TDTL.SLAB2_TILLDAYS,0)-nvl(TDTL.SLAB1_TILLDAYS,0)) ELSE 0 END SLAB2_TILLDAYS,
TDTL.SLAB2_TILLDAYS TOTAL_SLAB2DAYS,
nvl(TDTL.SLAB2_RATE,0)SLAB2_RATE,
CASE WHEN nvl(TDTL.SLAB3_TILLDAYS,0)>0 THEN ABS(nvl(TDTL.SLAB3_TILLDAYS,0)-nvl(TDTL.SLAB2_TILLDAYS,0)) ELSE 0 END SLAB3_TILLDAYS,
TDTL.SLAB3_TILLDAYS TOTAL_SLAB3DAYS,
nvl(TDTL.SLAB3_RATE,0)SLAB3_RATE,
CASE WHEN nvl(TDTL.SLAB4_TILLDAYS,0)>0 THEN ABS(nvl(TDTL.SLAB4_TILLDAYS,0)-nvl(TDTL.SLAB3_TILLDAYS,0)) ELSE 0 END SLAB4_TILLDAYS,
TDTL.SLAB4_TILLDAYS TOTAL_SLAB4DAYS,
nvl(TDTL.SLAB4_RATE,0) SLAB4_RATE,
CASE WHEN nvl(TDTL.SLAB5_TILLDAYS,0)>0 THEN ABS(nvl(TDTL.SLAB5_TILLDAYS,0)-nvl(TDTL.SLAB4_TILLDAYS,0)) ELSE 0 END SLAB5_TILLDAYS,
TDTL.SLAB5_TILLDAYS TOTAL_SLAB5DAYS,
nvl(TDTL.SLAB5_RATE,0)SLAB5_RATE
FROM SHIP_LINE_TARIFF_IMP_DTL TDTL
INNER JOIN SHIP_LINE_TARIFF_HDR THDR ON THDR.TRANSACTION_POID=TDTL.TRANSACTION_POID
INNER JOIN SHIP_CONTAINER_TYPE_MASTER CNTTYPE ON TDTL.CONTAINER_TYPE_POID=CNTTYPE.CONTAINER_TYPE_POID
WHERE TDTL.TRANSACTION_POID=$P{P_DOC_POID2}
AND CNTTYPE.CONTAINER_TYPE_SIZE||CNTTYPE.CONTAINER_TYPE_ISO_NAME NOT LIKE '%AUTOBASIS%'
) ORDER BY CONTAINER_TYPE_CATEGORY DESC,CNT_SIZE]]>
	</queryString>
