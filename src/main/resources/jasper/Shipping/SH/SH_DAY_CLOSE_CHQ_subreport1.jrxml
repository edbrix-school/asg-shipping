<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SH_DAY_CLOSE_CHQ_subreport1" language="groovy" pageWidth="600" pageHeight="400" columnWidth="600" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="087dbc4d-1538-467f-af36-1d5e39a59876">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_TRN_DT" class="java.sql.Timestamp">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String"/>
	<parameter name="DOC_KEY_POID_DNOC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT rownum,GET_COMPANY_CODE(nvl(RC.DOCUMENT_CMP_POID,RC.COMPANY_POID)) Phy_COMPANY,GET_COMPANY_CODE(RC.COMPANY_POID)COMPANY,RC.doc_ref, PY.CHQ_CARDNO,PY.CHQ_DATE,GET_CUST_BANK_CODE(PY.BANK_POID) BANK,PY.ACCOUNT_NAME,PY.ACCOUNT_NO,PY.AMOUNT,
(SELECT  COUNT(GET_COMPANY_CODE(nvl(DRC.DOCUMENT_CMP_POID,DRC.COMPANY_POID))) Phy_COMPANY FROM AR_SH_RECEIPT_PYMT_DETAILS DPY,AR_SH_RECEIPT_HDR DRC WHERE
                      DPY.TRANSACTION_POID=DRC.TRANSACTION_POID
                  AND DPY.PYMT_TYPE in('CHEQUE') AND NVL(DPY.AMOUNT,0)<>0
and       TRUNC(DRC.TRANSACTION_DATE)=$P{P_TRN_DT} AND DRC.COMPANY_POID=RC.COMPANY_POID) CNT,
DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTH') LINE
        FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID
AND NVL(RC.DELETED,'N')='N'
                  AND PY.PYMT_TYPE in('CHEQUE') AND NVL(PY.AMOUNT,0)<>0
and       TRUNC(RC.TRANSACTION_DATE)=$P{P_TRN_DT}
order by nvl(RC.DOCUMENT_CMP_POID,RC.COMPANY_POID),RC.COMPANY_POID,PY.BANK_POID,RC.doc_ref,PY.CHQ_DATE]]>
	</queryString>
	<field name="ROWNUM" class="java.math.BigDecimal"/>
	<field name="PHY_COMPANY" class="java.lang.String"/>
	<field name="COMPANY" class="java.lang.String"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="CHQ_CARDNO" class="java.lang.String"/>
	<field name="CHQ_DATE" class="java.sql.Timestamp"/>
	<field name="BANK" class="java.lang.String"/>
	<field name="ACCOUNT_NAME" class="java.lang.String"/>
	<field name="ACCOUNT_NO" class="java.lang.String"/>
	<field name="AMOUNT" class="java.math.BigDecimal"/>
	<field name="CNT" class="java.math.BigDecimal"/>
	<field name="LINE" class="java.lang.String"/>
	<variable name="AMOUNT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
	</variable>
	<variable name="CNT_PAGE" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{ROWNUM}]]></variableExpression>
	</variable>
