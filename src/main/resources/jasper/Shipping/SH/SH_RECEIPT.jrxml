    <subDataset name="Charge_detail" uuid="f4afee65-d43c-44cb-8911-782411d1267f">
        <parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
        <parameter name="P_BL_POID" class="java.math.BigDecimal"/>
        <parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
            <defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
        </parameter>
        <queryString>
            <![CDATA[SELECT decode(CMAST.CHARGE_CODE,'DEM','Line Demurrage ','Total Amount collected  ') PRINT_GROUP,SUM(AMOUNT+NVL(TAX_AMOUNT,0)) Amount,1 PRINT_GROUP_ORDER FROM AR_SH_RECEIPT_CHARGES_DTL ARCDTL
LEFT JOIN SHIP_CHARGE_MASTER CMAST ON CMAST.CHARGE_POID = ARCDTL.CHARGE_POID
WHERE ARCDTL.TRANSACTION_POID = $P{P_TRANSACTION_POID}  AND ARCDTL.BL_POID = $P{P_BL_POID} AND $P{DETAIL_SHOW_FLAG} = 'N'
GROUP BY decode(CMAST.CHARGE_CODE,'DEM','Line Demurrage ','Total Amount collected  ')
UNION ALL
select PRINT_GROUP, sum(Amount) amount,PRINT_GROUP_ORDER from (
SELECT  (select NVL(min(PRINT_GROUP),GET_CHARGE_NAME(ARCDTL.CHARGE_POID))
from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID= $P{P_BL_POID}) PRINT_GROUP, (select min(DECODE(SUBSTR(PRINT_GROUP,1,5),'Freig',1,'Local',99999,'Termi',99998,2) )from SHIP_BL_MANIFEST_CHARGES_DTL mchgdtl where mchgdtl.DET_ROW_ID=ARCDTL.CHARGES_DET_ROW_ID and mchgdtl.CHARGE_POID= ARCDTL.CHARGE_POID AND  mchgdtl.TRANSACTION_POID=  $P{P_BL_POID}) PRINT_GROUP_ORDER,
(Amount+NVL(TAX_AMOUNT,0)) Amount  FROM  AR_SH_RECEIPT_CHARGES_DTL ARCDTL
inner JOIN SHIP_CHARGE_MASTER CMAST ON CMAST.CHARGE_POID = ARCDTL.CHARGE_POID
WHERE ARCDTL.TRANSACTION_POID =  $P{P_TRANSACTION_POID}
AND BL_POID IN(SELECT TRANSACTION_POID FROM SHIP_BL_MANIFEST_HDR WHERE BL_TYPE = 'IMPORT' and $P{DETAIL_SHOW_FLAG} ='Y'  AND TRANSACTION_POID= $P{P_BL_POID})
)
group by  PRINT_GROUP_ORDER,PRINT_GROUP HAVING sum(Amount)<>0
order by  PRINT_GROUP_ORDER]]>
        </queryString>
        <field name="PRINT_GROUP" class="java.lang.String"/>
        <field name="AMOUNT" class="java.math.BigDecimal"/>
        <field name="PRINT_GROUP_ORDER" class="java.math.BigDecimal"/>
        <variable name="Sum_amount" class="java.math.BigDecimal" calculation="Sum">
            <variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
        </variable>
        <variable name="Total_text" class="java.lang.String">
            <variableExpression><![CDATA["Total amount(BD)   :"]]></variableExpression>
        </variable>
        <variable name="Total_received" class="java.lang.String">
            <variableExpression><![CDATA["Amount Received(BD):"]]></variableExpression>
        </variable>
    </subDataset>
    <subDataset name="Payment_details" uuid="9f8bc016-0fd8-4fcf-ae8f-eceaa05024a1">
        <parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
        <parameter name="P_PART_OF" class="java.lang.String" isForPrompting="false"/>
        <queryString>
            <![CDATA[SELECT DECODE(TRIM(replace(PYMT_TYPE,'IMCO','')),'CHEQUE',$P{P_PART_OF}||' '||BANK_CODE||' '||'CHQ:'||' '||CHQ_CARDNO||' DATED '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CASH',
$P{P_PART_OF}||' '||'CASH BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CARD',$P{P_PART_OF}||' '||'CARD:'||BANK_CODE||' '||CHQ_CARDNO||' '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),TRIM(PYMT_TYPE)||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999'))) CASH_CHEQUE
FROM  AR_SH_RECEIPT_PYMT_DETAILS ARPAYDTL
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BANKMAS ON BANKMAS.BANK_POID = ARPAYDTL.BANK_POID
WHERE ARPAYDTL.TRANSACTION_POID = $P{P_TRANSACTION_POID} AND( NVL(AMOUNT,0) > 0)]]>
        </queryString>
        <field name="CASH_CHEQUE" class="java.lang.String"/>
    </subDataset>
    <subDataset name="AmountInWord" uuid="6d678bb5-b09a-4bad-97e2-69af65910fcc">
        <parameter name="Amount" class="java.lang.String"/>
        <queryString>
            <![CDATA[select FN_AMOUNT_IN_WORDS_COMMON($P{Amount},'BHD') AMOUNT_IN_WORD from dual]]>
        </queryString>
        <field name="AMOUNT_IN_WORD" class="java.lang.String"/>
    </subDataset>
    <subDataset name="PartOf" uuid="c3476b5a-187f-4f10-b8e6-58d3b504d11d">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT DECODE(TRIM(PYMT_TYPE),'CHEQUE',' '||'CHQ:'||BANK_CODE||' '||CHQ_CARDNO||' '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CASH',
' '||'CASH BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CARD',' '||'CARD:'||BANK_CODE||' '||CHQ_CARDNO||' '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),TRIM(PYMT_TYPE)||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999'))) CASH_CHEQUE
FROM  AR_SH_RECEIPT_PYMT_DETAILS ARPAYDTL
LEFT JOIN GL_BANK_MASTER BANKMAS ON BANKMAS.BANK_POID = ARPAYDTL.BANK_POID
WHERE ARPAYDTL.TRANSACTION_POID = (select transaction_poid from AR_SH_RECEIPT_split_dtl where split_transaction_poid = $P{DOC_KEY_POID}) AND( NVL(AMOUNT,0) > 0)]]>
        </queryString>
        <field name="CASH_CHEQUE" class="java.lang.String"/>
    </subDataset>
    <subDataset name="Container_Details" uuid="bd4a50a5-c132-47cb-a60f-834833eb91e1">
        <parameter name="P_BL_POID" class="java.math.BigDecimal">
            <defaultValueExpression><![CDATA[]]></defaultValueExpression>
        </parameter>
        <parameter name="DOC_KEY_POID_C" class="java.lang.String"/>
        <queryString>
            <![CDATA[select DISTINCT CONTAINER_NO from
AR_SH_RECEIPT_HDR ARHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL SHCNT ON ARHDR.BL_POID=SHCNT.TRANSACTION_POID
INNER JOIN AR_SH_RECEIPT_CHARGES_DTL SHCHG ON   ARHDR.BL_POID=SHCHG.BL_POID and ARHDR.TRANSACTION_POID=SHCHG.TRANSACTION_POID
WHERE (TO_CHAR(CHARGE_POID) IN (select  (PARAMETER_VALUE) from GLOBAL_PARAMETERS  where (UPPER(parameter_Keyid_type) IN('CHARGE_IMCO_POID') AND IS_IMCO='Y'))
OR
TO_CHAR(CHARGE_POID) IN (select  (PARAMETER_VALUE) from GLOBAL_PARAMETERS  where UPPER(parameter_Keyid_type) IN('CHARGE_DEPOSIT_POID'))) and arhdr.bl_POID= $P{P_BL_POID} AND ARHDR.TRANSACTION_POID=$P{DOC_KEY_POID_C}]]>
        </queryString>
        <field name="CONTAINER_NO" class="java.lang.String"/>
    </subDataset>
    <subDataset name="COMPANY_LOG_1_1" uuid="40fbf5b3-e667-42f1-931b-7c9ec62887c8">
        <parameter name="LOGIN_COMP_POID_L" class="java.lang.String" isForPrompting="false"/>
        <parameter name="LOGIN_DIV_POID_L" class="java.lang.String" isForPrompting="false"/>
        <queryString>
            <![CDATA[SELECT CM.COMPANY_POID, CM.COMPANY_NAME, CM.ADDRESS, CM.LOGO_IMAGE, CMD.REMARKS, CMD.COMPANY_DIV_LOGO, CMD.COMPANY_DIV_ADDRESS
FROM GLOBAL_COMPANY_MASTER CM
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID
WHERE CM.COMPANY_POID = $P{LOGIN_COMP_POID_L}
AND CMD.DIV_POID = $P{LOGIN_DIV_POID_L}]]>
        </queryString>
        <field name="COMPANY_POID" class="java.math.BigDecimal"/>
        <field name="COMPANY_NAME" class="java.lang.String"/>
        <field name="ADDRESS" class="java.lang.String"/>
        <field name="LOGO_IMAGE" class="java.io.InputStream"/>
        <field name="REMARKS" class="java.lang.String"/>
        <field name="COMPANY_DIV_LOGO" class="java.io.InputStream"/>
        <field name="COMPANY_DIV_ADDRESS" class="java.lang.String"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_BL_POID" class="java.lang.String"/>
    <parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
        <defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT HDR.TRANSACTION_POID,BHDR.BL_number,HDR.DOC_REF DOC_REF,to_char(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE,
(TO_DATE(SYSDATE)-TO_DATE(HDR.TRANSACTION_DATE)) ISSUED_DAYS,
HDR.BL_POID,LMAST.LINE_NAME||'/'||VESSEL_name||'/'||VOYAGE_NO LINE_VESSEL_INFO,
1 bl_count,
TO_CHAR(VHDR.ARRIVAL_DATE,'DD-MON-YYYY') ARRIVAL_DATE, PMAST.PORT_NAME, ADHDR.ADDRESS_NAME CUSTOMER_PRINT_NAME,'For'||' '||COMPANY_NAME COMPANY_NAME,(SELECT SUM(AMOUNT+NVL(TAX_Amount,0)) AMOUNT FROM  AR_SH_RECEIPT_CHARGES_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_CHARGE_AMOUNT,nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1)) COMPANY_POID ,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) COMPANY_DIVISION_POID,
NVL((select DISTINCT 'YES' from
AR_SH_RECEIPT_HDR ARHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL SHCNT ON ARHDR.BL_POID=SHCNT.TRANSACTION_POID
INNER JOIN AR_SH_RECEIPT_CHARGES_DTL SHCHG ON   ARHDR.BL_POID=SHCHG.BL_POID
WHERE (TO_CHAR(CHARGE_POID) IN (select  (PARAMETER_VALUE) from GLOBAL_PARAMETERS  where (UPPER(parameter_Keyid_type) IN('CHARGE_IMCO_POID') AND IS_IMCO='Y'))
OR
TO_CHAR(CHARGE_POID) IN (select  (PARAMETER_VALUE) from GLOBAL_PARAMETERS  where UPPER(parameter_Keyid_type) IN('CHARGE_DEPOSIT_POID')))
and arhdr.bl_POID= HDR.BL_POID and shchg.transaction_poid=hdr.transaction_poid),'NO') IS_DEPOSIT,
  NVL((SELECT decode(TO_CHAR(VHDR.ARRIVAL_DATE,'RRRR'),'2018',DECODE(NVL(DOC_REF,'-999'),'-999','-999','INVOICE TOTAL'),NVL(DOC_REF,'-999')) FROM AR_SH_SALES_INVOICE_HDR WHERE TRANSACTION_POID=NVL(CREATED_INVOICE_POID,-999)),'-999')
  AS AGAINST_INVOICE
,
nvl(FN_FOR_CUSTOMER_ADDRESS('000-000',(select customer_poid from AR_SH_SALES_INVOICE_HDR where transaction_poid=CREATED_INVOICE_POID),'CUSTOMER')
,ADHDR.ADDRESS_NAME)  DETAILS_ADDRESS
FROM AR_SH_RECEIPT_HDR HDR
LEFT JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
LEFT JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
LEFT JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
LEFT JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER ADHDR ON ADHDR.ADDRESS_MASTER_POID=HDR.PRINT_CUSTOMER_POID
LEFT JOIN SHIP_PORT_MASTER PMAST ON PMAST.PORT_POID = BHDR.PORT_OF_LOADING_POID
left JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1))
WHERE HDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="BL_NUMBER" class="java.lang.String"/>
    <field name="DOC_REF" class="java.lang.String"/>
    <field name="TRANSACTION_DATE" class="java.lang.String"/>
    <field name="ISSUED_DAYS" class="java.math.BigDecimal"/>
    <field name="BL_POID" class="java.math.BigDecimal"/>
    <field name="LINE_VESSEL_INFO" class="java.lang.String"/>
    <field name="BL_COUNT" class="java.math.BigDecimal"/>
    <field name="ARRIVAL_DATE" class="java.lang.String"/>
    <field name="PORT_NAME" class="java.lang.String"/>
    <field name="CUSTOMER_PRINT_NAME" class="java.lang.String"/>
    <field name="COMPANY_NAME" class="java.lang.String"/>
    <field name="TOTAL_CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="COMPANY_POID" class="java.math.BigDecimal"/>
    <field name="COMPANY_DIVISION_POID" class="java.math.BigDecimal"/>
    <field name="IS_DEPOSIT" class="java.lang.String"/>
    <field name="AGAINST_INVOICE" class="java.lang.String"/>
    <field name="DETAILS_ADDRESS" class="java.lang.String"/>
    <variable name="V_PAGE_COUNT" class="java.math.BigDecimal" resetType="None" incrementType="Page">
        <variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
    </variable>
    <variable name="Part_of" class="java.lang.String">
        <variableExpression><![CDATA[$F{BL_COUNT} == 1 ? "" :"PART OF"]]></variableExpression>
    </variable>
