	<subDataset name="CompanyLogo" uuid="0609c782-d35b-478a-8d93-2cbfa3d6de3c">
		<parameter name="LOGIN_COMP_POID_L" class="java.lang.String"/>
		<parameter name="LOGIN_DIV_POID_L" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT CM.COMPANY_POID, CM.COMPANY_NAME, CM.ADDRESS, CM.LOGO_IMAGE, CMD.REMARKS, CMD.COMPANY_DIV_LOGO, CMD.COMPANY_DIV_ADDRESS
FROM GLOBAL_COMPANY_MASTER CM
INNER JOIN GLOBAL_COMPANY_MASTER_DIV_DTL CMD ON CM.COMPANY_POID = CMD.COMPANY_POID WHERE CM.COMPANY_POID = $P{LOGIN_COMP_POID_L}
AND CMD.DIV_POID = $P{LOGIN_DIV_POID_L}]]>
		</queryString>
		<field name="COMPANY_POID" class="java.math.BigDecimal"/>
		<field name="COMPANY_NAME" class="java.lang.String"/>
		<field name="ADDRESS" class="java.lang.String"/>
		<field name="LOGO_IMAGE" class="java.io.InputStream"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="COMPANY_DIV_LOGO" class="java.io.InputStream"/>
		<field name="COMPANY_DIV_ADDRESS" class="java.lang.String"/>
	</subDataset>
	<subDataset name="ChargeQuery" uuid="73e85456-531a-4d74-b8be-6e9e0beb06bc">
		<parameter name="DOC_KEY_POID_CHG" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select TRANSACTION_POID,nvl(PRINT_GROUP,'Total charges payable  ') Charge,   DECODE(SUBSTR(PRINT_GROUP,1,5),'Freig',1,'Local',99999,'Termi',99998,2)  PRINT_GROUP_order,null CHARGE_TYPE,
SUM ( round(nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0),3)) total_amount,
floor(SUM ( ROUND(nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0),3))) Amount1 ,
rpad(replace(to_number(mod(SUM(round(nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0),3)),1)),'.',''),3,0) Amount2
from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C'
AND TRANSACTION_POID= $P{DOC_KEY_POID_CHG}
AND CHARGE_POID NOT IN  (SELECT PARAMETER_VALUE FROM GLOBAL_PARAMETERS WHERE PARAMETER_NAME='MANIFEST_IMCO_POID' AND PARAMETER_KEYID_TYPE='CHARGE_IMCO_POID' AND CATEGORY='SHIPPING')
and   (DET_ROW_ID,CHARGE_POID,TRANSACTION_POID) not in (
select nvl(CHARGES_DET_ROW_ID,0) ,nvl(CHARGE_POID,0) ,nvl(BL_POID,0)   from AR_SH_RECEIPT_CHARGES_DTL
)
GROUP BY  TRANSACTION_POID,PRINT_GROUP

union all

select cntdnt.transaction_poid,'Total Demurrage Amount payable (as of '||to_char(sysdate,'dd-Mon-RRRR') || ') ' Charge, null,null CHARGE_TYPE,
sum(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE), lINE_POID, ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS)) total_amount,
floor(sum(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE), lINE_POID, ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS)) ) Amount1 ,
rpad(replace(to_number(mod(sum(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE), lINE_POID, ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS)) ,1)),'.',''),3,0) Amount2
from
SHIP_VOYAGE_HDR vhdr
inner join SHIP_BL_MANIFEST_HDR mhdr on mhdr.voyage_transaction_poid=vhdr.transaction_poid
inner join SHIP_BL_MANIFEST_CONTAINER_DTL cntdnt on cntdnt.transaction_poid=mhdr.transaction_poid  AND cntdnt.TRANSACTION_POID= $P{DOC_KEY_POID_CHG} AND RETURN_FROM_CONSIGNEE IS NULL
GROUP BY  cntdnt.TRANSACTION_POID having (sum(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE), lINE_POID, ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS)))>0

ORDER BY  TRANSACTION_POID,3]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="CHARGE" class="java.lang.String"/>
		<field name="PRINT_GROUP_ORDER" class="java.math.BigDecimal"/>
		<field name="CHARGE_TYPE" class="java.lang.String"/>
		<field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
		<field name="AMOUNT1" class="java.math.BigDecimal"/>
		<field name="AMOUNT2" class="java.lang.String"/>
		<variable name="Sum_total_Charges" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_AMOUNT}]]></variableExpression>
		</variable>
		<variable name="Sum_total_Charges_frc" class="java.lang.String">
			<variableExpression><![CDATA[$V{Sum_total_Charges}.subtract($V{Sum_total_Charges}.intValue()).toString().replace("0.","").concat("000")]]></variableExpression>
		</variable>
		<variable name="total_amount1" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{AMOUNT1}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="ContainerType" uuid="a052bd9b-8850-48f0-8eba-b5ab3503fa22">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CNT},'CNTTYPE',NULL)) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="SpcRefSTD" uuid="9bd8557d-f7c8-4036-9759-f768ae91b1d7">
		<parameter name="DOC_KEY_POID_LINE" class="java.lang.String"/>
		<parameter name="DOC_KEY_POID_RUNDAYS" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_RUNDAYS},'LINEFREEDAYS',$P{DOC_KEY_POID_LINE})) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID=$P{DOC_KEY_POID_LINE}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="CargoDesc" uuid="c8d729ac-802b-4027-aa10-26e494eb520f">
		<parameter name="DOC_KEY_POID_CARGO" class="java.lang.String"/>
		<parameter name="P_DISPLAY_LINE" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CARGO},'CARGO',null))  SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CARGO} AND   GET_LINE_poid('MSC')<>$P{P_DISPLAY_LINE}
UNION ALL
select TRANSACTION_POID,MAX(CARGO_DESCRIPTION) from SHIP_BL_MANIFEST_CONTAINER_DTL scdtl where scdtl.TRANSACTION_POID= $P{DOC_KEY_POID_CARGO}
AND GET_LINE_poid('MSC')=$P{P_DISPLAY_LINE}
GROUP BY TRANSACTION_POID
UNION ALL
select TRANSACTION_POID,MAX(CARGO_DESCRIPTION) from SHIP_BL_MANIFEST_GENERAL_DTL scdtl where scdtl.TRANSACTION_POID= $P{DOC_KEY_POID_CARGO}
GROUP BY TRANSACTION_POID]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="AmountsInWord" uuid="ab584604-f28e-4578-81d5-c6e5dbe90e01">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<parameter name="DOC_KEY_POID_CHG" class="java.lang.String"/>
		<queryString>
			<![CDATA[select TRANSACTION_POID,FN_AMOUNT_IN_WORDS_COMMON(sum(amount),'BHD') Amount,REGEXP_SUBSTR (sum(amount), '[^.]+', 1, 1) Amount_NUM1,rpad(REGEXP_SUBSTR (sum(amount), '[^.]+', 1, 2),3,0) Amount_NUM2 from(
select TRANSACTION_POID,
SUM((nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0))) Amount from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C'
AND TRANSACTION_POID= $P{DOC_KEY_POID_CHG} and 1=2
GROUP BY CHARGE_POID,CHARGE_TYPE,TRANSACTION_POID
 union all
select TRANSACTION_POID,SUM((nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0))) Amount from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C'
AND TRANSACTION_POID= $P{DOC_KEY_POID_CHG}
AND CHARGE_POID NOT IN  (SELECT PARAMETER_VALUE FROM GLOBAL_PARAMETERS WHERE PARAMETER_NAME='MANIFEST_IMCO_POID' AND PARAMETER_KEYID_TYPE='CHARGE_IMCO_POID' AND CATEGORY='SHIPPING')
GROUP BY  TRANSACTION_POID
union all
select TRANSACTION_POID,SUM((nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0))) Amount from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C' and nvl(CHARGE_BASIS_ON,'XXXX') like '%AUTOBASIS%'
AND TRANSACTION_POID= $P{DOC_KEY_POID_CHG}
AND CHARGE_POID  IN  (SELECT PARAMETER_VALUE FROM GLOBAL_PARAMETERS WHERE PARAMETER_NAME='MANIFEST_IMCO_POID' AND PARAMETER_KEYID_TYPE='CHARGE_IMCO_POID' AND CATEGORY='SHIPPING')
GROUP BY  TRANSACTION_POID
ORDER BY  TRANSACTION_POID)
group by TRANSACTION_POID]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.lang.String"/>
		<field name="AMOUNT_NUM1" class="java.lang.String"/>
		<field name="AMOUNT_NUM2" class="java.lang.String"/>
	</subDataset>
	<subDataset name="imcoprint" uuid="73e80a99-31dc-4da3-96c6-d5389e430dff">
		<parameter name="DOC_KEY_POID_CHG" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select TRANSACTION_POID,'Total IMCO Deposit Amount payable (Separate Cheque)  ' Charge, null,null CHARGE_TYPE,
SUM ( (nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0))) total_amount,
floor(SUM ( (nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0)))) Amount1 ,
rpad(replace(to_number(mod(SUM(nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0)),1)),'.',''),3,0) Amount2
from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C'
AND CHARGE_POID  IN  (SELECT PARAMETER_VALUE FROM GLOBAL_PARAMETERS WHERE PARAMETER_NAME='MANIFEST_IMCO_POID' AND PARAMETER_KEYID_TYPE='CHARGE_IMCO_POID' AND CATEGORY='SHIPPING')
 AND TRANSACTION_POID= $P{DOC_KEY_POID_CHG}
GROUP BY  TRANSACTION_POID


ORDER BY  TRANSACTION_POID,3]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="CHARGE" class="java.lang.String"/>
		<field name="NULL" class="java.lang.String"/>
		<field name="CHARGE_TYPE" class="java.lang.String"/>
		<field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
		<field name="AMOUNT1" class="java.math.BigDecimal"/>
		<field name="AMOUNT2" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["100-203"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  nvl((select
SUM ( round((nvl(CURRENCY_EXCHANGE,1)*nvl(QUANTITY,0)*nvl(PER_QUANTITY_AMOUNT,0))+nvl(tax_amount,0),3)) oth_total_amount from SHIP_BL_MANIFEST_charges_DTL
where FREIGHT_TYPE='C'
AND TRANSACTION_POID= shdr.TRANSACTION_POID
and   (DET_ROW_ID,CHARGE_POID,TRANSACTION_POID) not in (
select nvl(CHARGES_DET_ROW_ID,0) ,nvl(CHARGE_POID,0) ,nvl(BL_POID,0)   from AR_SH_RECEIPT_CHARGES_DTL
) and ((SELECT nvl(SUM(NVL(DR_AMT,0)-NVL(CR_AMT,0)),1) FROM GL_LEDGER_BILLWISE_BREAKUP
WHERE (GL_POID,BILL_REF) IN (
SELECT GL_POID,DOC_REF FROM AR_SH_SALES_INVOICE_HDR ARH
INNER JOIN SALES_CUSTOMER_MASTER SCM ON ARH.CUSTOMER_POID=SCM.CUSTOMER_POID  WHERE TRANSACTION_POID IN (
select RECEIPT_INVOICE_POID from SHIP_BL_MANIFEST_charges_DTL where TRANSACTION_POID=shdr.TRANSACTION_POID
and FREIGHT_TYPE='C'
)
))>0)  ),0) oth_total_amount ,
 (SELECT
NVL(dem_total_amount + ((dem_total_amount*(SELECT NVL(MAX(PERCENTAGE),0) FROM GLOBAL_TAX_MASTER WHERE TAX_POID IN (SELECT TAX_POID FROM SHIP_CHARGE_MASTER WHERE CHARGE_POID=RTN_GLOBAL_PARAMETER(1, 'SHIPPERDEMURRAGE', 'SHDEMURRAGE', 1, '0'))))/100),0)
FROM
(select
sum(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(cntdnt.EQUIPMENT_ISO_TYPE), lINE_POID, vhdr.ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS)) dem_total_amount
from
SHIP_VOYAGE_HDR vhdr
inner join SHIP_BL_MANIFEST_HDR mhdr on mhdr.voyage_transaction_poid=vhdr.transaction_poid
inner join SHIP_BL_MANIFEST_CONTAINER_DTL cntdnt on cntdnt.transaction_poid=mhdr.transaction_poid
AND RETURN_FROM_CONSIGNEE IS NULL
AND mhdr.TRANSACTION_POID= shdr.TRANSACTION_POID
where
(fUNC_RTN_DEM_DETTN_FULL(vhdr.GROUP_POID , vhdr.COMPANY_POID , -999, cntdnt.transaction_poid, CONTAINER_NO, GET_CONTAINER_CODE_POID(cntdnt.EQUIPMENT_ISO_TYPE), lINE_POID, vhdr.ARRIVAL_DATE, to_date(sysdate), 'DEMM', EXTRA_FREE_DAYS))>0)
 )
dem_total_amount,
 CARGO_ARRIVAL_NUMBER DOC_REF,to_CHAR(nvl(ARRIVAL_DATE,EXPECTED_DATE),'DD-MON-YYYY') expected_arrival_date,
shdr.TRANSACTION_POID,TO_CHAR(shdr.TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE,VOYAGE_TRANSACTION_POID,BL_NUMBER,FREIGHT_STATUS,
GET_COMPANY_NAME(shdr.COMPANY_POID) COMPANY,  SHIPPER_EDI_NAME,SHIPPER_EDI_ADDRESS,nvl(GET_ADDRESS_NAME(CONSIGNEE_POID),CONSIGNEE_EDI_NAME)  CONSIGNEE_EDI_NAME,CONSIGNEE_EDI_ADDRESS,
nvl(decode(NOTIFY_POID_1,'1',NOTIFY1_EDI_NAME,GET_ADDRESS_NAME(NOTIFY_POID_1)),NOTIFY1_EDI_NAME) NOTIFY1_EDI_NAME,
 nvl(decode(NOTIFY_POID_1,'1',NOTIFY1_EDI_ADDRESS,GET_ADDRESS_DETAILS_WITH_TYPE(NOTIFY_ADDRESS_POID_1,NULL)),NOTIFY1_EDI_ADDRESS) NOTIFY1_EDI_ADDRESS,
NOTIFY2_EDI_NAME,NOTIFY2_EDI_ADDRESS,
NOTIFY3_EDI_NAME,NOTIFY3_EDI_ADDRESS,CAN_NOTIFY_CUSTOMER_POID,
VOYAGE_NO,GET_VESSEL_NAME(VESSEL_POID) ||' / '||voyage_no vessel_name,
BL_STATUS,PORT_OF_LOADING_POID,GET_PORT_NAME(PORT_OF_LOADING_POID) PORT_OF_LOADING,GET_PORT_NAME(PORT_OF_DISCHARGE_POID) PORT_OF_DISCHARGE,REMARKS
,TOTAL_VOLUME,TOTAL_WEIGHT,
(
SELECT SUM(NO_OF_PACKS) FROM (
select sum(NO_OF_PACKS) NO_OF_PACKS from SHIP_BL_MANIFEST_CONTAINER_DTL scdtl where scdtl.TRANSACTION_POID= shdr.TRANSACTION_POID
   UNION
select sum(NO_OF_PACKS)  from SHIP_BL_MANIFEST_GENERAL_DTL scdtl where scdtl.TRANSACTION_POID= shdr.TRANSACTION_POID )) TOTAL_NO_OF_PACKS,
(
  SELECT MAX(PACK_UNIT) FROM (
  select  max(PACK_UNIT) PACK_UNIT from SHIP_BL_MANIFEST_CONTAINER_DTL scdtl where scdtl.TRANSACTION_POID= shdr.TRANSACTION_POID
  UNION
  select  max(PACK_UNIT) from SHIP_BL_MANIFEST_GENERAL_DTL scdtl where scdtl.TRANSACTION_POID= shdr.TRANSACTION_POID
)
) UNIT_PACK,upper(DECODE(BL_ISSUE_TYPE,'1','ORIGINAL BL REQUIRED','2','EXPRESS RELEASED','3','SEAWAY BILL','4','OTHER')) BL_ISSUE_TYPE,
NVL(shdr.DOCUMENT_COMPANY_POID,shdr.COMPANY_POID) PRINT_COMPANY_POID,NVL(shdr.DOCUMENT_COMPANY_DIVISION_POID,1) PRINT_COMPANY_DIVISION_POID,
company_name,
line_name LINE_SHORT_NAME,
LNMAST.line_poid,
NVL((SELECT 'X' FROM VOYAGEWISEBILLS_APPROVED WHERE BL_POID=shdr.TRANSACTION_POID),'NOT FINALIZED-DRAFT ONLY') DRAFT_YES_NO,
decode(freight_status,'1','PREPAID','2','COLLECT','3','ELSE WHERE','OTHER') freight_status1,
(select min(SEND_YES_NO_DATE) from GLOBAL_EMAIL_FAX_RECORDS
where LINK_TRANSACTION_POID=shdr.transaction_poid) sent_date, to_Date(sysdate) current_date
FROM SHIP_BL_MANIFEST_HDR shdr
inner join SHIP_VOYAGE_HDR vhdr
on VHDR.TRANSACTION_POID=SHDR.VOYAGE_TRANSACTION_POID
left join global_company_master comp
on NVL(shdr.DOCUMENT_COMPANY_POID,shdr.COMPANY_POID)  = comp.company_poid
INNER JOIN SHIP_LINE_MASTER LNMAST  ON LNMAST.LINE_POID  =vhdr.LINE_POID
where shdr.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
	<field name="OTH_TOTAL_AMOUNT" class="java.math.BigDecimal"/>
	<field name="DEM_TOTAL_AMOUNT" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="EXPECTED_ARRIVAL_DATE" class="java.lang.String"/>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.lang.String"/>
	<field name="VOYAGE_TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="FREIGHT_STATUS" class="java.lang.String"/>
	<field name="COMPANY" class="java.lang.String"/>
	<field name="SHIPPER_EDI_NAME" class="java.lang.String"/>
	<field name="SHIPPER_EDI_ADDRESS" class="java.lang.String"/>
	<field name="CONSIGNEE_EDI_NAME" class="java.lang.String"/>
	<field name="CONSIGNEE_EDI_ADDRESS" class="java.lang.String"/>
	<field name="NOTIFY1_EDI_NAME" class="java.lang.String"/>
	<field name="NOTIFY1_EDI_ADDRESS" class="java.lang.String"/>
	<field name="NOTIFY2_EDI_NAME" class="java.lang.String"/>
	<field name="NOTIFY2_EDI_ADDRESS" class="java.lang.String"/>
	<field name="NOTIFY3_EDI_NAME" class="java.lang.String"/>
	<field name="NOTIFY3_EDI_ADDRESS" class="java.lang.String"/>
	<field name="CAN_NOTIFY_CUSTOMER_POID" class="java.math.BigDecimal"/>
	<field name="VOYAGE_NO" class="java.lang.String"/>
	<field name="VESSEL_NAME" class="java.lang.String"/>
	<field name="BL_STATUS" class="java.lang.String"/>
	<field name="PORT_OF_LOADING_POID" class="java.math.BigDecimal"/>
	<field name="PORT_OF_LOADING" class="java.lang.String"/>
	<field name="PORT_OF_DISCHARGE" class="java.lang.String"/>
	<field name="REMARKS" class="java.lang.String"/>
	<field name="TOTAL_VOLUME" class="java.math.BigDecimal"/>
	<field name="TOTAL_WEIGHT" class="java.math.BigDecimal"/>
	<field name="TOTAL_NO_OF_PACKS" class="java.math.BigDecimal"/>
	<field name="UNIT_PACK" class="java.lang.String"/>
	<field name="BL_ISSUE_TYPE" class="java.lang.String"/>
	<field name="PRINT_COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="PRINT_COMPANY_DIVISION_POID" class="java.math.BigDecimal"/>
	<field name="COMPANY_NAME" class="java.lang.String"/>
