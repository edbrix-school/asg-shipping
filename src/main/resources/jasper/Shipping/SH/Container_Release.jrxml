	<queryString>
		<![CDATA[select GET_COMPANY_NAME(HDR.COMPANY_POID)COMPANY,HDR.TRANSACTION_POID,HDR.TRANSACTION_DATE,HDR.VESSAL_AGENT_NAME,
get_address_Name(HDR.SHIPPER_POID)SHIPER,get_address_Name(HDR.CONSIGNEE_POID)CONSIGNEE,
get_address_Name(HDR.NOTIFY_POID_1)NOTIFY1,get_vessel_name(HDR.VESSEL_POID)VESSEL,HDR.VESSEL_ETA_DATE,get_LINE_NAME(HDR.LINE_POID,'Y') LINE,
get_port_name(PORT_OF_LOADING_POID)POL,
get_port_name(PORT_OF_DISCHARGE_POID)POD,
HDR.VOYAGE_NO,HDR.BOOKING_ISSUE_NO,HDR.MATE_LOAD_DATE,HDR.MATE_LOAD_NO
from SHIP_MATE_HDR HDR
where HDR.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
