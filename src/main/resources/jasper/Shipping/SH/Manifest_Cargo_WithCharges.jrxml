	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_FREIGHTCARGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="P_IMPORT_EXPORT" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT MFHDR.TRANSACTION_POID,
      COMPANY_NAME,
      ADDRESS,
      SHIPPER_POID,
      BL_TYPE||' '|| DECODE($P{P_FREIGHTCARGO},'TRUE','FREIGHT MANIFEST','CARGO MANIFEST') BL_TYPE,
      BL_TYPE IMPORT_EXPORT,
      nvl(SHIPPER_EDI_NAME,GET_ADDRESS_NAME(SHIPPER_POID))||chr(10)||chr(13) ||
      nvl(SHIPPER_EDI_ADDRESS,GET_ADDRESS_DETAILS_WITH_TYPE(SHIPPER_ADDRESS_POID,NULL)) SHIPPER_ADDRESS,
      CONSIGNEE_POID,
      nvl(CONSIGNEE_EDI_NAME,GET_ADDRESS_NAME(CONSIGNEE_POID)) ||chr(10)||chr(13) ||
      nvl(CONSIGNEE_EDI_ADDRESS,GET_ADDRESS_DETAILS_WITH_TYPE(CONSIGNEE_ADDRESS_POID,NULL)) CONSIGNEE_ADDRESS ,
      NOTIFY_POID_1
      NOTIFY_POID_2,
      GET_ADDRESS_NAME(NOTIFY_POID_2) NOTIFY2,
      nvl(NOTIFY1_EDI_NAME,GET_ADDRESS_NAME(NOTIFY_POID_1))  ||
      nvl(NOTIFY1_EDI_ADDRESS,chr(10)||chr(13)||GET_ADDRESS_DETAILS_WITH_TYPE(NOTIFY_ADDRESS_POID_1,'')) NOTIFY_ADDRESS1 ,
      BL_NUMBER,
      PLACE_OF_DELIEVERY_POID,
      nvl(BL_FINAL_DESTINATION,GET_PORT_NAME(PLACE_OF_DELIEVERY_POID)) PLACE_OF_DELIEVERY,
      PORT_OF_LOADING_POID,
      nvl(BL_PLACE_LOAD,GET_PORT_NAME(PORT_OF_LOADING_POID)) PORT_OF_LOADING,
      PORT_OF_DISCHARGE_POID,
      nvl(BL_PLACE_DISCHARE_DESC,nvl(BL_PLACE_RECEIPT,GET_PORT_NAME(PORT_OF_DISCHARGE_POID))) PORT_OF_DISCHARGE,
      TYPE_OF_MOVE,
      VOYAGE.VOYAGE_NO,
      TO_CHAR(VOYAGE.ARRIVAL_DATE,'DD-MON-YYYY') ARRIVAL_DATE,
      TO_CHAR(VOYAGE.SAIL_DATE,'DD-MON-YYYY') SAIL_DATE,
      TO_CHAR(VOYAGE.EXPECTED_DEPARTURE_DATE,'DD-MON-YYYY') EXPECTED_DEPARTURE_DATE,
      TO_CHAR(VOYAGE.EXPECTED_DATE,'DD-MON-YYYY') EXPECTED_DATE,
      VMAST.VESSEL_CODE,
       VMAST.VESSEL_NAME,
      LNMAST.LINE_CODE,
      LNMAST.LINE_NAME,
BL_PLACE_LOAD,
BL_PLACE_RECEIPT,
BL_FINAL_DESTINATION,
NOTIFY1_EDI_NAME, MFHDR.remarks
 FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_VOYAGE_HDR VOYAGE   ON VOYAGE.TRANSACTION_POID=MFHDR.VOYAGE_TRANSACTION_POID
INNER JOIN SHIP_VESSEL_MASTER VMAST ON VOYAGE.VESSEL_POID =VMAST.VESSEL_POID
INNER JOIN SHIP_LINE_MASTER LNMAST  ON LNMAST.LINE_POID  =VOYAGE.LINE_POID
LEFT JOIN SHIP_BL_MANIFEST_CHARGES_DTL MCHARGE ON MCHARGE.TRANSACTION_POID = MFHDR.TRANSACTION_POID
LEFT JOIN SHIP_COMODITY_MASTER CMAST ON CMAST.COMODITY_POID = MFHDR.COMODITY_POID
INNER JOIN GLOBAL_COMPANY_MASTER COMP ON MFHDR.COMPANY_POID= COMP.COMPANY_POID
WHERE NVL(MFHDR.deleted,'N')='N' and  ((MFHDR.TRANSACTION_POID= TO_NUMBER($P{DOC_KEY_POID})
AND   'X'=NVL($P{P_IMPORT_EXPORT},'X')
)
 or (VOYAGE.TRANSACTION_POID = TO_NUMBER($P{DOC_KEY_POID}) AND    DECODE(bl_type,'EXPORT','EXPORT','IMPORT') = $P{P_IMPORT_EXPORT} ))
order by bl_type,bl_number]]>
	</queryString>
