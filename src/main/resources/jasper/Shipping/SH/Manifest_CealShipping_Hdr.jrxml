	<subDataset name="ContainerDetail" uuid="d94c4bcc-7cbd-4368-8e39-261e577bc428">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<parameter name="ROW_COUNT" class="java.lang.String"/>
		<queryString>
			<![CDATA[select CONTAINER_NO,EQUIPMENT_SEAL_NO,CONTAINER_TYPE_SIZE from(
SELECT  distinct CONTAINER_NO||' '||CONTAINER_TYPE_CODE as CONTAINER_NO,EQUIPMENT_SEAL_NO,CONTAINER_TYPE_SIZE,
(SELECT  count(CONTAINER_NO)
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CNTDTL ON MFHDR.TRANSACTION_POID =CNTDTL.TRANSACTION_POID
inner join ship_container_type_master type
on EQUIPMENT_ISO_TYPE = CONTAINER_TYPE_CODE
WHERE MFHDR.TRANSACTION_POID = $P{DOC_KEY_POID})  Container_count
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CNTDTL ON MFHDR.TRANSACTION_POID =CNTDTL.TRANSACTION_POID
inner join ship_container_type_master type
on EQUIPMENT_ISO_TYPE = CONTAINER_TYPE_CODE
WHERE MFHDR.TRANSACTION_POID = $P{DOC_KEY_POID})
where Container_count = 1]]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="EQUIPMENT_SEAL_NO" class="java.lang.String"/>
		<field name="CONTAINER_TYPE_SIZE" class="java.lang.String"/>
	</subDataset>
	<subDataset name="MarkDetail" uuid="b813770b-8f15-4c39-a801-91691b203134">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<parameter name="ROW_COUNT" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT  CARGODTL.CARGO_DESCRIPTION
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL   ON MFHDR.TRANSACTION_POID =CARGODTL.TRANSACTION_POID
WHERE DESCRIPTION_TYPE='MARK' AND
MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID} AND rownum <= $P{ROW_COUNT} - (SELECT  count(CONTAINER_NO) container_count
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CNTDTL ON MFHDR.TRANSACTION_POID =CNTDTL.TRANSACTION_POID
WHERE MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID})]]>
		</queryString>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="CargoDetail" uuid="d491eb8a-8751-4227-9432-44d62f319eae">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<parameter name="ROW_COUNT" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT NVL(RECORD_ORDER,DET_ROW_ID) SEQNO, CARGODTL.CARGO_DESCRIPTION
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL   ON MFHDR.TRANSACTION_POID =CARGODTL.TRANSACTION_POID
WHERE DESCRIPTION_TYPE='CARGO'
AND  MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID} AND ROWNUM <= $P{ROW_COUNT}
ORDER BY NVL(RECORD_ORDER,DET_ROW_ID)]]>
		</queryString>
		<field name="SEQNO" class="java.math.BigDecimal"/>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="FreightDetail" uuid="b66deb5a-2dcd-4532-89ee-c1335783282e">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[select DISTINCT 'FREIGHT'||' '||decode(FREIGHT_TYPE,'P','PREPAID','C','TO COLLECT','E','ELSE WHERE','OTHERS') freight_type   from SHIP_BL_MANIFEST_CHARGES_DTL WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
		</queryString>
		<field name="FREIGHT_TYPE" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT MFHDR.TRANSACTION_POID,
       SHIPPER_POID,
      NVL(SHIPPER_EDI_NAME,GET_ADDRESS_NAME(SHIPPER_POID)) SHIPPER,
      nvl(SHIPPER_EDI_ADDRESS,GET_ADDRESS_DETAILS_WITH_TYPE(SHIPPER_ADDRESS_POID,NULL)) SHIPPER_ADDRESS,
      CONSIGNEE_POID,
      CONSIGNEE_EDI_NAME CONSIGNEE,
      CONSIGNEE_EDI_ADDRESS CONSIGNEE_ADDRESS ,
      NOTIFY_POID_1,
      NOTIFY1_EDI_NAME NOTIFY1,
      NOTIFY1_EDI_ADDRESS NOTIFY_ADDRESS1,
	  NOTIFY2_EDI_NAME,
      NOTIFY2_EDI_ADDRESS,
      BL_NUMBER,
      to_char(DATE_OF_ISSUE,'DD-MON-YYYY') DATE_OF_ISSUE,
         DECODE(GET_PORT_NAME(PLACE_OF_ISSUE_POID),'KHALIFA BIN SALMAN PORT, BAHRAIN','BAHRAIN',GET_PORT_NAME(PLACE_OF_ISSUE_POID)) PLACE_OF_ISSUE,
      LAST_TRANSSHIP_PORT_POID,
      GET_PORT_NAME(LAST_TRANSSHIP_PORT_POID) LAST_TRANSSHIP_PORT,
      PLACE_OF_RECIEPT_POID,
      GET_PORT_NAME(PLACE_OF_RECIEPT_POID) PLACE_OF_RECIEPT,
      PLACE_OF_DELIEVERY_POID,
      GET_PORT_NAME(PLACE_OF_DELIEVERY_POID) PLACE_OF_DELIEVERY,
      PORT_OF_LOADING_POID,
      GET_PORT_NAME(PORT_OF_LOADING_POID) PORT_OF_LOADING,
      PORT_OF_DISCHARGE_POID,
      GET_PORT_NAME(PORT_OF_DISCHARGE_POID) PORT_OF_DISCHARGE,
      NO_OF_ORGNL_BLS,
      TYPE_OF_MOVE,
      VOYAGE.VOYAGE_NO,
      VMAST.VESSEL_name,
      AGENT_REFERENCE,
decode(TOTAL_WEIGHT,null,null,0,null,to_char(TOTAL_WEIGHT,'9999999.999')) GRS_WEIGHT,decode(TOTAL_NET_VOLUME,null,null,0,null,to_char(TOTAL_NET_VOLUME,'9999999.999')) NEW_VOLUMN,
MFHDR.BL_PLACE_RECEIPT,
MFHDR.BL_PLACE_LOAD,
MFHDR.BL_FINAL_DESTINATION,
BL_REMARKS_COUNT,
 DECODE(GET_PORT_NAME(MCHARGE.PAID_AT_PORT_POID),'KHALIFA BIN SALMAN PORT, BAHRAIN','BAHRAIN',GET_PORT_NAME(MCHARGE.PAID_AT_PORT_POID)) PAID_AT_PORT_POID,
      MCHARGE.PAID_AT_PORT_POID PAID_AT_PORT_POID,
decode(freight_status,1,'FREIGHT PREPAID',2,'FREIGHT COLLECT',3,'ELSE WHERE','OTHER') freight_status,
'('||nvl(WEIGHT_UNIT,'KGS')||')' WEIGHT_UNIT,BL_ORGINAL_PRINT
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_VOYAGE_HDR VOYAGE   ON VOYAGE.TRANSACTION_POID=MFHDR.VOYAGE_TRANSACTION_POID
INNER JOIN SHIP_VESSEL_MASTER VMAST ON VOYAGE.VESSEL_POID =VMAST.VESSEL_POID
INNER JOIN SHIP_BL_MANIFEST_CHARGES_DTL MCHARGE ON MCHARGE.TRANSACTION_POID = MFHDR.TRANSACTION_POID
INNER JOIN SHIP_LINE_MASTER LNMAST  ON LNMAST.LINE_POID  =VOYAGE.LINE_POID
WHERE MFHDR.TRANSACTION_POID= $P{DOC_KEY_POID} and
decode(freight_status,1,'P',2,'C',3,'E') = MCHARGE.freight_type]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="SHIPPER_POID" class="java.math.BigDecimal"/>
	<field name="SHIPPER" class="java.lang.String"/>
	<field name="SHIPPER_ADDRESS" class="java.lang.String"/>
	<field name="CONSIGNEE_POID" class="java.math.BigDecimal"/>
