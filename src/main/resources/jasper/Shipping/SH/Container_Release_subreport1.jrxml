	<parameter name="P_TRAN_POID" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select DTL.TRANSACTION_POID,BOOKING_ISSUE_NO,nvl(SHIPPER_DETAILS_MANUALLY,GET_CUST_ADDRESS(SHIPPER_POID)) shipper,GET_PORT_CODE(PORT_OF_LOADING_POID) POL, GET_PORT_CODE(PORT_OF_DISCHARGE_POID) POD, FINAL_DESTINATION "F.DEST",CARGO_DESCRIPTION, DTL.EQUIPMENT_ISO_TYPE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'SIZE'  ) CSIZE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'TYPE_ISO_NAME'  ) CTYPE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'APMT_TYPE'  ) APMT_CODE,DTL.QUANTITY,
 DTL.WEIGHT, IMO,OOG_B,OOG_L_W, OOG_R_W,OOG_L,OOG_H, OOG_F, OOG_A,REFFER_TEMP, REFFER_HUM, REFFER_VENT
from SHIP_MATE_hdr SMHDR ,SHIP_MATE_CARGO_DTL DTL
where  SMHDR.transaction_poid=dtl.transaction_poid
AND DTL.TRANSACTION_POID=$P{P_TRAN_POID}]]>
	</queryString>
