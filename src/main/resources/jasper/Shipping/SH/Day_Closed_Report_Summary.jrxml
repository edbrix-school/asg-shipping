<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Day_Closed_Report_Summary" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6655d36d-ee2a-42b1-afa4-db5d5b91d0ac">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_START_DATE" class="java.lang.String"/>
	<parameter name="P_END_DATE" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT  MAX(TRANSACTION_DATE)TRANSACTION_DATE,GET_COMPANY_CODE( (COMPANY_POID))||line COMPANY ,SUM(CASH_AMOUNT)CASH_AMOUNT,SUM(CHQ_AMOUNT) CHQ_AMOUNT, SUM(IMCOCASH) IMCO_CASH_AMOUNT,SUM(IMCOCHEQUE) IMCO_CHQ_AMOUNT,
SUM(NOOFCHQ)NOOFCHQ,NVL(SUM(CASH_AMOUNT),0)+NVL(SUM(CHQ_AMOUNT),0)+NVL(SUM(IMCOCASH),0)+NVL(SUM(IMCOCHEQUE),0) TOTAL FROM (
        SELECT SUM(PY.AMOUNT) CASH_AMOUNT,0 CHQ_AMOUNT,0 NOOFCHQ ,RC.TRANSACTION_DATE,RC.COMPANY_POID,0 IMCOCASH,0 IMCOCHEQUE,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS') LINE
        FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID AND TRUNC(RC.TRANSACTION_DATE) between $P{P_START_DATE} and $P{P_END_DATE}
                  AND PY.PYMT_TYPE='CASH' AND NVL(RC.DELETED,'N')='N'
GROUP BY RC.TRANSACTION_DATE,RC.COMPANY_POID,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS')
                  UNION
                SELECT 0,SUM(PY.AMOUNT)CHQ_AMOUNT,COUNT(CHQ_CARDNO)NOOFCHQ,RC.TRANSACTION_DATE,RC.COMPANY_POID,0 IMCOCASH,0 IMCOCHEQUE,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS') LINE
                FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID AND NVL(RC.DELETED,'N')='N'
                      AND PY.PYMT_TYPE='CHEQUE' AND TRUNC(RC.TRANSACTION_DATE) between $P{P_START_DATE} and $P{P_END_DATE}
 GROUP BY RC.TRANSACTION_DATE,RC.COMPANY_POID,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS')
  UNION
               SELECT 0 CASH_AMOUNT,0 CHQ_AMOUNT,0 NOOFCHQ ,RC.TRANSACTION_DATE,RC.COMPANY_POID,SUM(PY.AMOUNT) IMCOCASH,0 IMCOCHEQUE,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS') LINE
               FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID AND NVL(RC.DELETED,'N')='N'
                      AND TRUNC(RC.TRANSACTION_DATE)between $P{P_START_DATE} and $P{P_END_DATE}
                  AND PY.PYMT_TYPE='IMCOCASH'
GROUP BY RC.TRANSACTION_DATE,RC.COMPANY_POID,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS')
  UNION
                SELECT 0,0 CHQ_AMOUNT,COUNT(CHQ_CARDNO)NOOFCHQ,RC.TRANSACTION_DATE,RC.COMPANY_POID,0 IMCOCASH,SUM(PY.AMOUNT) IMCOCHEQUE,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS') LINE
                FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID  AND NVL(RC.DELETED,'N')='N'
                      AND PY.PYMT_TYPE='IMCOCHEQUE' AND to_date(TRUNC(RC.TRANSACTION_DATE)) between $P{P_START_DATE} and $P{P_END_DATE}
 GROUP BY RC.TRANSACTION_DATE,RC.COMPANY_POID,DECODE(GET_LINE_CODE(GET_LINE_POID_FROM_BL(BL_POID)),'MSC','MSC','OTHERS')
                  )
GROUP BY line,GET_COMPANY_CODE( (COMPANY_POID))
order by GET_COMPANY_CODE( (COMPANY_POID))]]>
	</queryString>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="COMPANY" class="java.lang.String"/>
	<field name="CASH_AMOUNT" class="java.math.BigDecimal"/>
	<field name="CHQ_AMOUNT" class="java.math.BigDecimal"/>
	<field name="IMCO_CASH_AMOUNT" class="java.math.BigDecimal"/>
	<field name="IMCO_CHQ_AMOUNT" class="java.math.BigDecimal"/>
	<field name="NOOFCHQ" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="sum_cash" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{CASH_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="sum_cheque" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{CHQ_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="sum_imco_cash" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{IMCO_CASH_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="sum_imco_cheque" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{IMCO_CHQ_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="total_summary_amount" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
	</variable>
