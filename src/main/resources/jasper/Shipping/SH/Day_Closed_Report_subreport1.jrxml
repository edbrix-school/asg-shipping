	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="FROM_DATE" class="java.lang.String"/>
	<parameter name="TO_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT COMPANY_POID,CASH,CHEQUE,SPLIT,IMCOCASH,IMCOCHEQUE,ROUNDOFF FROM (
           select company_poid,rcpt_type,sum(AMOUNT) AMOUNT from (
           select hdr.TRANSACTION_POID,hdr.company_poid,
           case when PYMT_TYPE = 'CHEQUE' and CHQ_CARDNO is not null
           then 'CHEQUE'
           when PYMT_TYPE = 'SPLIT' and (AMOUNT is not null or AMOUNT != 0)
            then 'SPLIT'
            when PYMT_TYPE = 'CASH' and (AMOUNT is not null or AMOUNT != 0)
            then 'CASH'
            when PYMT_TYPE = 'IMCOCASH' and (AMOUNT is not null or AMOUNT != 0)
            then 'IMCOCASH'
            when PYMT_TYPE = 'IMCOCHEQUE' and  CHQ_CARDNO is not null
            then 'IMCOCHEQUE'
             when PYMT_TYPE = 'ROUNDOFF' and (AMOUNT is not null or AMOUNT != 0)
            then 'ROUNDOFF'
           end rcpt_type,
          AMOUNT from
           AR_SH_RECEIPT_HDR hdr
           inner join ar_sh_receipt_pymt_details paydtl  on paydtl.TRANSACTION_POID = hdr.TRANSACTION_POID
           where to_date(TRUNC(hdr.TRANSACTION_DATE)) BETWEEN $P{FROM_DATE} AND  $P{TO_DATE}
           and NVL(hdr.DELETED,'N') = 'N'  and hdr.bl_poid is not null and hdr.company_poid =$P{LOGIN_COMP_POID}
           order by hdr.company_poid)
           where rcpt_type is not null
           group by rcpt_type,company_poid
           order by company_poid )
           PIVOT ( SUM(AMOUNT) FOR (rcpt_type) IN ('CASH' AS CASH, 'CHEQUE' AS CHEQUE, 'SPLIT' AS SPLIT,'IMCOCASH' as IMCOCASH,'IMCOCHEQUE' as IMCOCHEQUE,'ROUNDOFF' as ROUNDOFF))
           ORDER BY company_poid]]>
	</queryString>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="CASH" class="java.math.BigDecimal"/>
	<field name="CHEQUE" class="java.math.BigDecimal"/>
	<field name="SPLIT" class="java.math.BigDecimal"/>
	<field name="IMCOCASH" class="java.math.BigDecimal"/>
	<field name="IMCOCHEQUE" class="java.math.BigDecimal"/>
	<field name="ROUNDOFF" class="java.math.BigDecimal"/>
	<variable name="Company_filter" class="java.lang.String">
		<variableExpression><![CDATA[$P{LOGIN_COMP_POID} == "ALL" ? "%" : $P{LOGIN_COMP_POID}]]></variableExpression>
		<initialValueExpression><![CDATA[$P{LOGIN_COMP_POID} == "ALL" ? "%" : $P{LOGIN_COMP_POID}]]></initialValueExpression>
	</variable>
