    <queryString>
        <![CDATA[select GET_COMPANY_NAME(HDR.COMPANY_POID)COMPANY,HDR.TRANSACTION_POID,HDR.TRANSACTION_DATE,HDR.VESSAL_AGENT_NAME,
nvl(SHIPPER_DETAILS_MANUALLY,GET_CUST_ADDRESS(SHIPPER_POID)) SHIPER,get_address_Name(HDR.CONSIGNEE_POID)CONSIGNEE,
get_address_Name(HDR.NOTIFY_POID_1)NOTIFY1,get_vessel_name(HDR.VESSEL_POID)VESSEL,HDR.VESSEL_ETA_DATE,get_LINE_NAME(HDR.LINE_POID,'Y')LINE,
get_port_name(PORT_OF_LOADING_POID)POL,
get_port_name(PORT_OF_DISCHARGE_POID)POD,
HDR.VOYAGE_NO,HDR.BOOKING_ISSUE_NO,HDR.MATE_LOAD_DATE,HDR.MATE_LOAD_NO,container_no,
RTN_GLOBAL_PARAMETER(1, 'GLOBAL_COMPANY_STAMP', 'STAMP', HDR.COMPANY_POID, NULL) STAMP_DISPLAY
from SHIP_MATE_HDR HDR
inner join SHIP_MATE_CONTAINER_DTL mcntdtl on HDR.TRANSACTION_POID=mcntdtl.TRANSACTION_POID
 where  HDR.TRANSACTION_POID=$P{DOC_KEY_POID} AND
 (MCNTDTL.CONTAINER_NO IN ($P{P_CONTAINERNO}) OR $P{P_CONTAINERNO} IS NULL ) ]]>
    </queryString>
    <field name="COMPANY" class="java.lang.String"/>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
    <field name="VESSAL_AGENT_NAME" class="java.lang.String"/>
    <field name="SHIPER" class="java.lang.String"/>
    <field name="CONSIGNEE" class="java.lang.String"/>
    <field name="NOTIFY1" class="java.lang.String"/>
