	<subDataset name="Charge_detail" uuid="f4afee65-d43c-44cb-8911-782411d1267f">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
		<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
			<defaultValueExpression><![CDATA[N]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select PRINT_GROUP,PRINT_GROUP_ORDER, sum(Amount) amount,TAX_PERCENTAGE,SUM(TAX_AMOUNT) TAX_AMOUNT,(SUM(AMOUNT)+SUM(NVL(TAX_AMOUNT,0))) TOTAL_AMOUNT,QUANTITY,sum(rate) rate from
(
SELECT  PRINT_GROUP,
DECODE(SUBSTR(PRINT_GROUP,1,5),'Freig',1,'Local',99999,'Termi',99998,2) PRINT_GROUP_ORDER,
nvl(CURRENCY_EXCHANGE,0)*nvl(PER_QUANTITY_AMOUNT,0)*NVL(QUANTITY,1) Amount,decode(TAX_CATEGORY,'V',TO_CHAR(ARCDTL.TAX_PERCENTAGE),'Z','0',TAX_CATEGORY) TAX_PERCENTAGE, (TAX_AMOUNT) TAX_AMOUNT,
NVL(QUANTITY,1) QUANTITY,
nvl(CURRENCY_EXCHANGE,0)*nvl(PER_QUANTITY_AMOUNT,0) rate
  FROM  SHIP_BL_MANIFEST_CHARGES_DTL ARCDTL
inner JOIN SHIP_CHARGE_MASTER CMAST ON CMAST.CHARGE_POID = ARCDTL.CHARGE_POID
left join GLOBAL_TAX_MASTER gtxm on GTXM.TAX_POID=ARCDTL.TAX_POID
WHERE ARCDTL.TRANSACTION_POID =   $P{P_TRANSACTION_POID} and freight_type='P'
AND ARCDTL.TRANSACTION_POID IN(SELECT TRANSACTION_POID FROM SHIP_BL_MANIFEST_HDR WHERE BL_TYPE = 'EXPORT'   AND TRANSACTION_POID=  $P{P_TRANSACTION_POID} )
)
group by  PRINT_GROUP_ORDER,PRINT_GROUP,TAX_PERCENTAGE,QUANTITY   HAVING sum(Amount)<>0
order by  PRINT_GROUP_ORDER]]>
		</queryString>
		<field name="PRINT_GROUP" class="java.lang.String"/>
		<field name="PRINT_GROUP_ORDER" class="java.math.BigDecimal"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="TAX_PERCENTAGE" class="java.lang.String"/>
		<field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
		<field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
		<field name="QUANTITY" class="java.math.BigDecimal"/>
		<field name="RATE" class="java.math.BigDecimal"/>
		<variable name="Sum_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
		</variable>
		<variable name="Total_text" class="java.lang.String">
			<variableExpression><![CDATA["Total amount(BD)   :"]]></variableExpression>
		</variable>
		<variable name="Total_received" class="java.lang.String">
			<variableExpression><![CDATA["Amount Received(BD):"]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="container_type" uuid="21ab848d-ba71-4861-950d-e3d3ff8f37dd">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT TRANSACTION_POID,DESCRIPTION FROM   TABLE(func_ship_pivot_any_data($P{DOC_KEY_POID_CNT},'CNTTYPE',NULL)) SHIP_BL_CONTAINER_TYPE
WHERE TRANSACTION_POID= $P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="AmountInWord" uuid="94d09520-f163-4835-adc6-7bcd4e91d602">
		<parameter name="Amount" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct 'Bahraini Dinar '||FN_AMOUNT_IN_WORDS_COMMON($P{Amount},'BHD') AMOUNT_IN_WORD from dual]]>
		</queryString>
		<field name="AMOUNT_IN_WORD" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
