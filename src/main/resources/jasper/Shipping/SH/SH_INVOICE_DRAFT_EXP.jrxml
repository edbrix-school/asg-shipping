		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_BL_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DETAIL_SHOW_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA["Y"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT BHDR.TRANSACTION_POID,BHDR.BL_number,'DRAFT'  DOC_REF,to_char(BHDR.TRANSACTION_DATE,invoice_date_format) TRANSACTION_DATE,LMAST.LINE_code||'/'||VESSEL_name||'/'||VOYAGE_NO LINE_VESSEL_INFO,
 TO_CHAR(decode(BL_TYPE,'IMPORT',VHDR.ARRIVAL_DATE,VHDR.SAIL_DATE,nvl(invoice_date_format,'DD-MON-RRRR')),nvl(invoice_date_format,'DD-MON-RRRR')) ARRIVAL_SAIL_DATE, PMAST.PORT_NAME,
  nvl(FN_FOR_CUSTOMER_ADDRESS('000-000',BHDR.BOOKING_PARTY_POID,'CUSTOMER'),FN_FOR_CUSTOMER_ADDRESS('000-000',BHDR.BOOKING_PARTY_POID,'PRINCIPAL'))  DETAILS_ADDRESS,
upper(COMPANY_NAME) COMPANY_NAME,(SELECT SUM(nvl(CURRENCY_EXCHANGE,0)*nvl(PER_QUANTITY_AMOUNT,0)*NVL(QUANTITY,1)) FROM  SHIP_BL_MANIFEST_CHARGES_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=BHDR.TRANSACTION_POID  AND FREIGHT_TYPE='P') TOTAL_CHARGE_AMOUNT,
(SELECT SUM(TAX_AMOUNT) FROM  SHIP_BL_MANIFEST_CHARGES_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=BHDR.TRANSACTION_POID AND FREIGHT_TYPE='P' ) TOTAL_TAX_AMOUNT,
(SELECT SUM(nvl(CURRENCY_EXCHANGE,0)*nvl(PER_QUANTITY_AMOUNT,0)*NVL(QUANTITY,1))+SUM(NVL(TAX_AMOUNT,0)) FROM  SHIP_BL_MANIFEST_CHARGES_DTL CHGDTL
WHERE CHGDTL.TRANSACTION_POID=BHDR.TRANSACTION_POID AND FREIGHT_TYPE='P') TOTAL_AMOUNT,
nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1)) COMPANY_POID,
nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1)) COMPANY_DIVISION_POID,
' BD:'|| FN_AMOUNT_IN_WORDS_common(0,'BHD') AMOUNT_IN_WORDS
, GET_PORT_NAME(BHDR.PORT_OF_LOADING_POID) LOAD_PORT, GET_PORT_NAME(BHDR.PORT_OF_DISCHARGE_POID) DISCHARGE_PORT,GET_PORT_NAME(BHDR.PLACE_OF_DELIEVERY_POID) DELIVERY_PORT,
BL_TYPE,nvl(OFF_TEL1,MOBILE) OFFICE_TEL,PO_BOX,upper(AREA_CITY) area,upper(STATE) STATE,decode(trim(upper(AREA_CITY)),'MANAMA','KINGDOM OF BAHRAIN',GET_COUNTRY_NAME(ADRHDRMST.COUNTRY_POID)) country,MOBILE,EMAIL1 EMAIL,BLDG BUILDING,division_name,BHDR.LPO_SRN_NO LPO_NO,TO_CHAR(BHDR.LPO_SRN_DATE,nvl(invoice_date_format,'DD-MON-RRRR')) LPO_DATE,TO_CHAR(BHDR.TRANSACTION_DATE,nvl(nvl(invoice_date_format,'DD-MON-RRRR'),'DD-MON-RRRR'))  INV_DATE,
to_char(nvl(BHDR.TRANSACTION_DATE,BHDR.TRANSACTION_DATE + nvl(ADHDR.CREDIT_PERIOD,0)),nvl(invoice_date_format,'DD-MON-RRRR')) DUE_DATE,
PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID,
DECODE(BANK_DETAILS_CMP_MASTER,'NO','A/C Payee Cheque In Favor of '||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'   '||COMPANY_NAME,'Beneficiary Name :-'||COMPANY_NAME||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'Bank Name :-'||GBM.BANK_ADDRESS||CHR(13)||CHR(10)||CHR(13)||CHR(10)||'Account Number :-'||GBM.BANK_ACCOUNT_NO||CHR(13)||CHR(10)||'Swift Code :-'||GBM.SWIFT_CODE||CHR(13)||CHR(10)||'IBAN Number :-'||GBM.IBAN
) PAYMENT_DETAILS ,DECODE(SUBSTR(BHDR.DOC_REF,4,5),'IHIMP',0,1) CREDIT_INVOICE,
decode(nvl(ADHDR.TIN_NUMBER,PDHDR.TIN_NUMBER),null,null,'VAT number: '||nvl(ADHDR.TIN_NUMBER,PDHDR.TIN_NUMBER)) TIN_NUMBER,
decode(COMMAST.TIN_NUMBER ,null,null,'Our VAT number :  '||COMMAST.TIN_NUMBER ) Company_TIN_NUMBER,
decode(sign(to_date(BHDR.TRANSACTION_DATE)-to_date(VAT_REGISTRATION_DATE)),'-1',' ',decode(COMMAST.TIN_NUMBER ,null,' ','TAX' )) Company_TAX,
  NULL CC_REF
FROM  SHIP_BL_MANIFEST_HDR BHDR
inner JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
inner JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
inner JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
left JOIN SALES_CUSTOMER_MASTER ADHDR ON BHDR.BOOKING_PARTY_POID=ADHDR.CUSTOMER_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER PDHDR ON BHDR.BOOKING_PARTY_POID=PDHDR.PRINCIPAL_POID and 1=2
LEFT JOIN GLOBAL_ADDRESS_MASTER ADRHDRMST ON (ADHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRHDRMST.ADDRESS_MASTER_POID)
left JOIN GLOBAL_ADDRESS_DETAILS ADRDTL ON (ADHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID OR PDHDR.ADDRESS_POID=ADRDTL.ADDRESS_MASTER_POID) and TRIM(ADRDTL.ADDRESS_TYPE) ='MAIN'
LEFT JOIN SHIP_PORT_MASTER PMAST ON PMAST.PORT_POID = decode(BL_TYPE,'IMPORT',BHDR.PORT_OF_LOADING_POID,nvl(PLACE_OF_DELIEVERY_POID,PORT_OF_DISCHARGE_POID))
inner JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.COMPANY_POID,1))
inner join global_division_master divmast on divmast.DIVISION_POID = nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1))
INNER JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID=COMMAST.BANK_POID
WHERE  BHDR.TRANSACTION_POID =  $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
