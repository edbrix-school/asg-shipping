	<subDataset name="Bill_details" uuid="8e5e9981-e064-4747-86e3-9cb131930845">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String"/>
		<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
		<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>

		<queryString>
			<![CDATA[SELECT BHDR.BL_number,HDR.doc_ref SPLIT_RECEIPT,LMAST.LINE_code,VESSEL_name||'/'||VOYAGE_NO voy_VESSEL_INFO,
(SELECT SUM(AMOUNT) FROM  AR_SH_RECEIPT_CHARGES_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=ARBDTL.SPLIT_TRANSACTION_POID AND CHGDTL.BL_POID=HDR.BL_POID) TOTAL_CHARGE_AMOUNT
FROM AR_SH_RECEIPT_HDR HDR
INNER JOIN AR_SH_RECEIPT_SPLIT_DTL ARBDTL ON HDR.TRANSACTION_POID = ARBDTL.SPLIT_TRANSACTION_POID
INNER JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
INNER JOIN SHIP_VOYAGE_HDR   VHDR ON VHDR.TRANSACTION_POID=BHDR.VOYAGE_TRANSACTION_POID
INNER JOIN SHIP_LINE_MASTER LMAST ON LMAST.LINE_POID = VHDR.LINE_POID
INNER JOIN SHIP_VESSEL_MASTER VMAST ON VMAST.VESSEL_POID = VHDR.VESSEL_POID
INNER JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = nvl(BHDR.DOCUMENT_COMPANY_POID,nvl(BHDR.DOCUMENT_COMPANY_DIVISION_POID,1))
WHERE ARBDTL.TRANSACTION_POID IN (SELECT  TRANSACTION_POID FROM AR_SH_RECEIPT_HDR  WHERE TRANSACTION_POID =$P{P_TRANSACTION_POID})]]>
		</queryString>
		<field name="BL_NUMBER" class="java.lang.String"/>
		<field name="SPLIT_RECEIPT" class="java.lang.String"/>
		<field name="LINE_CODE" class="java.lang.String"/>
		<field name="VOY_VESSEL_INFO" class="java.lang.String"/>
		<field name="TOTAL_CHARGE_AMOUNT" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Payment_detail" uuid="1252a295-71bb-4626-8101-bd68d54e442c">
		<parameter name="P_TRANSACTION_POID" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT DECODE(TRIM(PYMT_TYPE),'CHEQUE',' '||'CHQ:'||BANK_CODE||' '||CHQ_CARDNO||' '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CASH',
' '||'CASH BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),'CARD',' '||'CARD:'||BANK_CODE||' '||CHQ_CARDNO||' '||to_char(CHQ_DATE,'DD-MON-YYYY')||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999')),TRIM(PYMT_TYPE)||' BD:'||TRIM(TO_CHAR(AMOUNT,'999,999,999,999.999'))) CASH_CHEQUE
FROM  AR_SH_RECEIPT_PYMT_DETAILS ARPAYDTL
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BANKMAS ON BANKMAS.BANK_POID = ARPAYDTL.BANK_POID
WHERE ARPAYDTL.TRANSACTION_POID = $P{P_TRANSACTION_POID} AND( NVL(AMOUNT,0) > 0)]]>
		</queryString>
		<field name="CASH_CHEQUE" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT HDR.TRANSACTION_POID,HDR.DOC_REF,to_char(HDR.TRANSACTION_DATE,'DD-MON-YYYY')TRANSACTION_DATE,'For'||' '||COMPANY_NAME COMPANY_NAME,
(SELECT SUM(SPLIT_RCPT_AMOUNT) FROM  AR_SH_RECEIPT_SPLIT_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID) TOTAL_CHARGE_AMOUNT,
HDR.COMPANY_POID,'BD:'||(select FN_AMOUNT_IN_WORDS_common((SELECT SUM(SPLIT_RCPT_AMOUNT) FROM  AR_SH_RECEIPT_SPLIT_DTL CHGDTL WHERE CHGDTL.TRANSACTION_POID=HDR.TRANSACTION_POID) ,'BHD') from dual) AMT_IN_WORDS
FROM AR_SH_RECEIPT_HDR HDR
INNER JOIN AR_SH_RECEIPT_SPLIT_DTL ARBDTL ON HDR.TRANSACTION_POID = ARBDTL.TRANSACTION_POID
INNER JOIN GLOBAL_COMPANY_MASTER COMMAST ON COMMAST.COMPANY_POID = HDR.COMPANY_POID
AND RCPT_TYPE='FINALSPLITSRECEIPT'
WHERE HDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.lang.String"/>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<field name="TOTAL_CHARGE_AMOUNT" class="java.math.BigDecimal"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="AMT_IN_WORDS" class="java.lang.String"/>
