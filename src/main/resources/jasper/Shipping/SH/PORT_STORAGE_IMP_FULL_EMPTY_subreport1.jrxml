<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PORT_STORAGE_IMP_FULL_EMPTY_subreport1" language="groovy" pageWidth="802" pageHeight="555" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="49bd9007-a0e8-4fba-be28-b6d1859079ad">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_TILL_EDATE" class="java.lang.String"/>
	<parameter name="DOC_KEY_EPOID" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct LINE,VOYAGE_NO,ARRIVAL_DATE ETA,CONTAINER_NO,BL_NUMBER,ISO_CODE,
RETURN_FROM_CONSIGNEE EMPTIED_ON,Storage Storage_days ,FREE_DAYS,
case when ((to_date($P{P_TILL_EDATE}) - to_date(RETURN_FROM_CONSIGNEE)) + 1) > FREE_DAYS then round((((to_date($P{P_TILL_EDATE}) - to_date(RETURN_FROM_CONSIGNEE)) + 1) - FREE_DAYS)) end  paid_days,total_charges from(
select distinct condtl.CONTAINER_NO,CONTAINER_TYPE_CODE ISO_CODE
,(SELECT FREE_DAYS
FROM SHIP_PORT_TARIFF_HDR THDR
INNER JOIN SHIP_PORT_TARIFF_DTL TIDTL ON  TIDTL.TRANSACTION_POID=THDR.TRANSACTION_POID
WHERE  TO_DATE($P{P_TILL_EDATE}) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
and TARIFF_TYPE='EMPTY' and CONTAINER_SIZE=TMAST.CONTAINER_TYPE_SIZE) FREE_DAYS,
round((to_date($P{P_TILL_EDATE}) - to_date(condtl.RETURN_FROM_CONSIGNEE))+ 1) Storage,
FUNC_RTN_port_storage
( hdr.GROUP_POID,hdr.company_poid,-999, hdr.transaction_poid,condtl.CONTAINER_NO,
TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid,condtl.RETURN_FROM_CONSIGNEE,TO_DATE($P{P_TILL_EDATE}),'EMPTY') total_charges
,condtl.RETURN_FROM_CONSIGNEE,lmast.line_name LINE,ARRIVAL_DATE,VOYAGE_NO
,CONTAINER_TYPE_SIZE,
BL_NUMBER
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'IMPORT'
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_line_master lmast
on voyhdr.line_poid = lmast.line_poid
WHERE (HDR.TRANSACTION_POID, CONTAINER_NO) IN (select MAINFEST_TRANSACTION_POID, CONTAINER_NO from VW_CONTAINER_MOVES_INVENTORY
where EMPTY_OUT IS NULL AND WITH_CONSIGNEE_FULL IS NOT NULL
AND LOAD_EMPTY IS NULL AND LOAD_FULL IS NULL) AND RETURN_FROM_CONSIGNEE IS NOT NULL
AND hdr.TRANSACTION_POID=$P{DOC_KEY_EPOID}
 )order by LINE]]>
	</queryString>
	<field name="LINE" class="java.lang.String"/>
	<field name="VOYAGE_NO" class="java.lang.String"/>
	<field name="ETA" class="java.sql.Timestamp"/>
	<field name="CONTAINER_NO" class="java.lang.String"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="ISO_CODE" class="java.lang.String"/>
	<field name="EMPTIED_ON" class="java.sql.Timestamp"/>
	<field name="STORAGE_DAYS" class="java.math.BigDecimal"/>
	<field name="FREE_DAYS" class="java.math.BigDecimal"/>
	<field name="PAID_DAYS" class="java.math.BigDecimal"/>
	<field name="TOTAL_CHARGES" class="java.math.BigDecimal"/>
	<group name="LINE">
		<groupExpression><![CDATA[$F{LINE}]]></groupExpression>
	</group>
