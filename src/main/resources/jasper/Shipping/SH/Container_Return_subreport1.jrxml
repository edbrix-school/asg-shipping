<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Container_Return_subreport1" language="groovy" pageWidth="930" pageHeight="555" orientation="Landscape" columnWidth="930" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="2163e634-6360-4059-a312-748b8c222e34">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="73"/>
    <property name="ireport.y" value="0"/>
    <parameter name="P_TRAN_POID" class="java.math.BigDecimal" isForPrompting="false">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="p_trans_container" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="PRINT_STAMP" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[select DTL.TRANSACTION_POID,BOOKING_ISSUE_NO,DTL.CONTAINER_NO,DTL.EQUIPMENT_SEAL_NO,DTL.EQUIPMENT_ISO_TYPE,DTL.EQUIPMENT_TYPE,DTL.EQUIPMENT_SIZE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'SIZE'  ) CSIZE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'TYPE_ISO_NAME'  ) CTYPE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'APMT_TYPE'  ) APMT_CODE,DTL.QUANTITY,
GET_PORT_CODE(PORT_OF_LOADING_POID) POL, GET_PORT_CODE(PORT_OF_DISCHARGE_POID) POD, FINAL_DESTINATION "F.DEST", DTL.GRS_VOLUME,DTL.GRS_WEIGHT,DTL.NET_VOLUME,DTL.NET_WEIGHT,DTL.NO_OF_PACKS,DTL.PACK_UNIT,DTL.DESTINATION_PORT_POID,
DTL.IMO,DTL.OOG_L,DTL.OOG_B,DTL.OOG_H,DTL.REFFER_TEMP,DTL.REFFER_HUM,DTL.REFFER_VENT,DTL.EQUIPMENT_SHIPPER_OWN,
OOG_L_W, OOG_R_W, OOG_F, OOG_A,
RTN_GLOBAL_PARAMETER(1, 'GLOBAL_COMPANY_STAMP', 'STAMP', SMHDR.COMPANY_POID, NULL) STAMP_DISPLAY
from SHIP_MATE_hdr SMHDR ,SHIP_MATE_CONTAINER_DTL DTL
where  SMHDR.transaction_poid=dtl.transaction_poid
AND DTL.TRANSACTION_POID=$P{P_TRAN_POID}
and DTL.container_no=$P{p_trans_container}

union all

select DTL.TRANSACTION_POID,BOOKING_ISSUE_NO,DTL.CONTAINER_NO,DTL.EQUIPMENT_SEAL_NO,DTL.EQUIPMENT_ISO_TYPE,DTL.EQUIPMENT_TYPE,DTL.EQUIPMENT_SIZE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'SIZE'  ) CSIZE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'TYPE_ISO_NAME'  ) CTYPE,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'APMT_TYPE'  ) APMT_CODE,DTL.QUANTITY,
GET_PORT_CODE(PORT_OF_LOADING_POID) POL, GET_PORT_CODE(PORT_OF_DISCHARGE_POID) POD, FINAL_DESTINATION "F.DEST", DTL.GRS_VOLUME,DTL.GRS_WEIGHT,DTL.NET_VOLUME,DTL.NET_WEIGHT,DTL.NO_OF_PACKS,DTL.PACK_UNIT,DTL.DESTINATION_PORT_POID,
DTL.IMO,DTL.OOG_L,DTL.OOG_B,DTL.OOG_H,DTL.REFFER_TEMP,DTL.REFFER_HUM,DTL.REFFER_VENT,DTL.EQUIPMENT_SHIPPER_OWN,
OOG_L_W, OOG_R_W, OOG_F, OOG_A,
RTN_GLOBAL_PARAMETER(1, 'GLOBAL_COMPANY_STAMP', 'STAMP', SMHDR.COMPANY_POID, NULL) STAMP_DISPLAY
from SHIP_MATE_hdr SMHDR ,SHIP_MATE_CONTAINER_DTL DTL
where  SMHDR.transaction_poid=dtl.transaction_poid
AND DTL.TRANSACTION_POID=$P{P_TRAN_POID}
and DTL.container_no is null and $P{p_trans_container} is null]]>
    </queryString>
