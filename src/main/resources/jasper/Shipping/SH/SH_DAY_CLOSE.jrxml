	<subDataset name="imco_cheque" uuid="d099c70d-1fc2-42f0-8e9d-e126f4af0033">
		<parameter name="P_TRN_DT" class="java.util.Date">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT rownum,GET_COMPANY_CODE(nvl(RC.DOCUMENT_CMP_POID,RC.COMPANY_POID)) Phy_COMPANY,GET_COMPANY_CODE(RC.COMPANY_POID)COMPANY,RC.doc_ref, PY.CHQ_CARDNO,PY.CHQ_DATE,GET_CUST_BANK_CODE(PY.BANK_POID) BANK,PY.ACCOUNT_NAME,PY.ACCOUNT_NO,PY.AMOUNT
        FROM AR_SH_RECEIPT_PYMT_DETAILS PY,AR_SH_RECEIPT_HDR RC WHERE
                      PY.TRANSACTION_POID=RC.TRANSACTION_POID
                  AND PY.PYMT_TYPE in('IMCOCHEQUE') AND NVL(PY.AMOUNT,0)<>0
and       TRUNC(RC.TRANSACTION_DATE)=$P{P_TRN_DT}
order by rownum,GET_COMPANY_CODE(nvl(RC.DOCUMENT_CMP_POID,RC.COMPANY_POID)),RC.COMPANY_POID,PY.BANK_POID,RC.doc_ref,PY.CHQ_DATE]]>
		</queryString>
		<field name="ROWNUM" class="java.math.BigDecimal"/>
		<field name="PHY_COMPANY" class="java.lang.String"/>
		<field name="COMPANY" class="java.lang.String"/>
		<field name="DOC_REF" class="java.lang.String"/>
		<field name="CHQ_CARDNO" class="java.lang.String"/>
		<field name="CHQ_DATE" class="java.sql.Timestamp"/>
		<field name="BANK" class="java.lang.String"/>
		<field name="ACCOUNT_NAME" class="java.lang.String"/>
		<field name="ACCOUNT_NO" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SH_DAY_CLOSE_CASH_SUBREPORT_1" class="net.sf.jasperreports.engine.JasperReport"/>
