	<parameter name="SH_DAY_CLOSE_SMRY_SUBREPORT_1" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT TRANSACTION_POID, (TRUNC(TRANSACTION_DATE)) TRANSACTION_DATE,COMPANY_POID,DOC_REF,LOCATION_CODE,CASH_AMOUNT,CHEQUE_AMOUNT,TOTAL_AMOUNT,
     NOOF_CHQS,LOC_REMARKS,VERIFIED_RCVD,MAIN_OFC_REMARKS FROM AR_SH_DAY_END_CLOSE_HDR
 where TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
