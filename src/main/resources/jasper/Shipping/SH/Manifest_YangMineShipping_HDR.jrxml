	<subDataset name="ContainerQuery" uuid="27f714de-aad3-4ea2-b39d-8c5b8f3ff1b4">
		<parameter name="DOC_KEY_POID_CNT" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT  CONTAINER_NO||' '||CONTAINER_TYPE_CODE as CONTAINER_NO,NO_OF_PACKS,PACK_UNIT
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CNTDTL ON MFHDR.TRANSACTION_POID =CNTDTL.TRANSACTION_POID
inner join ship_container_type_master type
on EQUIPMENT_ISO_TYPE = CONTAINER_TYPE_CODE
AND  MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID_CNT}]]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="NO_OF_PACKS" class="java.math.BigDecimal"/>
		<field name="PACK_UNIT" class="java.lang.String"/>
	</subDataset>
	<subDataset name="MarksQuery" uuid="b8b4d455-7d92-4ef1-be18-f07251c48450">
		<parameter name="DOC_KEY_POID_MKS" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT  NVL(RECORD_ORDER,DET_ROW_ID) SEQNO, CARGODTL.CARGO_DESCRIPTION
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL   ON MFHDR.TRANSACTION_POID =CARGODTL.TRANSACTION_POID
WHERE DESCRIPTION_TYPE='MARK'
AND  MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID_MKS}
ORDER BY NVL(RECORD_ORDER,DET_ROW_ID)]]>
		</queryString>
		<field name="SEQNO" class="java.math.BigDecimal"/>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="CargoDescpQuery" uuid="a4212750-3f38-4962-a964-91646b811890">
		<parameter name="DOC_KEY_POID_CHGDESC" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT NVL(RECORD_ORDER,DET_ROW_ID) SEQNO, CARGODTL.CARGO_DESCRIPTION
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL   ON MFHDR.TRANSACTION_POID =CARGODTL.TRANSACTION_POID
WHERE DESCRIPTION_TYPE='CARGO'
AND  MFHDR.TRANSACTION_POID =$P{DOC_KEY_POID_CHGDESC}
AND DET_ROW_ID <=(SELECT NVL(BL_REMARKS_COUNT,100) FROM SHIP_LINE_MASTER WHERE LINE_POID IN (SELECT LINE_POID FROM SHIP_VOYAGE_HDR WHERE TRANSACTION_POID IN (
SELECT VOYAGE_TRANSACTION_POID FROM  SHIP_BL_MANIFEST_HDR WHERE
TRANSACTION_POID=$P{DOC_KEY_POID_CHGDESC})))

ORDER BY NVL(RECORD_ORDER,DET_ROW_ID)]]>
		</queryString>
		<field name="SEQNO" class="java.math.BigDecimal"/>
		<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_LINE_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CHARGE_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DRAFT_ORIGINAL" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
MFHDR.TRANSACTION_POID,
      SHIPPER_POID,
      NVL(SHIPPER_EDI_NAME,GET_ADDRESS_NAME(SHIPPER_POID)) SHIPPER,
      nvl(SHIPPER_EDI_ADDRESS,GET_ADDRESS_DETAILS_WITH_TYPE(SHIPPER_ADDRESS_POID,NULL)) SHIPPER_ADDRESS,
      CONSIGNEE_POID,
      CONSIGNEE_EDI_NAME CONSIGNEE,
      CONSIGNEE_EDI_ADDRESS CONSIGNEE_ADDRESS ,
      NOTIFY_POID_1,
      NOTIFY1_EDI_NAME NOTIFY1,
      NOTIFY1_EDI_ADDRESS NOTIFY_ADDRESS1,
NOTIFY2_EDI_NAME,
NOTIFY2_EDI_ADDRESS,
      BL_PREFIX||BL_NUMBER BL_NUMBER,
      DATE_OF_ISSUE,
      PLACE_OF_ISSUE_POID,
      GET_PORT_NAME(PLACE_OF_ISSUE_POID) PLACE_OF_ISSUE,
      LAST_TRANSSHIP_PORT_POID,
      GET_PORT_NAME(LAST_TRANSSHIP_PORT_POID) LAST_TRANSSHIP_PORT,
      NVL(BL_PLACE_LOAD,GET_PORT_NAME(PORT_OF_LOADING_POID)) PLACE_OF_RECIEPT_POID,
      GET_PORT_NAME(PLACE_OF_RECIEPT_POID) PLACE_OF_RECIEPT,
      PLACE_OF_DELIEVERY_POID,
      NVL(BL_PLACE_RECEIPT,GET_PORT_NAME(PLACE_OF_DELIEVERY_POID)) PLACE_OF_DELIEVERY,
      PORT_OF_LOADING_POID,
      NVL(BL_PLACE_LOAD,GET_PORT_NAME(PORT_OF_LOADING_POID)) PORT_OF_LOADING,
      PORT_OF_DISCHARGE_POID,
      nvl(BL_PLACE_DISCHARE_DESC,GET_PORT_NAME(PORT_OF_DISCHARGE_POID)) PORT_OF_DISCHARGE,
      START_PORT_POID,
      NVL(BL_PLACE_LOAD,GET_PORT_NAME(START_PORT_POID)) START_PORT,
      NO_OF_ORGNL_BLS,
      TYPE_OF_MOVE,
      VOYAGE.VOYAGE_NO,
      VMAST.VESSEL_CODE,
      VMAST.VESSEL_NAME,
      LNMAST.LINE_CODE,
      LNMAST.LINE_NAME,
      AGENT_REFERENCE,
      NULL PAID_AT_PORT_POID,
      PRE_CARRIED_BY,
      EXPORT_REFERENCE,
      SHIPPED_ONBOARD_DATE,TOTAL_WEIGHT GRS_WEIGHT,DECODE(TOTAL_NET_VOLUME,'0',' ',TOTAL_NET_VOLUME) NEW_VOLUMN,BL_ORGINAL_PRINT, MFHDR.REMARKS,decode(freight_status,1,'FREIGHT PREPAID',2,'FREIGHT COLLECT',3,'ELSE WHERE','OTHER') FREIGHT_TYPE,TOTAL_NET_WEIGHT
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_VOYAGE_HDR VOYAGE   ON VOYAGE.TRANSACTION_POID=MFHDR.VOYAGE_TRANSACTION_POID
INNER JOIN SHIP_VESSEL_MASTER VMAST ON VOYAGE.VESSEL_POID =VMAST.VESSEL_POID
INNER JOIN SHIP_LINE_MASTER LNMAST  ON LNMAST.LINE_POID  =VOYAGE.LINE_POID
INNER JOIN SHIP_BL_MANIFEST_CHARGES_DTL MCHARGE ON MCHARGE.TRANSACTION_POID = MFHDR.TRANSACTION_POID
LEFT JOIN SHIP_COMODITY_MASTER CMAST ON CMAST.COMODITY_POID = MFHDR.COMODITY_POID
WHERE MFHDR.TRANSACTION_POID= $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="SHIPPER_POID" class="java.math.BigDecimal"/>
	<field name="SHIPPER" class="java.lang.String"/>
