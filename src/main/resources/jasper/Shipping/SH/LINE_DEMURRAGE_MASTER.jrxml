	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TILL_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
DISTINCT GET_LINE_NAME(VHDR.LINE_POID) LINE, BLHDR.BL_NUMBER, CTM.CONTAINER_TYPE_CODE || '|' || CTM.CONTAINER_TYPE_NAME CONTAINER_TYPE, EQUIPMENT_ISO_TYPE,
CONTAINERTRIFIMP.FREE_DAYS,
CONTAINERTRIFIMP.SLAB1_TILLDAYS,
CONTAINERTRIFIMP.SLAB1_RATE,
NVL(CONTAINERTRIFIMP.SLAB2_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB1_TILLDAYS, 0) SLAB2_TILLDAYS,
CONTAINERTRIFIMP.SLAB2_RATE,
NVL(CONTAINERTRIFIMP.SLAB3_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB2_TILLDAYS, 0) SLAB3_TILLDAYS,
CONTAINERTRIFIMP.SLAB3_RATE,
NVL(CONTAINERTRIFIMP.SLAB4_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB3_TILLDAYS, 0) SLAB4_TILLDAYS,
CONTAINERTRIFIMP.SLAB4_RATE,
NVL(CONTAINERTRIFIMP.SLAB5_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB4_TILLDAYS, 0) SLAB5_TILLDAYS,
CONTAINERTRIFIMP.SLAB5_RATE,
NVL(CONTAINERTRIFIMP.SLAB6_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB5_TILLDAYS, 0) SLAB6_TILLDAYS,
CONTAINERTRIFIMP.SLAB6_RATE,
NVL(CONTAINERTRIFIMP.SLAB7_TILLDAYS, 0) - NVL (CONTAINERTRIFIMP.SLAB6_TILLDAYS, 0) SLAB7_TILLDAYS,
CONTAINERTRIFIMP.SLAB7_RATE
FROM SHIP_VOYAGE_HDR VHDR
INNER JOIN  SHIP_BL_MANIFEST_HDR BLHDR ON VHDR.TRANSACTION_POID=BLHDR.VOYAGE_TRANSACTION_POID
INNER JOIN  SHIP_BL_MANIFEST_CONTAINER_DTL CONTAINERDTL ON CONTAINERDTL.TRANSACTION_POID=BLHDR.TRANSACTION_POID
INNER JOIN  SHIP_LINE_TARIFF_HDR SHLNTFHDR ON SHLNTFHDR.LINE_POID=VHDR.LINE_POID AND to_date(TO_DATE(NVL(ARRIVAL_DATE,EXPECTED_DATE))) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
INNER JOIN SHIP_LINE_TARIFF_IMP_DTL CONTAINERTRIFIMP ON SHLNTFHDR.TRANSACTION_POID=CONTAINERTRIFIMP.TRANSACTION_POID AND CONTAINERTRIFIMP.CONTAINER_TYPE_POID= GET_CONTAINER_CODE_POID(CONTAINERDTL.EQUIPMENT_ISO_TYPE)
INNER JOIN SHIP_CONTAINER_TYPE_MASTER CTM ON CONTAINERDTL.EQUIPMENT_ISO_TYPE=CTM.CONTAINER_TYPE_CODE
WHERE BLHDR.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
