	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.1.24\\adflibrary\\deployed\\Reports\\Templates\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT nvl(RECORD_ORDER,DET_ROW_ID) AS SEQ_NO, CARGODTL.CARGO_DESCRIPTION
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CARGO_DTL CARGODTL ON MFHDR.TRANSACTION_POID = CARGODTL.TRANSACTION_POID
WHERE UPPER(TRIM(CARGODTL.DESCRIPTION_TYPE)) IN ('CARGO','DESC','DESCRIPTION')
AND MFHDR.TRANSACTION_POID = TO_NUMBER($P{DOC_KEY_POID})
ORDER BY nvl(RECORD_ORDER,DET_ROW_ID)]]>
	</queryString>
	<field name="SEQ_NO" class="java.math.BigDecimal"/>
	<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="13" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
