	<queryString>
		<![CDATA[SELECT DISTINCT CONTAINER_NO,EQUIPMENT_ISO_TYPE,EQUIPMENT_SEAL_NO,NO_OF_PACKS||' '||PACK_UNIT NO_OF_PACKS , net_VOLUME GRS_VOLUME,GRS_WEIGHT,NET_WEIGHT,NO_OF_PACKS as PACKS, REFFER_TEMP temp
FROM SHIP_BL_MANIFEST_HDR MFHDR
INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CNTDTL ON MFHDR.TRANSACTION_POID =CNTDTL.TRANSACTION_POID
WHERE MFHDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
