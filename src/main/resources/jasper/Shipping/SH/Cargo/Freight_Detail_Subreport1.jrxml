	<style name="Column header" forecolor="#666666" fontName="Arial" fontSize="12" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="Detail" fontName="Arial" fontSize="12"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style backcolor="#E6DAC3"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.1.24\\adflibrary\\deployed\\Reports\\Templates\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_FREIGHTCARGO" class="java.lang.String">
		<defaultValueExpression><![CDATA['FALSE']]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT GET_CHARGE_CODE(CHARGE_POID)  EDI_CHARGE_CODE,CURRENCY_CODE, SUM(BUY_PERCHARGE) BUY_PERCHARGE,QUANTITY,FREIGHT_TYPE,
SUM(nvl(BUY_PERCHARGE,0)*nvl(QUANTITY,0)) as TOTALAMT
FROM SHIP_BL_MANIFEST_HDR MFHDR
inner join SHIP_BL_MANIFEST_CHARGES_DTL CHGDTL
ON MFHDR.TRANSACTION_POID =CHGDTL.TRANSACTION_POID
where MFHDR.TRANSACTION_POID = $P{DOC_KEY_POID} AND CHARGE_TYPE ='MANIFEST'
AND $P{P_FREIGHTCARGO}='TRUE' and BUY_PERCHARGE is not null
GROUP BY GET_CHARGE_CODE(CHARGE_POID),CURRENCY_CODE,
QUANTITY,FREIGHT_TYPE,CHARGE_BASIS_ON HAVING SUM(BUY_PERCHARGE)<>0
order by GET_CHARGE_CODE(CHARGE_POID)]]>
	</queryString>
	<field name="EDI_CHARGE_CODE" class="java.lang.String"/>
	<field name="CURRENCY_CODE" class="java.lang.String"/>
	<field name="BUY_PERCHARGE" class="java.math.BigDecimal"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
	<field name="FREIGHT_TYPE" class="java.lang.String"/>
	<field name="TOTALAMT" class="java.math.BigDecimal"/>
	<variable name="PREPAID" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{FREIGHT_TYPE}.equals("P")?($F{TOTALAMT}):null]]></variableExpression>
	</variable>
	<variable name="COLLECT" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{FREIGHT_TYPE}.equals("C")?($F{TOTALAMT}):null]]></variableExpression>
	</variable>
	<variable name="ELSEWHERE" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{FREIGHT_TYPE}.equals("E")?($F{TOTALAMT}):null]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
