<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Container_Return_Validity" language="groovy" pageWidth="595" pageHeight="842" columnWidth="532" leftMargin="43" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fa8fe9d4-300e-42f1-981b-34c84a9c7273">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" uuid="34302d40-cf14-4dd2-8cd9-6ad9027f7f28">
		<parameter name="P_BLPOID" class="java.lang.String"/>
		<parameter name="P_CONTAINERNO" class="java.lang.String"/>
		<parameter name="FSL_STAMP" class="java.io.InputStream"/>
		<queryString>
			<![CDATA[SELECT VALIDITY_DATE FROM (
select max(DM_TO_DATE) validity_date from AR_SH_RECEIPT_CONTAINER_DTL
WHERE BL_POID=$P{P_BLPOID} AND CONTAINER_NO=$P{P_CONTAINERNO}   and DM_TO_DATE is not null
UNION ALL
select max(DM_TO_DATE) validity_date from AR_SH_SALES_INVOICE_CONTNR_DTL
WHERE BL_POID=$P{P_BLPOID} AND CONTAINER_NO=$P{P_CONTAINERNO}   and DM_TO_DATE is not null
 ) WHERE VALIDITY_dATE IS NOT NULL order by 1]]>
		</queryString>
		<field name="VALIDITY_DATE" class="java.sql.Timestamp"/>
	</subDataset>
	<parameter name="DOC_ID" class="java.lang.String"/>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="P_TRAN_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DEBUG" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<parameter name="FSL_STAMP" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT ROWNUM SEQNO ,D.CONTAINER_NO,CONTAINER_TYPE_SIZE ||' ' ||CONTAINER_TYPE_ISO_NAME   CNTSIZE,D.QUANTITY,NVL(D.GRS_WEIGHT,0)/1000 DWT,
D.GRS_VOLUME,D.PACK_UNIT,D.NO_OF_PACKS,
upper(GET_COMPANY_NAME(H.COMPANY_POID))COMPANY,H.BL_NUMBER,H.DO_NO ,H.SHIPPER_POID,CONSIGNEE_EDI_NAME CONSIGNE,

NVL((select DISTINCT DECODE(GET_ADDRESS_DETAILS (PRINT_CUSTOMER_POID),'N/A',CONSIGNEE_EDI_NAME,GET_ADDRESS_DETAILS (PRINT_CUSTOMER_POID)) from AR_SH_RECEIPT_HDR
WHERE BL_POID=H.TRANSACTION_POID),(CASE WHEN upper(GET_ADDRESS_NAME(NOTIFY_POID_1)) like '%ORDER%' or (upper(GET_ADDRESS_NAME(NOTIFY_POID_1)) like '%N/A%') THEN gET_ADDRESS_NAME(DECODE( DO_PRIORITY,'C',CONSIGNEE_POID,'N',NOTIFY_POID_1,CONSIGNEE_POID))
   ELSE GET_ADDRESS_NAME(DECODE( DO_PRIORITY,'C',CONSIGNEE_POID,'N',NOTIFY_POID_1,NOTIFY_POID_1)) END)) CONSIGNEE_EDI_NAME
,
DECODE(EQUIPMENT_SHIPPER_OWN,'Y','SOC',get_LINE_NAME(VY.LINE_POID)) LINE,VY.VOYAGE_NO,VY.ARRIVAL_DATE,GET_VESSEL_NAME(VY.VESSEL_POID) VESSEL,FREE_DAYS,EXTRA_FREE_DAYS,(VY.ARRIVAL_DATE+decode(nvl(EXTRA_FREE_DAYS,0),0, FREE_DAYS ,EXTRA_FREE_DAYS))-1 first_validity,H.TRANSACTION_POID,TO_CHAR(sysdate,'DD-MON-YYYY') current_date,
FUNC_RTN_FORM_PRINT (EQUIPMENT_ISO_TYPE,SLN.LINE_CODE,H.transaction_poid) Print_Imco,NVL(is_imco,'N') IS_IMCO
FROM SHIP_BL_MANIFEST_CONTAINER_DTL D ,SHIP_BL_MANIFEST_HDR H, SHIP_VOYAGE_HDR VY,SHIP_LINE_MASTER SLN
, SHIP_CONTAINER_TYPE_MASTER CONTTYP,
SHIP_LINE_TARIFF_HDR shlinetHD ,
SHIP_LINE_TARIFF_IMP_DTL shlinetrf
WHERE  RETURN_FROM_CONSIGNEE is null and       NVL(HOLD_REASON,'5') NOT IN('1','3','5') and
shlinetHD.TRANSACTION_POID=shlinetrf.TRANSACTION_POID
AND
D.TRANSACTION_POID=H.TRANSACTION_POID AND VY.TRANSACTION_POID=H.VOYAGE_TRANSACTION_POID
and CONTAINER_TYPE_CODE=EQUIPMENT_ISO_TYPE
and shlinetrf.CONTAINER_TYPE_POID=GET_CONTAINER_CODE_POID(EQUIPMENT_ISO_TYPE)
AND SLN.LINE_POID=VY.LINE_POID
AND NVL(SLN.CONTAINER_FORM_VHENT,'N')='Y'
and H.TRANSACTION_POID=$P{P_TRAN_NO}
AND to_date(NVL(ARRIVAL_DATE,EXPECTED_DATE)) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO) and shlinetHD.LINE_POID=VY.line_poid  AND NVL(PRINT_DELIVERY_FORM_DEFAULT,'N') IN ('Y','MANUALLYPRINT')]]>
	</queryString>
