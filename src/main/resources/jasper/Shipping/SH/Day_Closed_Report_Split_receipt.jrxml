<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Day_Closed_Report_Split_receipt" language="groovy" pageWidth="802" pageHeight="555" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="58a10e7c-9184-47dd-828e-b089c593315a">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="CASH_CHEQUE" uuid="95ec26b7-f625-4788-a24b-24599acd28bb">
		<parameter name="P_START_DATE" class="java.lang.String"/>
		<parameter name="P_END_DATE" class="java.lang.String"/>
		<parameter name="P_COMPANY" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT  CASH,CHEQUE FROM (
           select rcpt_type,sum(AMOUNT) AMOUNT from (
           select hdr.TRANSACTION_POID,hdr.company_poid,
           case when PYMT_TYPE = 'CHEQUE' and CHQ_CARDNO is not null
           then 'CHEQUE'
            when PYMT_TYPE = 'CASH' and (AMOUNT is not null or AMOUNT != 0)
            then 'CASH'
           end rcpt_type,
          AMOUNT from
           AR_SH_RECEIPT_HDR hdr
           inner join ar_sh_receipt_pymt_details paydtl  on paydtl.TRANSACTION_POID = hdr.TRANSACTION_POID
           where to_date(TRUNC(hdr.TRANSACTION_DATE)) BETWEEN $P{P_START_DATE} AND  $P{P_END_DATE}
           and NVL(hdr.DELETED,'N') = 'N'
           order by hdr.company_poid)
           where rcpt_type is not null
           group by rcpt_type
           order by company_poid )
           PIVOT ( SUM(AMOUNT) FOR (rcpt_type) IN ('CASH' AS CASH, 'CHEQUE' AS CHEQUE))]]>
		</queryString>
		<field name="CASH" class="java.math.BigDecimal"/>
		<field name="CHEQUE" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="P_START_DATE" class="java.lang.String"/>
	<parameter name="P_END_DATE" class="java.lang.String"/>
	<parameter name="COMPANY_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT
                         REPHDR.TRANSACTION_DATE, REPHDR.DOC_REF,  BL_NUMBER,REPHDR.CREATED_BY,RCPT_AMOUNT,
                        (SELECT listagg(HDR.doc_ref||'('||SPLIT_RCPT_AMOUNT||')',',')  WITHIN GROUP (ORDER BY HDR.TRANSACTION_POID) SPLIT_RECEIPT
FROM AR_SH_RECEIPT_HDR HDR
INNER JOIN AR_SH_RECEIPT_SPLIT_DTL ARBDTL ON HDR.TRANSACTION_POID = ARBDTL.SPLIT_TRANSACTION_POID
INNER JOIN SHIP_BL_MANIFEST_HDR BHDR ON BHDR.TRANSACTION_POID=HDR.BL_POID
WHERE ARBDTL.TRANSACTION_POID IN (SELECT  TRANSACTION_POID FROM AR_SH_RECEIPT_HDR  WHERE TRANSACTION_POID =REPHDR.TRANSACTION_POID)) split_receipt
                  FROM
                        AR_SH_RECEIPT_HDR REPHDR
                  left JOIN SHIP_BL_MANIFEST_HDR MANIHDR       ON REPHDR.BL_POID                  = MANIHDR.TRANSACTION_POID

                  WHERE
                         to_date(TRUNC(REPHDR.TRANSACTION_DATE)) BETWEEN  $P{P_START_DATE} AND   $P{P_END_DATE}
                         AND BL_NUMBER IS NULL AND NVL(REPHDR.DELETED,'N') = 'N'
order by REPHDR.COMPANY_POID,REPHDR.DOC_REF]]>
	</queryString>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
	<field name="RCPT_AMOUNT" class="java.math.BigDecimal"/>
	<field name="SPLIT_RECEIPT" class="java.lang.String"/>
	<variable name="TOTAL RECEIPT_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RCPT_AMOUNT}]]></variableExpression>
		<initialValueExpression><![CDATA[$F{RCPT_AMOUNT}]]></initialValueExpression>
	</variable>
