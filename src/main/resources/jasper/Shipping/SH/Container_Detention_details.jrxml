	<subDataset name="Detention_details" uuid="a9bfd83b-7870-40fe-978d-ecdcf016eca7">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct condtl.CONTAINER_NO,to_char(ISSUE_TO_SHIPPER,'DD-MON-YYYY') ISSUE_DATE,TO_CHAR(RETURN_FROM_SHIPPER,'DD-MON-YYYY') RECEIVED_DATE
,decode(nvl(EXTRA_FREE_DAYS,0),0,TIDTL.FREE_DAYS,EXTRA_FREE_DAYS) FREE_DAYS,
round(((to_date(RETURN_FROM_SHIPPER) - to_date(ISSUE_TO_SHIPPER)) + 1)) dentention_days,
case when round(((to_date(RETURN_FROM_SHIPPER) - to_date(ISSUE_TO_SHIPPER)) + 1)) > decode(nvl(EXTRA_FREE_DAYS,0),0,TIDTL.FREE_DAYS,EXTRA_FREE_DAYS) then round(round(((to_date(RETURN_FROM_SHIPPER) - to_date(ISSUE_TO_SHIPPER)) + 1)) - decode(nvl(EXTRA_FREE_DAYS,0),0,TIDTL.FREE_DAYS,EXTRA_FREE_DAYS)) else 0 end  paid_days,
FUNC_RTN_DEM_DETTN_FULL( hdr.GROUP_POID,hdr.company_poid,invsales.transaction_poid, hdr.transaction_poid,condtl.CONTAINER_NO,TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid,ISSUE_TO_SHIPPER,RETURN_FROM_SHIPPER,'DETN',
decode(nvl(EXTRA_FREE_DAYS,0),0,0,EXTRA_FREE_DAYS)) total_charge,TO_CHAR(SAIL_DATE,'DD-MON-YYYY') SAIL_DATE,null detn_collected
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'EXPORT'
left join AR_SH_SALES_INVOICE_CONTNR_DTL invsales on  hdr.TRANSACTION_POID=invsales.bl_poid
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_mate_hdr matehdr
on condtl.MATE_TRANSACTION_POID = matehdr.TRANSACTION_POID
inner join SHIP_MATE_CONTAINER_DTL matecondtl
on matehdr.TRANSACTION_POID = matecondtl.TRANSACTION_POID
and condtl.container_no=matecondtl.container_no
inner join SHIP_LINE_TARIFF_HDR trarif on voyhdr.line_poid = trarif.line_poid and trarif.COMPANY_POID = hdr.company_poid
and to_date(SAIL_DATE) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
INNER JOIN SHIP_LINE_TARIFF_exp_DTL TIDTL ON  TIDTL.TRANSACTION_POID=trarif.TRANSACTION_POID
and TIDTL.CONTAINER_TYPE_POID=TMAST.CONTAINER_TYPE_POID
where hdr.transaction_poid =  $P{DOC_KEY_POID} AND EXTRA_TARIFF='N']]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="ISSUE_DATE" class="java.lang.String"/>
		<field name="RECEIVED_DATE" class="java.lang.String"/>
		<field name="FREE_DAYS" class="java.math.BigDecimal"/>
		<field name="DENTENTION_DAYS" class="java.math.BigDecimal"/>
		<field name="PAID_DAYS" class="java.math.BigDecimal"/>
		<field name="TOTAL_CHARGE" class="java.math.BigDecimal"/>
		<field name="SAIL_DATE" class="java.lang.String"/>
		<field name="DETN_COLLECTED" class="java.lang.String"/>
		<variable name="TOTAL" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></initialValueExpression>
		</variable>
		<variable name="Total_sum" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$V{TOTAL}]]></variableExpression>
			<initialValueExpression><![CDATA[$V{TOTAL}]]></initialValueExpression>
		</variable>
	</subDataset>
	<subDataset name="Port_storage_Collection_details" uuid="4e3c67a4-5eda-4208-8be9-794c266fdb0b">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct CONTAINER_NO,ISO_CODE,received_from_shipper,Export_load_date,FREE_DAYS,Storage,total_chares,SAIL_DATE,
case when ((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) > FREE_DAYS then round((((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) - FREE_DAYS)) end  paid_days from(
select distinct condtl.CONTAINER_NO,CONTAINER_TYPE_CODE ISO_CODE,to_char(RETURN_FROM_SHIPPER,'DD-MON-YYYY') received_from_shipper,to_char(SAIL_DATE,'DD-MON-YYYY') Export_load_date
,(SELECT FREE_DAYS
FROM SHIP_PORT_TARIFF_HDR THDR
INNER JOIN SHIP_PORT_TARIFF_DTL TIDTL ON  TIDTL.TRANSACTION_POID=THDR.TRANSACTION_POID
WHERE  to_date(SAIL_DATE) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
and TARIFF_TYPE='FULL' and CONTAINER_SIZE=TMAST.CONTAINER_TYPE_SIZE) FREE_DAYS,
round((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) Storage,
FUNC_RTN_port_storage
( hdr.GROUP_POID,hdr.company_poid,-999, hdr.transaction_poid,condtl.CONTAINER_NO,
TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid,RETURN_FROM_SHIPPER,SAIL_DATE,'FULL') total_chares
,SAIL_DATE,RETURN_FROM_SHIPPER
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'EXPORT'
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_mate_hdr matehdr
on condtl.MATE_TRANSACTION_POID = matehdr.TRANSACTION_POID
inner join SHIP_MATE_CONTAINER_DTL matecondtl
on matehdr.TRANSACTION_POID = matecondtl.TRANSACTION_POID
and condtl.container_no=matecondtl.container_no
where hdr.transaction_poid = $P{DOC_KEY_POID} and to_date(SAIL_DATE)<='30-APR-2017')
UNION ALL
select distinct CONTAINER_NO,ISO_CODE,received_from_shipper,Export_load_date,FREE_DAYS,Storage,total_chares,SAIL_DATE,
case when ((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) > FREE_DAYS then round((((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) - FREE_DAYS)) end  paid_days from(
select distinct condtl.CONTAINER_NO,CONTAINER_TYPE_CODE ISO_CODE,to_char(RETURN_FROM_SHIPPER,'DD-MON-YYYY') received_from_shipper,to_char(SAIL_DATE,'DD-MON-YYYY') Export_load_date
,(SELECT FREE_DAYS
FROM SHIP_PORT_TARIFF_HDR THDR
INNER JOIN SHIP_PORT_TARIFF_DTL TIDTL ON  TIDTL.TRANSACTION_POID=THDR.TRANSACTION_POID
WHERE  to_date(SAIL_DATE) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
and TARIFF_TYPE='EXPORTFULL' and CONTAINER_SIZE=TMAST.CONTAINER_TYPE_SIZE) FREE_DAYS,
round((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) Storage,
FUNC_RTN_port_storage
( hdr.GROUP_POID,hdr.company_poid,-999, hdr.transaction_poid,condtl.CONTAINER_NO,
TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid,RETURN_FROM_SHIPPER,SAIL_DATE,'EXPORTFULL') total_chares
,SAIL_DATE,RETURN_FROM_SHIPPER
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'EXPORT'
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_mate_hdr matehdr
on condtl.MATE_TRANSACTION_POID = matehdr.TRANSACTION_POID
inner join SHIP_MATE_CONTAINER_DTL matecondtl
on matehdr.TRANSACTION_POID = matecondtl.TRANSACTION_POID
and condtl.container_no=matecondtl.container_no
where hdr.transaction_poid = $P{DOC_KEY_POID} and to_date(SAIL_DATE)>'30-APR-2017')]]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="ISO_CODE" class="java.lang.String"/>
		<field name="RECEIVED_FROM_SHIPPER" class="java.lang.String"/>
		<field name="EXPORT_LOAD_DATE" class="java.lang.String"/>
		<field name="FREE_DAYS" class="java.math.BigDecimal"/>
		<field name="STORAGE" class="java.math.BigDecimal"/>
		<field name="TOTAL_CHARES" class="java.math.BigDecimal"/>
		<field name="SAIL_DATE" class="java.sql.Timestamp"/>
		<field name="PAID_DAYS" class="java.math.BigDecimal"/>
		<variable name="Sum_Charges" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_CHARES}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{TOTAL_CHARES}]]></initialValueExpression>
		</variable>
	</subDataset>
	<subDataset name="YML_Detention_details" uuid="d75c7299-2939-456f-94d8-98b31e1f5220">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct condtl.CONTAINER_NO,to_char(RETURN_FROM_SHIPPER,'DD-MON-YYYY') recevied_from_shipper,TO_CHAR(SAIL_DATE,'DD-MON-YYYY') export_load_date
,decode(nvl(EXTRA_FREE_DAYS,0),0,FREE_DAYS,FREE_DAYS) FREE_DAYS,
round((to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER) ) + 1 ) dentention_days,
case when ( ( to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER)) + 1) > FREE_DAYS then round( ( (to_date(SAIL_DATE) - to_date(RETURN_FROM_SHIPPER))+1) - FREE_DAYS) end  paid_days,
FUNC_RTN_DEM_DETTN_FULL
( hdr.GROUP_POID,hdr.company_poid,-999, hdr.transaction_poid,condtl.CONTAINER_NO,
TMAST.CONTAINER_TYPE_POID,voyhdr.line_poid,RETURN_FROM_SHIPPER,SAIL_DATE,'DETN',
decode(nvl(EXTRA_FREE_DAYS,0),0,0,0),'Y') total_charge
from SHIP_BL_MANIFEST_HDR hdr
inner join SHIP_BL_MANIFEST_CONTAINER_DTL condtl
on hdr.transaction_poid = condtl.transaction_poid and hdr.bl_type = 'EXPORT'
INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST
ON condtl.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_mate_hdr matehdr
on condtl.MATE_TRANSACTION_POID = matehdr.TRANSACTION_POID
inner join SHIP_MATE_CONTAINER_DTL matecondtl
on matehdr.TRANSACTION_POID = matecondtl.TRANSACTION_POID and CONDTL.CONTAINER_NO= matecondtl.CONTAINER_NO
inner join SHIP_LINE_TARIFF_HDR trarif on voyhdr.line_poid = trarif.line_poid and trarif.COMPANY_POID = hdr.company_poid
and to_date(SAIL_DATE) BETWEEN TO_DATE(PERIOD_FROM) AND TO_DATE(PERIOD_TO)
INNER JOIN SHIP_LINE_TARIFF_exp_DTL TIDTL ON  TIDTL.TRANSACTION_POID=trarif.TRANSACTION_POID
and TIDTL.CONTAINER_TYPE_POID=TMAST.CONTAINER_TYPE_POID
where hdr.transaction_poid = $P{DOC_KEY_POID} AND EXTRA_TARIFF='Y']]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="RECEVIED_FROM_SHIPPER" class="java.lang.String"/>
		<field name="EXPORT_LOAD_DATE" class="java.lang.String"/>
		<field name="FREE_DAYS" class="java.math.BigDecimal"/>
		<field name="DENTENTION_DAYS" class="java.math.BigDecimal"/>
		<field name="PAID_DAYS" class="java.math.BigDecimal"/>
		<field name="TOTAL_CHARGE" class="java.math.BigDecimal"/>
		<variable name="YML_Sum_Charges" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></initialValueExpression>
		</variable>
		<variable name="YML_TOTAL_CHARGE" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></initialValueExpression>
		</variable>
	</subDataset>
	<subDataset name="Detention_details_ESL" uuid="3d2cab23-800c-4a45-b667-fbe40070c931">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT DISTINCT CONDTL.CONTAINER_NO, TO_CHAR(ISSUE_TO_SHIPPER, 'DD-MON-YYYY')ISSUE_DATE,
TO_CHAR(TO_DATE(SAIL_DATE), 'DD-MON-YYYY')RECEIVED_DATE,
DECODE(NVL(EXTRA_FREE_DAYS, 0), 0, TIDTL.FREE_DAYS, EXTRA_FREE_DAYS) FREE_DAYS,
    ROUND(((TO_DATE(SAIL_DATE)- TO_DATE(ISSUE_TO_SHIPPER))+ 1))DENTENTION_DAYS,
    CASE
    WHEN ROUND(((TO_DATE(SAIL_DATE)- TO_DATE(ISSUE_TO_SHIPPER))+ 1))> DECODE(NVL(EXTRA_FREE_DAYS, 0), 0, TIDTL.FREE_DAYS, EXTRA_FREE_DAYS)
        THEN ROUND(ROUND(((TO_DATE(SAIL_DATE)- TO_DATE(ISSUE_TO_SHIPPER))+ 1))- DECODE(NVL(EXTRA_FREE_DAYS, 0), 0, TIDTL.FREE_DAYS, EXTRA_FREE_DAYS))
    ELSE 0 END PAID_DAYS, FUNC_RTN_DEM_DETTN_FULL(HDR.GROUP_POID, HDR.COMPANY_POID, INVSALES.TRANSACTION_POID, HDR.TRANSACTION_POID, CONDTL.CONTAINER_NO,
    TMAST.CONTAINER_TYPE_POID, VOYHDR.LINE_POID, ISSUE_TO_SHIPPER, TO_DATE(SAIL_DATE), 'DETN', DECODE(NVL(EXTRA_FREE_DAYS, 0), 0, 0, EXTRA_FREE_DAYS))TOTAL_CHARGE,
    TO_CHAR(SAIL_DATE, 'DD-MON-YYYY')SAIL_DATE, NULL DETN_COLLECTED
  FROM SHIP_BL_MANIFEST_HDR HDR
 INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL CONDTL ON HDR.TRANSACTION_POID = CONDTL.TRANSACTION_POID AND HDR.BL_TYPE = 'EXPORT'
 LEFT JOIN AR_SH_SALES_INVOICE_CONTNR_DTL INVSALES ON HDR.TRANSACTION_POID = INVSALES.BL_POID
 INNER JOIN SHIP_CONTAINER_TYPE_MASTER TMAST ON CONDTL.EQUIPMENT_ISO_TYPE = TMAST.CONTAINER_TYPE_CODE
 INNER JOIN SHIP_VOYAGE_HDR VOYHDR ON HDR.VOYAGE_TRANSACTION_POID = VOYHDR.TRANSACTION_POID
 INNER JOIN SHIP_MATE_HDR MATEHDR ON CONDTL.MATE_TRANSACTION_POID = MATEHDR.TRANSACTION_POID
 INNER JOIN SHIP_MATE_CONTAINER_DTL MATECONDTL ON MATEHDR.TRANSACTION_POID = MATECONDTL.TRANSACTION_POID AND CONDTL.CONTAINER_NO = MATECONDTL.CONTAINER_NO
 INNER JOIN SHIP_LINE_TARIFF_HDR TRARIF ON VOYHDR.LINE_POID = TRARIF.LINE_POID AND TRARIF.COMPANY_POID = HDR.COMPANY_POID AND TO_DATE(SAIL_DATE)BETWEEN TO_DATE(PERIOD_FROM)AND TO_DATE(PERIOD_TO)
 INNER JOIN SHIP_LINE_TARIFF_EXP_DTL TIDTL ON TIDTL.TRANSACTION_POID = TRARIF.TRANSACTION_POID AND TIDTL.CONTAINER_TYPE_POID = TMAST.CONTAINER_TYPE_POID
 LEFT JOIN SHIP_LINE_MASTER LM ON LM.LINE_POID = VOYHDR.LINE_POID
where hdr.transaction_poid =  $P{DOC_KEY_POID} AND EXTRA_TARIFF='N']]>
		</queryString>
		<field name="CONTAINER_NO" class="java.lang.String"/>
		<field name="ISSUE_DATE" class="java.lang.String"/>
		<field name="RECEIVED_DATE" class="java.lang.String"/>
		<field name="FREE_DAYS" class="java.math.BigDecimal"/>
		<field name="DENTENTION_DAYS" class="java.math.BigDecimal"/>
		<field name="PAID_DAYS" class="java.math.BigDecimal"/>
		<field name="TOTAL_CHARGE" class="java.math.BigDecimal"/>
		<field name="SAIL_DATE" class="java.lang.String"/>
		<field name="DETN_COLLECTED" class="java.lang.String"/>
		<variable name="TOTAL" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></variableExpression>
			<initialValueExpression><![CDATA[$F{TOTAL_CHARGE} < BigDecimal.ZERO ? 0 :$F{TOTAL_CHARGE}]]></initialValueExpression>
		</variable>
		<variable name="Total_sum" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$V{TOTAL}]]></variableExpression>
			<initialValueExpression><![CDATA[$V{TOTAL}]]></initialValueExpression>
		</variable>
	</subDataset>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\10.100.100.200\\erp_reports\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[select bl_number,line_name,line_code,hdr.company_poid from
SHIP_BL_MANIFEST_HDR hdr
inner join ship_voyage_Hdr voyhdr
on hdr.VOYAGE_TRANSACTION_POID = voyhdr.TRANSACTION_POID
inner join ship_line_master lmast on
voyhdr.line_poid = lmast.line_poid
where hdr.bl_type = 'EXPORT' and hdr.transaction_poid = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="BL_NUMBER" class="java.lang.String"/>
	<field name="LINE_NAME" class="java.lang.String"/>
	<field name="LINE_CODE" class="java.lang.String"/>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
