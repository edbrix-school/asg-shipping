	<subDataset name="AMOUNT_IN_WORDS" uuid="6f64045d-961f-4f01-a738-36e17b7bbf1e">
		<parameter name="AMOUNT_IN_NUMBER" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT FN_AMOUNT_IN_WORDS_COMMON($P{AMOUNT_IN_NUMBER},'BHD')  AMOUNT_WORDS FROM DUAL]]>
		</queryString>
		<field name="AMOUNT_WORDS" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_KEY_POID" class="java.lang.Long"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TRN_POID_HDR" class="java.lang.String" isForPrompting="false"/>
	<parameter name="P_TOTAL_AMT" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="P_HDR_TRN_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DEMURRAGE_DATE" class="java.lang.String"/>
	<parameter name="P_DISCOUNT" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT2" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT3" class="net.sf.jasperreports.engine.JasperReport"/>

	<queryString>
		<![CDATA[SELECT
DECODE(HDR.COMPANY_POID,'3','1','3') DIVISION_POID,HDR.COMPANY_POID,
GET_COMPANY_NAME(HDR.COMPANY_POID) COMPANY,
HDR.BL_NUMBER, VOY.ARRIVAL_DATE, VOY.VOYAGE_NO,
SLM.LINE_CODE, SVM.VESSEL_NAME,
GET_PORT_NAME(HDR.PORT_OF_LOADING_POID) LOAD_PORT,
NVL(SM.DESCRIPTION,'') AS CUSTOMER_NAME,
DECODE(NVL(SM.TIN_NUMBER,''),'','','VAT number: '|| SM.TIN_NUMBER)  AS  TIN_NUMBER,
DECODE(NVL(GA1.PO_BOX,''),'','','P. O. BOX :' || GA1.PO_BOX) AS PO_BOX,
DECODE(NVL(GA1.OFF_NO,''),'','','Office :' || GA1.OFF_NO) AS OFF_NO,
DECODE(NVL(GA1.BLDG,''),'','','Building :' || NVL(GA1.BLDG,'')) AS BUILDING,
DECODE(NVL(ROAD,''),'','','Road# :' || NVL(ROAD,'')) AS ROAD,
DECODE(NVL(AREA_CITY,''),'','',NVL(AREA_CITY,'')) AS AREACITY,
DECODE(NVL(GET_COUNTRY_CODE(GA.COUNTRY_POID), NVL(GA1.STATE,'KINGDOM OF BAHRAIN')),'BH','KINGDOM OF BAHRAIN',nvl(GA1.STATE,'KINGDOM OF BAHRAIN')) AS STATE,
nvl(GA1.EMAIL1,'') AS EMAIL,
nvl(GA1.FAX,'') AS FAX,
nvl(GA1.OFF_TEL1,'') AS OFFICE_TEL,
nvl(GA1.MOBILE,'') AS MOBILE,
(
'Beneficiary Name :-'||COMPANY_NAME||CHR(13)||CHR(10)|| 'Bank Name :-'||GBM.BANK_ADDRESS||CHR(13)||CHR(10)
    ||'Account Number :-'||GBM.BANK_ACCOUNT_NO||CHR(13)||CHR(10)||'Swift Code :-'||GBM.SWIFT_CODE||CHR(13)||CHR(10)||'IBAN Number :-'||GBM.IBAN
) PAYMENT_DETAILS,
NULL REMARKS,
'TAX' COMPANY_TAX,
TRIM(TO_CHAR(NVL(QRY.AMOUNT,0) + NVL(DEM.demmurrage_base_amt,0),'999,999.000')) NOVAT_INV_AMOUNT,
TRIM(TO_CHAR(NVL(QRY.VAT_AMOUNT,0) + NVL(DEM.demurrage_tax_amt,0),'999,999.000')) TAX_AMOUNT,
TRIM(TO_CHAR(NVL(QRY.TOTAL,0) + NVL(DEM.demurrage_total,0),'999,999.000')) DISPLAY_INV_AMOUNT,
'BHD' CURRENCY_CODE,
FN_AMOUNT_IN_WORDS_COMMON(NVL(QRY.TOTAL,0)+NVL(DEM.demurrage_total,0),'BHD') TOTAL_INV_AMOUNT_WORD,
NVL(DEM.demurrage_total,0) DEMURRAGE_TOTAL
FROM SHIP_BL_MANIFEST_HDR HDR
INNER JOIN SHIP_VOYAGE_HDR VOY ON HDR.VOYAGE_TRANSACTION_POID=VOY.TRANSACTION_POID
INNER JOIN SHIP_LINE_MASTER SLM ON VOY.LINE_POID=SLM.LINE_POID
INNER JOIN SHIP_VESSEL_MASTER SVM ON VOY.VESSEL_POID=SVM.VESSEL_POID
LEFT JOIN
(
    SELECT MAIN_POID, CODE, DESCRIPTION, ADDRESS_ID, TIN_NUMBER,TYPE_DATA
        FROM VW_CUSTOMER_SUPPLIER  WHERE TYPE_DATA='C'
    UNION ALL
    SELECT PRINCIPAL_POID AS POID, PRINCIPAL_CODE AS CODE, PRINCIPAL_NAME AS DESCRIPTION,
                ADDRESS_POID AS ADDRESS_ID, TIN_NUMBER AS TIN_NUMBER, 'P' TYPE_DATA
    FROM SHIP_PRINCIPAL_MASTER WHERE 1=2
) SM ON HDR.BOOKING_PARTY_POID=SM.MAIN_POID
INNER JOIN
(
    SELECT TRANSACTION_POID,
    SUM(RATE) RATE, SUM(AMOUNT) AMOUNT, SUM(VAT_AMOUNT) VAT_AMOUNT, SUM(TOTAL) TOTAL
    FROM
    (
        SELECT
        DTL.TRANSACTION_POID,
        DTL.PER_QUANTITY_AMOUNT RATE,
        DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY AMOUNT,
        DTL.TAX_PERCENTAGE VAT_PERCENTAGE,
        (DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY)*(TAX_PERCENTAGE/100) VAT_AMOUNT,
        (DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY) + ((DTL.PER_QUANTITY_AMOUNT*DTL.QUANTITY)*(TAX_PERCENTAGE/100)) TOTAL
        FROM SHIP_BL_MANIFEST_CHARGES_DTL DTL
        WHERE DTL.FREIGHT_TYPE='C'
    ) GROUP BY TRANSACTION_POID
) QRY ON HDR.TRANSACTION_POID=QRY.TRANSACTION_POID
LEFT JOIN
(
select transaction_poid,
demmurrage_base_amt, demurrage_tax_percent,
((demurrage_tax_percent/100)*demmurrage_base_amt) demurrage_tax_amt,
demmurrage_base_amt + ((demurrage_tax_percent/100)*demmurrage_base_amt) demurrage_total
from
(
SELECT transaction_poid,
NVL(dem_total_amount,0) demmurrage_base_amt,
NVL((
    SELECT NVL(MAX(PERCENTAGE), 0)
    FROM GLOBAL_TAX_MASTER
    WHERE TAX_POID IN (
        SELECT TAX_POID
        FROM SHIP_CHARGE_MASTER
        WHERE CHARGE_POID = RTN_GLOBAL_PARAMETER(1, 'SHIPPERDEMURRAGE', 'SHDEMURRAGE', 1, '0')
)
), 0) demurrage_tax_percent
FROM (

    SELECT mhdr.transaction_poid, SUM(
        fUNC_RTN_DEM_DETTN_FULL(
            vhdr.GROUP_POID, vhdr.COMPANY_POID, -999,
            cntdnt.transaction_poid, CONTAINER_NO,
            GET_CONTAINER_CODE_POID(cntdnt.EQUIPMENT_ISO_TYPE),
            lINE_POID, vhdr.ARRIVAL_DATE, TO_DATE($P{P_DEMURRAGE_DATE}),
            'DEMM', EXTRA_FREE_DAYS
        )
    ) dem_total_amount
    FROM SHIP_VOYAGE_HDR vhdr
    INNER JOIN SHIP_BL_MANIFEST_HDR mhdr ON mhdr.voyage_transaction_poid = vhdr.transaction_poid
    INNER JOIN SHIP_BL_MANIFEST_CONTAINER_DTL cntdnt ON cntdnt.transaction_poid = mhdr.transaction_poid
    WHERE RETURN_FROM_CONSIGNEE IS NULL
      AND mhdr.TRANSACTION_POID = $P{DOC_KEY_POID}
      AND (
        fUNC_RTN_DEM_DETTN_FULL(
            vhdr.GROUP_POID, vhdr.COMPANY_POID, -999,
            cntdnt.transaction_poid, CONTAINER_NO,
            GET_CONTAINER_CODE_POID(cntdnt.EQUIPMENT_ISO_TYPE),
            lINE_POID, vhdr.ARRIVAL_DATE, TO_DATE($P{P_DEMURRAGE_DATE}),
            'DEMM', EXTRA_FREE_DAYS
        )
      ) > 0 group by mhdr.transaction_poid
)
)
) DEM ON HDR.TRANSACTION_POID=DEM.TRANSACTION_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1 ON SM.ADDRESS_ID = GA1.ADDRESS_MASTER_POID AND GA1.ADDRESS_TYPE='MAIN'
LEFT JOIN GLOBAL_ADDRESS_MASTER GA ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
LEFT JOIN GLOBAL_COMPANY_MASTER COMMAST  ON COMMAST.COMPANY_POID=HDR.COMPANY_POID
LEFT JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID=RTN_GLOBAL_PARAMETER(COMMAST.group_poid, 'CAN_GL_BANK_SHIPPING','CAN_BANK_TRANSFER', COMMAST.company_poid, 'xx')
WHERE HDR.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
