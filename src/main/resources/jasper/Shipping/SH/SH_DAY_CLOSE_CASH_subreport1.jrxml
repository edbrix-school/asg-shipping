	<queryString>
		<![CDATA[SELECT ROWNUM SRNO,TRANSACTION_POID,CURRENCY_AMOUNT,CURRENCY_TYPE,NO_OF_TRAN,CASH_AMOUNT
FROM AR_SH_DAY_END_CLOSE_DTL WHERE TRANSACTION_POID=$P{DOC_KEY_POID_DNO}
