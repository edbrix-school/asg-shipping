<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Container_mate_receipts_subreport1" language="groovy" pageWidth="350" pageHeight="802" columnWidth="350" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="663cc590-d138-4ccf-bde2-525ffaf8e50c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_TRAN_POID" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select DTL.TRANSACTION_POID,DTL.CONTAINER_NO,DTL.EQUIPMENT_SEAL_NO,DTL.EQUIPMENT_TYPE,DTL.EQUIPMENT_SIZE,DTL.QUANTITY,DTL.CARGO_DESCRIPTION from SHIP_MATE_CONTAINER_DTL DTL WHERE DTL.TRANSACTION_POID=$P{P_TRAN_POID} AND 1=2
UNION ALL
select DTL.TRANSACTION_POID, NULL CONTAINER_NO,NULL EQUIPMENT_SEAL_NO,
GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'TYPE_ISO_NAME'  ) EQUIPMENT_TYPE
,GET_CONTAINER_TYPE(EQUIPMENT_ISO_TYPE ,'SIZE'  ) EQUIPMENT_SIZE,DTL.QUANTITY,DTL.CARGO_DESCRIPTION
from SHIP_MATE_CARGO_DTL DTL
WHERE DTL.TRANSACTION_POID=$P{P_TRAN_POID}
 ]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="CONTAINER_NO" class="java.lang.String"/>
	<field name="EQUIPMENT_SEAL_NO" class="java.lang.String"/>
	<field name="EQUIPMENT_TYPE" class="java.lang.String"/>
	<field name="EQUIPMENT_SIZE" class="java.lang.String"/>
	<field name="QUANTITY" class="java.math.BigDecimal"/>
	<field name="CARGO_DESCRIPTION" class="java.lang.String"/>
