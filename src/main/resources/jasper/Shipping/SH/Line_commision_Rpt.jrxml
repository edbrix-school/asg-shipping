	<subDataset name="Container_commisionDtl" uuid="044ee33e-58e8-4048-a42b-ec2a8a6778f3">
		<parameter name="DOC_KEY_POID1" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT CNT.TRANSACTION_POID,TYP.CONTAINER_TYPE_CODE,TYP.CONTAINER_APMT_TYPE_CODE APMT_CODE,CNT.IMPORT_BOX_RATE,CNT.EXPORT_BOX_RATE,CNT.TRANSHIP_BOX_RATE,CNT.REMARKS
FROM SHIP_LINE_COMM_CNTNR_DTL CNT
LEFT JOIN SHIP_CONTAINER_TYPE_MASTER TYP ON CNT.CONTAINER_TYPE_POID=TYP.CONTAINER_TYPE_POID
 where CNT.TRANSACTION_POID=$P{DOC_KEY_POID1} ORDER BY CNT.CONTAINER_TYPE_POID]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="CONTAINER_TYPE_CODE" class="java.lang.String"/>
		<field name="APMT_CODE" class="java.lang.String"/>
		<field name="IMPORT_BOX_RATE" class="java.math.BigDecimal"/>
		<field name="EXPORT_BOX_RATE" class="java.math.BigDecimal"/>
		<field name="TRANSHIP_BOX_RATE" class="java.math.BigDecimal"/>
		<field name="REMARKS" class="java.lang.String"/>
	</subDataset>
	<subDataset name="Comm_remuneration_dtls" uuid="c012d46e-1be0-412c-8818-ad7fdd869580">
		<parameter name="DOC_KEY_POID2" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT D.TRANSACTION_POID,R.REMUN_DESCRIPTION,CUR.CURRENCY_CODE,D.AMOUNT,D.PERCENT,D.REMARKS,D.PAYBACK_PERCENT FROM SHIP_LINE_COMM_DTL D
INNER JOIN SHIP_REMUNERATION_MASTER R ON D.REMUNERATION_POID=R.REMUNERATION_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER CUR ON D.CURRENCY_POID=CUR.CURRENCY_POID
where D.TRANSACTION_POID= $P{DOC_KEY_POID2}
ORDER BY AMOUNT DESC]]>
		</queryString>
		<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
		<field name="REMUN_DESCRIPTION" class="java.lang.String"/>
		<field name="CURRENCY_CODE" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
		<field name="PERCENT" class="java.math.BigDecimal"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="PAYBACK_PERCENT" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_ID" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TRANSACTION_POID,TRANSACTION_DATE,LINE_POID,GET_LINE_NAME(LINE_POID) LINE,PERIOD_FROM,PERIOD_TO,
RENEWAL_DATE,DESCRIPTION,CURRENCY_POID,DOC_REF,GET_COMPANY_NAME(COMPANY_POID)COMPANY,REMARKS FROM SHIP_LINE_COMM_HDR where TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
