	<queryString>
		<![CDATA[SELECT THDR.TRANSACTION_POID,GET_LINE_NAME(THDR.LINE_POID) LINE_NAME,TO_CHAR(THDR.PERIOD_FROM,'DD-MON-YYYY') PERIOD_FROM,THDR.PERIOD_TO
FROM SHIP_LINE_TARIFF_HDR THDR
WHERE THDR.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
